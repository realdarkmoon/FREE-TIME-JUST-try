local function restoreKnifeHandles()
	for handle, origSize in pairs(Cache.OrigHandleSize) do
		if handle and handle.Parent and handle:IsA("BasePart") and isValidPos(origSize) then
			pcall(function()
				handle.Size = origSize
				handle.Transparency = 0
			end)
		end
	end
	table.clear(Cache.OrigHandleSize)
end

local function updateKnifeReach()
	if not State.KnifeReachEnabled or State.Unloaded then
		restoreKnifeHandles()
		return
	end

	local char = Cache.Char
	if not char then return end

	for _, item in ipairs(char:GetChildren()) do
		if item:IsA("Tool") then
			local handle = item:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				if Cache.OrigHandleSize[handle] == nil then
					Cache.OrigHandleSize[handle] = handle.Size
				end
				local sz = math.clamp(State.KnifeReachSize, 2, 25)
				pcall(function()
					handle.Size = Vector3.new(sz, sz, sz)
					handle.Massless = true
				end)
			end
		end
	end
end

-- ==========================================
-- AIMBOT & SILENT AIM TARGETING
-- ==========================================
local function getAimReferenceScreenPos(cam)
	local vp = cam.ViewportSize
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return Vector2.new(vp.X * 0.5, vp.Y * 0.45)
	end
	local mouseLoc = UserInputService:GetMouseLocation()
	if mouseLoc and mouseLoc.X == mouseLoc.X and mouseLoc.Y == mouseLoc.Y then
		return Vector2.new(mouseLoc.X, mouseLoc.Y)
	end
	return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
end

local function pickBestAimTarget(cam, now)
	if not cam then return nil, nil end
	local refPos = getAimReferenceScreenPos(cam)
	local bestPart = nil
	local bestPredPos = nil
	local bestScore = State.AimFOV

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local role = Cache.PlayerRoles[player] or detectPlayerRole(player)
			if not State.MurdererOnlyAim or role == "Murderer" then
				local char = player.Character
				local hum = char:FindFirstChildOfClass("Humanoid")
				local aimPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char:FindFirstChild("Torso")

				if hum and hum.Health > 0 and aimPart and aimPart:IsA("BasePart") then
					local predWorld = computePredictedWorldPos(aimPart, now)
					if predWorld then
						local screenPt, onScreen = cam:WorldToViewportPoint(predWorld)
						if onScreen and screenPt.Z > 0 then
							local dist2D = (Vector2.new(screenPt.X, screenPt.Y) - refPos).Magnitude
							if dist2D <= bestScore then
								bestScore = dist2D
								bestPart = aimPart
								bestPredPos = predWorld
							end
						end
					end
				end
			end
		end
	end

	return bestPart, bestPredPos
end

local function updateAimbotAndSilentAim(cam, now)
	local targetPart, predPos = pickBestAimTarget(cam, now)

	if State.SilentAimEnabled and targetPart and predPos then
		Cache.SilentTargetPart = targetPart
		Cache.SilentTargetPos = predPos
	else
		Cache.SilentTargetPart = nil
		Cache.SilentTargetPos = nil
	end

	if not State.AimbotEnabled or State.Unloaded or not cam or not predPos then
		return
	end

	local shouldEngage = false
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		shouldEngage = true
	else
		shouldEngage = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	end

	if shouldEngage then
		local currentCF = cam.CFrame
		local desiredCF = CFrame.lookAt(currentCF.Position, predPos)
		local alpha = math.clamp(State.AimSmoothness, 0.05, 1)
		cam.CFrame = currentCF:Lerp(desiredCF, alpha)
	end
end

-- Safe Silent Aim Metatable Hook (guarded via pcall)
do
	local canHook = (typeof(getrawmetatable) == "function") and (typeof(setreadonly) == "function") and (typeof(newcclosure) == "function")
	if canHook then
		pcall(function()
			local mt = getrawmetatable(game)
			local oldNamecall = mt.__namecall
			setreadonly(mt, false)

			mt.__namecall = newcclosure(function(self, ...)
				if not State.Unloaded and State.SilentAimEnabled and Cache.SilentTargetPos then
					local method = getnamecallmethod()
					if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "Raycast" then
						local args = { ... }
						if typeof(args[1]) == "Vector3" then
							local origin = args[1]
							local dirVec = (Cache.SilentTargetPos - origin)
							if dirVec.Magnitude > 0.001 then
								if method == "Raycast" then
									args[2] = dirVec.Unit * math.max(dirVec.Magnitude + 15, 250)
								else
									args[1] = Ray.new(origin, dirVec.Unit * math.max(dirVec.Magnitude + 15, 250))
								end
								return oldNamecall(self, table.unpack(args))
							end
						end
					end
				end
				return oldNamecall(self, ...)
			end)

			setreadonly(mt, true)
		end)
	end
end


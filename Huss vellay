-- ==========================================
-- SERVER & STATE BYPASS HELPERS
-- ==========================================
local function enforceStateLock(hum)
	if not hum or not State.ServerSystemBypass or not State.BypassStateLock then return end
	local st = hum:GetState()
	if st == Enum.HumanoidStateType.Ragdoll
		or st == Enum.HumanoidStateType.FallingDown
		or st == Enum.HumanoidStateType.Physics
		or st == Enum.HumanoidStateType.PlatformStanding then
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end
	if State.BypassSeatClear then
		hum.Sit = false
	end
	hum.PlatformStand = false
end

local function cleanCharacterTethers(char, hum, root, deepClean)
	if hum then
		if State.BypassSeatClear then
			hum.Sit = false
		end
		hum.PlatformStand = false
		if State.ServerSystemBypass and State.BypassStateLock then
			enforceStateLock(hum)
		end
	end

	if root then
		if isValidPos(root.AssemblyLinearVelocity) then
			root.AssemblyLinearVelocity = Vector3.zero
		end
		if isValidPos(root.AssemblyAngularVelocity) then
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if deepClean and char and State.ServerSystemBypass then
		for _, desc in ipairs(char:GetDescendants()) do
			if State.BypassSeatClear and (desc:IsA("Seat") or desc:IsA("VehicleSeat")) then
				desc.Disabled = true
			elseif desc:IsA("WeldConstraint") or desc:IsA("RigidConstraint") then
				if desc.Part0 ~= desc.Part1 then
					pcall(function()
						desc:Destroy()
					end)
				end
			elseif desc:IsA("BodyVelocity") or desc:IsA("BodyPosition") or desc:IsA("BodyGyro")
				or desc:IsA("LinearVelocity") or desc:IsA("AlignPosition") or desc:IsA("VectorForce") then
				pcall(function()
					desc:Destroy()
				end)
			end
		end
	end
end


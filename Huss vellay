local drawingOk = (typeof(Drawing) == "table" and typeof(Drawing.new) == "function")

local function newDrawing(kind)
	if not drawingOk then return nil end
	local ok, obj = pcall(function()
		return Drawing.new(kind)
	end)
	return ok and obj or nil
end

local function removeDrawing(obj)
	if obj then
		pcall(function()
			obj:Remove()
		end)
	end
end

local function clearRoleTags()
	for plr, tag in pairs(roleTags) do
		removeDrawing(tag)
		roleTags[plr] = nil
	end
end

local function clearGunMarker()
	removeDrawing(gunMarker)
	gunMarker = nil
end

local function clearSkeletonForPlayer(plr)
	local rig = skeletonRigs[plr]
	if rig then
		if rig.OutlineLines then
			for _, ln in ipairs(rig.OutlineLines) do
				removeDrawing(ln)
			end
		end
		if rig.CoreLines then
			for _, ln in ipairs(rig.CoreLines) do
				removeDrawing(ln)
			end
		end
		removeDrawing(rig.HeadOutline)
		removeDrawing(rig.HeadCore)
		removeDrawing(rig.BoxOutline)
		removeDrawing(rig.BoxCore)
		skeletonRigs[plr] = nil
	end
end

local function clearAllSkeletons()
	for plr in pairs(skeletonRigs) do
		clearSkeletonForPlayer(plr)
	end
end

local function clearFOVCircle()
	removeDrawing(fovOutline)
	removeDrawing(fovCore)
	fovOutline = nil
	fovCore = nil
end

local function clearAllVisuals()
	clearRoleTags()
	clearGunMarker()
	clearAllSkeletons()
	clearFOVCircle()
end

local function setPanelStatus(msg, color)
	if panelStatusLbl and not State.Unloaded then
		panelStatusLbl.Text = tostring(msg or "")
		panelStatusLbl.TextColor3 = color or Color3.fromRGB(145, 215, 255)
	end
end

local function hasToolKeyword(container, keyword)
	if not container then return false end
	for _, item in ipairs(container:GetChildren()) do
		if item:IsA("Tool") and string.find(string.lower(item.Name), keyword, 1, true) then
			return true
		end
	end
	return false
end

local function getPlayerRole(plr)
	local char = plr.Character
	local backpack = plr:FindFirstChildOfClass("Backpack")

	if hasToolKeyword(char, "knife") or hasToolKeyword(backpack, "knife") then
		return "MURDERER", Color3.fromRGB(255, 65, 95)
	end

	if hasToolKeyword(char, "gun") or hasToolKeyword(backpack, "gun")
		or hasToolKeyword(char, "revolver") or hasToolKeyword(backpack, "revolver") then
		return "SHERIFF", Color3.fromRGB(65, 175, 255)
	end

	return "INNOCENT", Color3.fromRGB(105, 240, 165)
end

local function localPlayerHasGun()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	return hasToolKeyword(char, "gun") or hasToolKeyword(backpack, "gun")
		or hasToolKeyword(char, "revolver") or hasToolKeyword(backpack, "revolver")
end

local function getLocalRoot()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function getLocalRootPos()
	local root = getLocalRoot()
	return root and root.Position or nil
end

local function getDroppedGunPart()
	if State.CachedGunPart and State.CachedGunPart.Parent then
		return State.CachedGunPart
	end

	local now = os.clock()
	if (now - State.LastGunScan) < CONFIG.GunScanInterval then
		return State.CachedGunPart
	end
	State.LastGunScan = now

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and (obj.Name == "GunDrop" or string.find(string.lower(obj.Name), "gundrop", 1, true)) then
			State.CachedGunPart = obj
			return obj
		end
	end

	State.CachedGunPart = nil
	return nil
end

local function grabDroppedGun()
	if State.Unloaded or not State.Unlocked then return end
	local root = getLocalRoot()
	if not root then
		setPanelStatus("Character not spawned yet", Color3.fromRGB(255, 195, 90))
		return
	end

	State.LastGunScan = 0
	local gunPart = getDroppedGunPart()
	if not gunPart or not gunPart.Parent then
		setPanelStatus("No dropped gun found", Color3.fromRGB(255, 110, 130))
		return
	end

	local savedCFrame = root.CFrame
	local targetPos = gunPart.Position + Vector3.new(0, 1.5, 0)

	local ok = pcall(function()
		root.CFrame = CFrame.new(targetPos)
		if typeof(firetouchinterest) == "function" then
			firetouchinterest(root, gunPart, 0)
			firetouchinterest(root, gunPart, 1)
		end
	end)

	if ok then
		setPanelStatus("Pulled to dropped gun!", Color3.fromRGB(105, 240, 165))
		task.delay(0.22, function()
			if State.Unloaded then return end
			local currentRoot = getLocalRoot()
			if currentRoot and not localPlayerHasGun() then
				pcall(function()
					currentRoot.CFrame = savedCFrame
				end)
			end
		end)
	else
		setPanelStatus("Grab action failed", Color3.fromRGB(255, 110, 130))
	end
end

-- ==========================================
-- TARGET SELECTION, AIMBOT & SILENT AIM
-- ==========================================
local function getScreenCenter(cam)
	local vp = cam.ViewportSize
	return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
end

local function getBestAimTarget(cam)
	if not cam then return nil, nil end
	local center = getScreenCenter(cam)
	local preferMurderer = localPlayerHasGun()

	local bestPlr = nil
	local bestPart = nil
	local bestScore = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local aimPart = (char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))) or nil

			if char and hum and aimPart and aimPart:IsA("BasePart") and hum.Health > 0 then
				local roleName = getPlayerRole(plr)
				local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
				if onScreen and screenPos.Z > 0 then
					local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
					if dist2D <= State.FOVRadius then
						local priorityBonus = (preferMurderer and roleName == "MURDERER") and -80 or 0
						local score = dist2D + priorityBonus
						if score < bestScore then
							bestScore = score
							bestPlr = plr
							bestPart = aimPart
						end
					end
				end
			end
		end
	end

	if bestPlr and bestPart then
		return bestPlr, bestPart.Position
	end
	return nil, nil
end

local function applyCameraAimbot(cam)
	if not State.AimbotEnabled or State.Unloaded or not State.Unlocked or not cam then return end
	if not State.CurrentAimPos then return end

	local currentCF = cam.CFrame
	local targetCF = CFrame.lookAt(currentCF.Position, State.CurrentAimPos)
	local alpha = math.clamp(State.AimSmoothness, 0.05, 0.85)
	cam.CFrame = currentCF:Lerp(targetCF, alpha)
end

local originalRaycast = nil
local raycastHookActive = false
local originalNamecall = nil
local namecallHookActive = false

local function getSilentAimDirection(origin)
	if not State.SilentAimEnabled or State.Unloaded or not State.Unlocked then
		return nil
	end
	if typeof(origin) ~= "Vector3" or not State.CurrentAimPos then
		return nil
	end
	local delta = State.CurrentAimPos - origin
	if delta.Magnitude < 0.01 then
		return nil
	end
	return delta.Unit
end

local function installSilentAimHooks()
	if not raycastHookActive and typeof(hookfunction) == "function" and typeof(Workspace.Raycast) == "function" then
		local ok, prev = pcall(function()
			return hookfunction(Workspace.Raycast, function(self, origin, direction, params, ...)
				if self == Workspace and State.SilentAimEnabled and not State.Unloaded and State.Unlocked then
					local dirUnit = getSilentAimDirection(origin)
					if dirUnit and typeof(direction) == "Vector3" then
						local mag = direction.Magnitude
						if mag > 0 then
							return prev(self, origin, dirUnit * mag, params, ...)
						end
					end
				end
				return prev(self, origin, direction, params, ...)
			end)
		end)
		if ok and typeof(prev) == "function" then
			originalRaycast = prev
			raycastHookActive = true
		end
	end

	if not namecallHookActive and typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
		local ok, prev = pcall(function()
			return hookmetamethod(game, "__namecall", function(self, ...)
				local method = getnamecallmethod()
				if not State.Unloaded and State.Unlocked and State.SilentAimEnabled then
					if method == "Raycast" and self == Workspace then
						local args = { ... }
						local origin = args[1]
						local direction = args[2]
						local dirUnit = getSilentAimDirection(origin)
						if dirUnit and typeof(direction) == "Vector3" and direction.Magnitude > 0 then
							args[2] = dirUnit * direction.Magnitude
							return prev(self, table.unpack(args))
						end
					elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and self == Workspace then
						local args = { ... }
						local rayObj = args[1]
						if typeof(rayObj) == "Ray" then
							local dirUnit = getSilentAimDirection(rayObj.Origin)
							if dirUnit then
								local len = rayObj.Direction.Magnitude
								args[1] = Ray.new(rayObj.Origin, dirUnit * (len > 0 and len or 200))
								return prev(self, table.unpack(args))
							end
						end
					end
				end
				return prev(self, ...)
			end)
		end)
		if ok and typeof(prev) == "function" then
			originalNamecall = prev
			namecallHookActive = true
		end
	end
end

local function removeSilentAimHooks()
	if raycastHookActive and originalRaycast and typeof(hookfunction) == "function" and typeof(Workspace.Raycast) == "function" then
		pcall(function()
			hookfunction(Workspace.Raycast, originalRaycast)
		end)
	end
	raycastHookActive = false
	originalRaycast = nil

	if namecallHookActive and originalNamecall and typeof(hookmetamethod) == "function" then
		pcall(function()
			hookmetamethod(game, "__namecall", originalNamecall)
		end)
	end
	namecallHookActive = false
	originalNamecall = nil
end


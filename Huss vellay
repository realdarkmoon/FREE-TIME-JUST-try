local function isValidPos(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
end

local function markIntent(sec)
	State.IgnoreGuardUntil = math.max(State.IgnoreGuardUntil, os.clock() + (sec or 0.75))
end

-- ==========================================
-- SAFE REMOTE SYSTEM BYPASS & SCANNER
-- ==========================================
local function scanRemotesSafe()
	table.clear(Cached.Remotes)
	local count = 0
	local roots = { ReplicatedStorage, Workspace }

	for _, rootObj in ipairs(roots) do
		local ok, descList = pcall(function()
			return rootObj:GetDescendants()
		end)
		if ok and typeof(descList) == "table" then
			for _, obj in ipairs(descList) do
				if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
					count += 1
					if #Cached.Remotes < 120 then
						table.insert(Cached.Remotes, obj)
					end
				end
			end
		end
	end

	State.DetectedRemotesCount = count
	State.LastRemoteScan = os.clock()
	return count
end

local function safeFireRemote(remote, ...)
	if State.Unloaded or not State.RemoteSystemBypass then return false end
	if typeof(remote) ~= "Instance" or not remote.Parent then return false end

	local args = { ... }
	local ok = false

	if remote:IsA("RemoteEvent") then
		ok = pcall(function()
			remote:FireServer(table.unpack(args))
		end)
	elseif remote:IsA("RemoteFunction") then
		ok = pcall(function()
			remote:InvokeServer(table.unpack(args))
		end)
	end

	return ok
end

local function pulseMovementRemotes(actionName, cf)
	if not State.ServerSystemBypass or not State.RemoteSystemBypass or State.Unloaded then
		return
	end
	if #Cached.Remotes == 0 and (os.clock() - State.LastRemoteScan) > 10 then
		scanRemotesSafe()
	end

	local keywords = { "move", "pos", "cframe", "tp", "teleport", "sync", "state", "anti", "check", "hit" }
	local fired = 0

	for _, rem in ipairs(Cached.Remotes) do
		if fired >= 6 then break end
		if rem and rem.Parent and rem:IsA("RemoteEvent") then
			local lower = rem.Name:lower()
			for _, kw in ipairs(keywords) do
				if lower:find(kw, 1, true) then
					safeFireRemote(rem, actionName, cf)
					fired += 1
					break
				end
			end
		end
	end
end


	if rHand then fireTouch(rHand, gunPart) end
end

local function getKnifeTool(char)
	local bp = LocalPlayer and LocalPlayer:FindFirstChild("Backpack")
	local containers = {}
	if char then table.insert(containers, char) end
	if bp then table.insert(containers, bp) end
	for _, container in ipairs(containers) do
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") then
				local lname = string.lower(item.Name)
				if item.Name == "Knife" or string.find(lname, "knife", 1, true) or string.find(lname, "blade", 1, true) or item:FindFirstChild("KnifeScript") or item:FindFirstChild("KnifeLocal") then
					return item, container
				end
			end
		end
	end
	return nil, nil
end

local function getKnifeThrowRemote(knife)
	if not knife then return nil end
	local events = knife:FindFirstChild("Events")
	if events then
		local direct = events:FindFirstChild("KnifeThrown")
		if direct and (direct:IsA("RemoteEvent") or direct:IsA("RemoteFunction")) then
			return direct
		end
		for _, child in ipairs(events:GetDescendants()) do
			if (child:IsA("RemoteEvent") or child:IsA("RemoteFunction")) then
				local lname = string.lower(child.Name)
				if string.find(lname, "throw", 1, true) or string.find(lname, "knife", 1, true) then
					return child
				end
			end
		end
	end
	local directKnife = knife:FindFirstChild("KnifeThrown", true)
	if directKnife and (directKnife:IsA("RemoteEvent") or directKnife:IsA("RemoteFunction")) then
		return directKnife
	end
	for _, desc in ipairs(knife:GetDescendants()) do
		if (desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction")) and string.find(string.lower(desc.Name), "throw", 1, true) then
			return desc
		end
	end
	return nil
end

local function getKnifeOriginPart(knife, root)
	if knife then
		for _, name in ipairs({"Handle", "Blade", "Part"}) do
			local found = knife:FindFirstChild(name)
			if found and found:IsA("BasePart") then return found end
		end
		local anyPart = knife:FindFirstChildWhichIsA("BasePart", true)
		if anyPart then return anyPart end
	end
	return root
end

local function computeAimPos(targetRoot)
	if not targetRoot then return nil end
	local pos = targetRoot.Position
	if Config.AimPrediction then
		local lead = Config.PingComp and 0.16 or 0.12
		pos = pos + (targetRoot.AssemblyLinearVelocity * lead)
	end
	return pos
end

local function fireKnifeThrowRemote(remote, originCF, targetPos)
	if not remote or not originCF or not targetPos then return false end
	local targetCF = CFrame.new(targetPos)
	local ok = false
	if remote:IsA("RemoteEvent") then
		ok = pcall(function() remote:FireServer(originCF, targetCF) end)
		if not ok then ok = pcall(function() remote:FireServer(originCF, targetPos) end) end
		if not ok then ok = pcall(function() remote:FireServer(targetCF) end) end
	elseif remote:IsA("RemoteFunction") then
		ok = pcall(function() remote:InvokeServer(originCF, targetCF) end)
		if not ok then ok = pcall(function() remote:InvokeServer(originCF, targetPos) end) end
	end
	return ok
end

local function getClosestKnifeTarget()
	local char = LocalPlayer.Character
	local root = getRootPart(char)
	if not root then return nil end
	local mousePos = UserInputService:GetMouseLocation()
	local bestTarget = nil
	local bestDist = math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and isPlayerAlive(p) and p.Character then
			local tRoot = getRootPart(p.Character)
			if tRoot then
				local screenPos = Camera:WorldToViewportPoint(tRoot.Position)
				local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
				if (not Config.ShowFOV or dist <= Config.FOVRadius) and dist < bestDist then
					bestDist = dist
					bestTarget = p
				end
			end
		end
	end
	if not bestTarget then
		local minDist = math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and isPlayerAlive(p) and p.Character then
				local tRoot = getRootPart(p.Character)
				if tRoot then
					local d = (root.Position - tRoot.Position).Magnitude
					if d < minDist then
						minDist = d
						bestTarget = p
					end
				end
			end
		end
	end
	return bestTarget
end


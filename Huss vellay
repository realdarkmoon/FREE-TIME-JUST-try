-- ==========================================
local function restoreNoclipParts()
	for part, oldCollide in pairs(Cached.OrigCollide) do
		if part and part.Parent and part:IsA("BasePart") then
			pcall(function()
				part.CanCollide = oldCollide
			end)
		end
	end
	table.clear(Cached.OrigCollide)
end

local function applyNoclipFrame()
	if not State.NoclipEnabled or State.Unloaded then return end
	for i = #Cached.Parts, 1, -1 do
		local part = Cached.Parts[i]
		if part and part.Parent and part:IsA("BasePart") then
			if Cached.OrigCollide[part] == nil then
				Cached.OrigCollide[part] = part.CanCollide
			end
			part.CanCollide = false
		else
			table.remove(Cached.Parts, i)
		end
	end
end

local function setNoclip(enabled)
	State.NoclipEnabled = enabled
	if enabled and not State.Unloaded then
		applyNoclipFrame()
	else
		restoreNoclipParts()
	end
end

local function refreshChar(char)
	restoreNoclipParts()
	table.clear(Cached.Parts)

	Cached.Char = char
	Cached.Hum = char and char:FindFirstChildOfClass("Humanoid") or nil
	Cached.Root = char and (
		char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
	) or nil

	rayParams.FilterDescendantsInstances = char and { char } or {}
	overlapParams.FilterDescendantsInstances = char and { char } or {}

	if char then
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("BasePart") then
				table.insert(Cached.Parts, desc)
				Cached.OrigCollide[desc] = desc.CanCollide
			end
		end
	end

	if Cached.Hum then
		if Cached.Hum.UseJumpPower then
			State.DefaultJumpPower = Cached.Hum.JumpPower
		else
			State.DefaultJumpPower = Cached.Hum.JumpHeight
		end
	end

	if Cached.Root and isValidPos(Cached.Root.Position) then
		State.LastCleanCFrame = Cached.Root.CFrame
	end

	if State.NoclipEnabled then
		applyNoclipFrame()
	end
end


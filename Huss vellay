-- ==========================================
-- STATE & CHARACTER CACHE
-- ==========================================
local State = {
	SavedCFrame = nil,
	StepStuds = 16,
	HoldFrames = 6,
	SpeedEnabled = false,
	ExtraSpeed = 12,
	JumpEnabled = false,
	JumpPower = 65,
	DefaultJumpPower = 50,
	ShowFloatButtons = true,
	TpRunning = false,
	LastTpTime = 0,
	Unloaded = false
}

local Cached = {
	Char = nil,
	Hum = nil,
	Root = nil
}

local connections = {}

local function isValidPos(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
end

local function refreshChar(char)
	Cached.Char = char
	Cached.Hum = char and char:FindFirstChildOfClass("Humanoid") or nil
	Cached.Root = char and (
		char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
	) or nil

	if Cached.Hum then
		if Cached.Hum.UseJumpPower then
			State.DefaultJumpPower = Cached.Hum.JumpPower
		else
			State.DefaultJumpPower = Cached.Hum.JumpHeight
		end
	end
end

if LocalPlayer.Character then
	refreshChar(LocalPlayer.Character)
end

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
	if State.Unloaded then return end
	refreshChar(char)
	if not Cached.Hum or not Cached.Root then
		char:WaitForChild("Humanoid", 5)
		char:WaitForChild("HumanoidRootPart", 5)
		refreshChar(char)
	end
	if State.JumpEnabled and Cached.Hum then
		if Cached.Hum.UseJumpPower then
			Cached.Hum.JumpPower = State.JumpPower
		else
			Cached.Hum.JumpHeight = State.JumpPower / 5
		end
	end
end))

-- ==========================================
-- ANTI-PULLBACK TELEPORT ENGINE
-- ==========================================
local function clearCharacterTethers(char, hum, root)
	if hum then
		hum.Sit = false
		hum.PlatformStand = false
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	if char then
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("Seat") or desc:IsA("VehicleSeat") then
				desc.Disabled = true
			elseif desc:IsA("WeldConstraint") or desc:IsA("RigidConstraint") then
				if desc.Part0 ~= desc.Part1 then
					pcall(function()
						desc:Destroy()
					end)
				end
			elseif desc:IsA("BodyVelocity") or desc:IsA("BodyPosition") or desc:IsA("BodyGyro")
				or desc:IsA("LinearVelocity") or desc:IsA("AlignPosition") or desc:IsA("VectorForce") then
				pcall(function()
					desc:Destroy()
				end)
			end
		end
	end
end

local function stepCharacterToward(char, hum, root, nextPos, flatLook, velHint)
	clearCharacterTethers(char, hum, root)
	local targetCF = flatLook.Magnitude > 0.001
		and CFrame.new(nextPos, nextPos + flatLook.Unit)
		or CFrame.new(nextPos)

	root.CFrame = targetCF
	pcall(function()
		char:PivotTo(targetCF)
	end)

	if isValidPos(velHint) then
		root.AssemblyLinearVelocity = velHint
	end
end

local function teleportToCFrame(targetCF)
	if State.Unloaded or State.TpRunning or typeof(targetCF) ~= "CFrame" then
		return false
	end
	if not isValidPos(targetCF.Position) then
		return false
	end

	local now = os.clock()
	if (now - State.LastTpTime) < 0.15 then
		return false
	end
	State.LastTpTime = now

	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char or not root then
		return false
	end

	local goalPos = targetCF.Position + Vector3.new(0, 3.0, 0)
	local look = targetCF.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)

	State.TpRunning = true
	task.spawn(function()
		local startPos = root.Position
		local dist = (goalPos - startPos).Magnitude
		local stepSize = math.max(8, tonumber(State.StepStuds) or 16)
		local steps = math.clamp(math.ceil(dist / stepSize), 1, 30)

		for i = 1, steps do
			if State.Unloaded or not Cached.Char or not Cached.Hum or not Cached.Root or Cached.Hum.Health <= 0 then
				break
			end
			local alpha = i / steps
			local curPos = startPos:Lerp(goalPos, alpha)
			local dir = (goalPos - curPos)
			local vel = dir.Magnitude > 0.1 and (dir.Unit * math.min(dir.Magnitude * 8, 65)) or Vector3.zero
			stepCharacterToward(Cached.Char, Cached.Hum, Cached.Root, curPos, flatLook, vel)
			RunService.Heartbeat:Wait()
		end

		-- Re-assert final position for a few frames so server sync accepts it
		local holdCount = math.clamp(tonumber(State.HoldFrames) or 6, 1, 15)
		for _ = 1, holdCount do
			if State.Unloaded or not Cached.Char or not Cached.Hum or not Cached.Root or Cached.Hum.Health <= 0 then
				break
			end
			stepCharacterToward(Cached.Char, Cached.Hum, Cached.Root, goalPos, flatLook, Vector3.zero)
			RunService.Heartbeat:Wait()
		end

		State.TpRunning = false
	end)

	return true
end

local function saveCurrentSpot()
	local root = Cached.Root
	if not root or not isValidPos(root.Position) then return false end
	State.SavedCFrame = root.CFrame
	return true
end

local function teleportSavedSpot()
	if not State.SavedCFrame then
		if not saveCurrentSpot() then return false end
	end
	return teleportToCFrame(State.SavedCFrame)
end

local function teleportNearestPlayer()
	local root = Cached.Root
	if not root or not isValidPos(root.Position) then return false end

	local bestRoot = nil
	local bestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local otherRoot = plr.Character:FindFirstChild("HumanoidRootPart")
				or plr.Character:FindFirstChild("Torso")
				or plr.Character:FindFirstChild("UpperTorso")
			if otherRoot and isValidPos(otherRoot.Position) then
				local d = (otherRoot.Position - root.Position).Magnitude
				if d < bestDist then
					bestDist = d
					bestRoot = otherRoot
				end
			end
		end
	end

	if not bestRoot then return false end
	return teleportToCFrame(bestRoot.CFrame * CFrame.new(0, 0, 3.5))
end


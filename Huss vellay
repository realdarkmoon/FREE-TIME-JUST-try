local function fireTouch(part1, part2)
	if firetouchinterest and part1 and part2 then
		pcall(firetouchinterest, part1, part2, true)
		pcall(firetouchinterest, part1, part2, 0)
		task.wait()
		pcall(firetouchinterest, part1, part2, false)
		pcall(firetouchinterest, part1, part2, 1)
	end
end

local function getRootPart(char)
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChildWhichIsA("BasePart")
end

local function getHumanoid(char)
	if not char then return nil end
	return char:FindFirstChildOfClass("Humanoid")
end

local function isPlayerAlive(p)
	if not p or not p.Character then return false end
	local hum = getHumanoid(p.Character)
	return hum ~= nil and hum.Health > 0
end

local function hasRoleTool(container, roleKind)
	if not container then return false end
	for _, item in ipairs(container:GetChildren()) do
		if item:IsA("Tool") or item:IsA("Folder") then
			local lname = string.lower(item.Name)
			if roleKind == "Murderer" then
				if item.Name == "Knife" or string.find(lname, "knife", 1, true) or string.find(lname, "blade", 1, true) or item:FindFirstChild("KnifeScript") or item:FindFirstChild("KnifeLocal") then
					return true
				end
			elseif roleKind == "Sheriff" then
				if item.Name == "Gun" or string.find(lname, "gun", 1, true) or string.find(lname, "revolver", 1, true) or string.find(lname, "pistol", 1, true) or item:FindFirstChild("GunScript") or item:FindFirstChild("GunLocal") then
					return true
				end
			end
		end
	end
	return false
end

local function getPlayerRole(p)
	if not p then return "Innocent" end
	local attrRole = p:GetAttribute("Role") or (p.Character and p.Character:GetAttribute("Role"))
	if type(attrRole) == "string" then
		local lrole = string.lower(attrRole)
		if string.find(lrole, "murd", 1, true) then
			return "Murderer"
		elseif string.find(lrole, "sher", 1, true) or string.find(lrole, "hero", 1, true) then
			return "Sheriff"
		end
	end
	local bp = p:FindFirstChild("Backpack")
	local char = p.Character
	local starterGear = p:FindFirstChild("StarterGear")
	if hasRoleTool(bp, "Murderer") or hasRoleTool(char, "Murderer") or hasRoleTool(starterGear, "Murderer") then
		return "Murderer"
	end
	if hasRoleTool(bp, "Sheriff") or hasRoleTool(char, "Sheriff") or hasRoleTool(starterGear, "Sheriff") then
		return "Sheriff"
	end
	return "Innocent"
end

local function getMurderer()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and isPlayerAlive(p) and getPlayerRole(p) == "Murderer" then
			return p
		end
	end
	return nil
end


local drawingAvailable = (typeof(Drawing) == "table" and typeof(Drawing.new) == "function")

local function isValidPos(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
end

local function disconnectAll(list)
	for _, conn in ipairs(list) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(list)
end

local function rebuildCharCache(char)
	table.clear(Cache.Parts)
	table.clear(Cache.OrigCollide)

	Cache.Char = char
	Cache.Hum = char and char:FindFirstChildOfClass("Humanoid") or nil
	Cache.Root = char and (
		char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
	) or nil

	if Cache.Hum then
		State.DefaultWalkSpeed = Cache.Hum.WalkSpeed > 0 and Cache.Hum.WalkSpeed or 16
	end

	if not char then return end
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") then
			table.insert(Cache.Parts, desc)
			Cache.OrigCollide[desc] = desc.CanCollide
		end
	end
end

-- ==========================================
-- PING & AIM PREDICTION HELPERS
-- ==========================================
local function sampleNetworkPing(now)
	if (now - State.LastPingSample) < 0.5 then
		return State.CurrentPingSec
	end
	State.LastPingSample = now

	local ok, pingSec = pcall(function()
		return LocalPlayer:GetNetworkPing()
	end)
	if ok and typeof(pingSec) == "number" and pingSec >= 0 and pingSec < 2.5 then
		State.CurrentPingSec = pingSec
	end
	return State.CurrentPingSec
end

local function computePredictedWorldPos(targetPart, now)
	if not targetPart or not targetPart.Parent or not isValidPos(targetPart.Position) then
		return nil
	end

	local basePos = targetPart.Position
	if not State.AimPrediction and not State.PingCompensation then
		return basePos
	end

	local vel = targetPart.AssemblyLinearVelocity
	if not isValidPos(vel) or vel.Magnitude < 0.25 then
		return basePos
	end

	local leadTime = 0
	if State.AimPrediction then
		leadTime += State.PredictionLead
	end
	if State.PingCompensation then
		leadTime += math.clamp(sampleNetworkPing(now), 0, 0.6)
	end

	local predicted = basePos + (vel * leadTime)
	if isValidPos(predicted) then
		return predicted
	end
	return basePos
end

-- ==========================================
-- ROLE DETECTION (MURDERER / SHERIFF / INNOCENT)
-- ==========================================
local function hasToolNamed(container, keyword)
	if not container then return false end
	for _, item in ipairs(container:GetChildren()) do
		if item:IsA("Tool") then
			local n = item.Name:lower()
			if n:find(keyword, 1, true) then
				return true
			end
		end
	end
	return false
end

local function detectPlayerRole(player)
	if not player then return "Innocent" end
	local char = player.Character
	local backpack = player:FindFirstChild("Backpack")
	local starterGear = player:FindFirstChild("StarterGear")

	if hasToolNamed(char, "knife") or hasToolNamed(backpack, "knife") or hasToolNamed(starterGear, "knife") then
		return "Murderer"
	end

	if player ~= LocalPlayer then
		if hasToolNamed(char, "gun") or hasToolNamed(char, "revolver")
			or hasToolNamed(backpack, "gun") or hasToolNamed(backpack, "revolver")
			or hasToolNamed(starterGear, "gun") or hasToolNamed(starterGear, "revolver") then
			return "Sheriff"
		end
	end

	return "Innocent"
end

local function getRoleColor(role)
	if role == "Murderer" then
		return Color3.fromRGB(255, 65, 85)
	elseif role == "Sheriff" then
		return Color3.fromRGB(75, 165, 255)
	end
	return Color3.fromRGB(95, 235, 145)
end

local function clearRoleVisualFor(player)
	local entry = Cache.RoleVisuals[player]
	if entry then
		if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
		if entry.Billboard then pcall(function() entry.Billboard:Destroy() end) end
		Cache.RoleVisuals[player] = nil
	end
end

local function clearAllRoleVisuals()
	for player in pairs(Cache.RoleVisuals) do
		clearRoleVisualFor(player)
	end
end

local function applyRoleVisual(player, role)
	local char = player and player.Character
	local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	if not char or not head or not isValidPos(head.Position) then
		clearRoleVisualFor(player)
		return
	end

	local color = getRoleColor(role)
	local entry = Cache.RoleVisuals[player]

	if not entry then
		local hl = Instance.new("Highlight")
		hl.Name = "YutaRoleHighlight"
		hl.FillTransparency = 0.65
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = char
		hl.Parent = char

		local bb = Instance.new("BillboardGui")
		bb.Name = "YutaRoleTag"
		bb.Size = UDim2.fromOffset(136, 34)
		bb.StudsOffset = Vector3.new(0, 2.8, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = head
		bb.Parent = PlayerGui

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 13
		lbl.TextStrokeTransparency = 0.25
		lbl.Parent = bb

		entry = { Highlight = hl, Billboard = bb, Label = lbl }
		Cache.RoleVisuals[player] = entry
	end

	entry.Highlight.Adornee = char
	entry.Highlight.Parent = char
	entry.Highlight.FillColor = color
	entry.Highlight.OutlineColor = color

	entry.Billboard.Adornee = head
	local dist = (Cache.Root and isValidPos(Cache.Root.Position)) and math.floor((Cache.Root.Position - head.Position).Magnitude) or 0
	entry.Label.Text = string.format("[%s] %s (%dm)", role, player.DisplayName, dist)
	entry.Label.TextColor3 = color
end

local function scanRoles()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local role = detectPlayerRole(player)
			Cache.PlayerRoles[player] = role
			if State.RoleESP then
				applyRoleVisual(player, role)
			end
		end
	end
end

local function findPlayerByRole(targetRole)
	scanRoles()
	for player, role in pairs(Cache.PlayerRoles) do
		if role == targetRole and player and player.Parent and player.Character then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Torso")
			if hum and hum.Health > 0 and root and isValidPos(root.Position) then
				return player, root
			end
		end
	end
	return nil, nil
end

local function teleportToCFrame(targetCF)
	local char = Cache.Char
	local hum = Cache.Hum
	local root = Cache.Root
	if not char or not root or State.Unloaded then return false end

	if hum then
		hum.Sit = false
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local ok = pcall(function()
		char:PivotTo(targetCF)
	end)
	if not ok then
		root.CFrame = targetCF
	end
	return true
end

local function teleportToRole(targetRole)
	local _, targetRoot = findPlayerByRole(targetRole)
	if not targetRoot then return false end
	local destPos = targetRoot.Position - (targetRoot.CFrame.LookVector * 3.2) + Vector3.new(0, 1.2, 0)
	return teleportToCFrame(CFrame.new(destPos, targetRoot.Position))
end


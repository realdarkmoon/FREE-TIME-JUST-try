local function clearGunVisuals()
	for _, entry in ipairs(Cache.GunVisuals) do
		if entry.Billboard then pcall(function() entry.Billboard:Destroy() end) end
		if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
	end
	table.clear(Cache.GunVisuals)
end

local function findDroppedGunContainerAndPart()
	local gunDrop = Workspace:FindFirstChild("GunDrop", true)
	if gunDrop then
		if gunDrop:IsA("Tool") then
			local part = gunDrop:FindFirstChild("Handle") or gunDrop:FindFirstChildWhichIsA("BasePart", true)
			if part and isValidPos(part.Position) then
				return gunDrop, part
			end
		elseif gunDrop:IsA("BasePart") and isValidPos(gunDrop.Position) then
			return gunDrop.Parent or gunDrop, gunDrop
		elseif gunDrop:IsA("Model") then
			local part = gunDrop.PrimaryPart or gunDrop:FindFirstChildWhichIsA("BasePart", true)
			if part and isValidPos(part.Position) then
				return gunDrop, part
			end
		end
	end

	for _, desc in ipairs(Workspace:GetChildren()) do
		if desc:IsA("Tool") or desc:IsA("BasePart") or desc:IsA("Model") then
			local n = desc.Name:lower()
			if n == "gundrop" or n:find("gun", 1, true) or n:find("revolver", 1, true) then
				local charAncestor = desc:FindFirstAncestorOfClass("Model")
				if not charAncestor or not Players:GetPlayerFromCharacter(charAncestor) then
					if desc:IsA("BasePart") and isValidPos(desc.Position) then
						return desc, desc
					end
					local part = desc:FindFirstChild("Handle") or desc:FindFirstChildWhichIsA("BasePart", true)
					if part and isValidPos(part.Position) then
						return desc, part
					end
				end
			end
		end
	end

	return nil, nil
end

local function findDroppedGunTarget()
	local _, part = findDroppedGunContainerAndPart()
	return part
end

local function triggerGunTouchToPocket(container, root)
	if not container or not root or not isValidPos(root.Position) then return end

	local destCF = root.CFrame * CFrame.new(0, 0.5, -1.5)
	for _, desc in ipairs(container:GetDescendants()) do
		if desc:IsA("BasePart") then
			pcall(function()
				desc.Anchored = false
				desc.CanCollide = false
				desc.CFrame = destCF
			end)
			if typeof(firetouchinterest) == "function" then
				pcall(function()
					firetouchinterest(root, desc, 0)
					firetouchinterest(root, desc, 1)
				end)
			end
		elseif desc:IsA("ProximityPrompt") and typeof(fireproximityprompt) == "function" then
			pcall(function()
				fireproximityprompt(desc)
			end)
		end
	end

	if container:IsA("BasePart") then
		pcall(function()
			container.Anchored = false
			container.CanCollide = false
			container.CFrame = destCF
		end)
		if typeof(firetouchinterest) == "function" then
			pcall(function()
				firetouchinterest(root, container, 0)
				firetouchinterest(root, container, 1)
			end)
		end
	end

	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if container:IsA("Tool") and backpack then
		pcall(function()
			container.Parent = backpack
		end)
	end
end

local function pullDroppedGunToPocket()
	local container, gunPart = findDroppedGunContainerAndPart()
	local root = Cache.Root
	if not container or not gunPart or not gunPart.Parent or not root or State.Unloaded then
		return false
	end

	triggerGunTouchToPocket(container, root)
	return true
end

local function updateGunESP()
	clearGunVisuals()
	if not State.GunESP or State.Unloaded then return end

	local targetPart = findDroppedGunTarget()
	if not targetPart or not targetPart.Parent then return end

	local hl = Instance.new("Highlight")
	hl.Name = "YutaGunHighlight"
	hl.FillColor = Color3.fromRGB(255, 215, 70)
	hl.OutlineColor = Color3.fromRGB(255, 215, 70)
	hl.FillTransparency = 0.5
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = targetPart.Parent:IsA("Model") and targetPart.Parent or targetPart
	hl.Parent = PlayerGui

	local bb = Instance.new("BillboardGui")
	bb.Name = "YutaGunTag"
	bb.Size = UDim2.fromOffset(146, 32)
	bb.StudsOffset = Vector3.new(0, 1.8, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = targetPart
	bb.Parent = PlayerGui

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 14
	lbl.TextColor3 = Color3.fromRGB(255, 220, 80)
	lbl.TextStrokeTransparency = 0.2
	local dist = (Cache.Root and isValidPos(Cache.Root.Position)) and math.floor((Cache.Root.Position - targetPart.Position).Magnitude) or 0
	lbl.Text = string.format("◆ DROPPED GUN [%dm]", dist)
	lbl.Parent = bb

	table.insert(Cache.GunVisuals, { Highlight = hl, Billboard = bb })
end

-- ==========================================
-- CS2 BOX ESP & SKELETON ESP (DRAWING API)
-- ==========================================
local function safeDrawing(kind)
	if not drawingAvailable then return nil end
	local ok, obj = pcall(function()
		return Drawing.new(kind)
	end)
	return (ok and obj) and obj or nil
end

local function ensureCS2Box(player)
	if Cache.CS2Boxes[player] then return Cache.CS2Boxes[player] end
	local outline = safeDrawing("Square")
	local box = safeDrawing("Square")
	if outline then
		pcall(function()
			outline.Visible = false
			outline.Filled = false
			outline.Thickness = 3
			outline.Color = Color3.fromRGB(0, 0, 0)
			outline.Transparency = 1
		end)
	end
	if box then
		pcall(function()
			box.Visible = false
			box.Filled = false
			box.Thickness = 1.5
			box.Color = Color3.fromRGB(95, 235, 145)
			box.Transparency = 1
		end)
	end
	local entry = { Outline = outline, Box = box }
	Cache.CS2Boxes[player] = entry
	return entry
end

local function hideCS2Box(entry)
	if not entry then return end
	if entry.Outline then pcall(function() entry.Outline.Visible = false end) end
	if entry.Box then pcall(function() entry.Box.Visible = false end) end
end

local function removeCS2Box(player)
	local entry = Cache.CS2Boxes[player]
	if entry then
		if entry.Outline then pcall(function() entry.Outline:Remove() end) end
		if entry.Box then pcall(function() entry.Box:Remove() end) end
		Cache.CS2Boxes[player] = nil
	end
end

local function clearAllCS2Boxes()
	for plr in pairs(Cache.CS2Boxes) do
		removeCS2Box(plr)
	end
end

local function ensureSkeletonPool(count)
	while #Cache.SkeletonLines < count do
		local line = safeDrawing("Line")
		if line then
			pcall(function()
				line.Visible = false
				line.Thickness = 1.6
				line.Color = Color3.fromRGB(235, 240, 255)
				line.Transparency = 1
			end)
			table.insert(Cache.SkeletonLines, line)
		else
			break
		end
	end
end

local function hideAllSkeletonLines()
	for _, line in ipairs(Cache.SkeletonLines) do
		pcall(function() line.Visible = false end)
	end
end

local function clearAllSkeletonLines()
	for _, line in ipairs(Cache.SkeletonLines) do
		pcall(function() line:Remove() end)
	end
	table.clear(Cache.SkeletonLines)
end

local function getBoneSegments(char)
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart")
	local upperTorso = char:FindFirstChild("UpperTorso")
	local lowerTorso = char:FindFirstChild("LowerTorso")
	local torso = char:FindFirstChild("Torso")

	local neckPos = head and head.Position or (upperTorso and upperTorso.Position) or (torso and torso.Position) or (root and root.Position)
	local hipPos = lowerTorso and lowerTorso.Position or torso and torso.Position or root and root.Position
	if not neckPos or not hipPos then return {} end

	local segments = {}
	local function addSeg(pA, pB)
		if isValidPos(pA) and isValidPos(pB) then
			table.insert(segments, { pA, pB })
		end
	end

	addSeg(neckPos, hipPos)

	local lUpperArm = char:FindFirstChild("LeftUpperArm")
	local lLowerArm = char:FindFirstChild("LeftLowerArm")
	local lHand = char:FindFirstChild("LeftHand")
	local rUpperArm = char:FindFirstChild("RightUpperArm")
	local rLowerArm = char:FindFirstChild("RightLowerArm")
	local rHand = char:FindFirstChild("RightHand")

	local lUpperLeg = char:FindFirstChild("LeftUpperLeg")
	local lLowerLeg = char:FindFirstChild("LeftLowerLeg")
	local lFoot = char:FindFirstChild("LeftFoot")
	local rUpperLeg = char:FindFirstChild("RightUpperLeg")
	local rLowerLeg = char:FindFirstChild("RightLowerLeg")
	local rFoot = char:FindFirstChild("RightFoot")

	if lUpperArm and upperTorso then
		addSeg(upperTorso.Position, lUpperArm.Position)
		if lLowerArm then addSeg(lUpperArm.Position, lLowerArm.Position) end
		if lHand and lLowerArm then addSeg(lLowerArm.Position, lHand.Position) end
	end
	if rUpperArm and upperTorso then
		addSeg(upperTorso.Position, rUpperArm.Position)
		if rLowerArm then addSeg(rUpperArm.Position, rLowerArm.Position) end
		if rHand and rLowerArm then addSeg(rLowerArm.Position, rHand.Position) end
	end
	if lUpperLeg and lowerTorso then
		addSeg(lowerTorso.Position, lUpperLeg.Position)
		if lLowerLeg then addSeg(lUpperLeg.Position, lLowerLeg.Position) end
		if lFoot and lLowerLeg then addSeg(lLowerLeg.Position, lFoot.Position) end
	end
	if rUpperLeg and lowerTorso then
		addSeg(lowerTorso.Position, rUpperLeg.Position)
		if rLowerLeg then addSeg(rUpperLeg.Position, rLowerLeg.Position) end
		if rFoot and rLowerLeg then addSeg(rLowerLeg.Position, rFoot.Position) end
	end

	if #segments == 1 and root then
		local cf = root.CFrame
		addSeg(neckPos, (cf * CFrame.new(-1.35, 1.1, 0)).Position)
		addSeg(neckPos, (cf * CFrame.new(1.35, 1.1, 0)).Position)
		addSeg(hipPos, (cf * CFrame.new(-0.6, -2.5, 0)).Position)
		addSeg(hipPos, (cf * CFrame.new(0.6, -2.5, 0)).Position)
	end

	return segments
end

local function updateRenderVisuals(cam, now)
	if State.Unloaded or not drawingAvailable or not cam then
		for _, entry in pairs(Cache.CS2Boxes) do hideCS2Box(entry) end
		hideAllSkeletonLines()
		return
	end

	for plr, entry in pairs(Cache.CS2Boxes) do
		if not plr or not plr.Parent then
			removeCS2Box(plr)
		end
	end

	local activeBoneCount = 0
	local pendingBones = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
			local role = Cache.PlayerRoles[player] or "Innocent"
			local col = getRoleColor(role)

			if char and hum and hum.Health > 0 and root and isValidPos(root.Position) then
				if State.CS2BoxESP then
					local entry = ensureCS2Box(player)
					local rootScreen, onScreen = cam:WorldToViewportPoint(root.Position)
					if onScreen and rootScreen.Z > 0 and entry.Box then
						local topPt = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, 2.7, 0)).Position)
						local botPt = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, -3.1, 0)).Position)
						local h = math.clamp(math.abs(topPt.Y - botPt.Y), 16, 420)
						local w = math.clamp(h * 0.56, 10, 240)
						local x = rootScreen.X - (w * 0.5)
						local y = topPt.Y

						pcall(function()
							if entry.Outline then
								entry.Outline.Size = Vector2.new(w, h)
								entry.Outline.Position = Vector2.new(x, y)
								entry.Outline.Visible = true
							end
							entry.Box.Size = Vector2.new(w, h)
							entry.Box.Position = Vector2.new(x, y)
							entry.Box.Color = col
							entry.Box.Visible = true
						end)
					else
						hideCS2Box(entry)
					end
				elseif Cache.CS2Boxes[player] then
					hideCS2Box(Cache.CS2Boxes[player])
				end

				if State.SkeletonESP then
					local segs = getBoneSegments(char)
					for _, seg in ipairs(segs) do
						local p1Screen, vis1 = cam:WorldToViewportPoint(seg[1])
						local p2Screen, vis2 = cam:WorldToViewportPoint(seg[2])
						if vis1 and vis2 and p1Screen.Z > 0 and p2Screen.Z > 0 then
							activeBoneCount += 1
							table.insert(pendingBones, {
								From = Vector2.new(p1Screen.X, p1Screen.Y),
								To = Vector2.new(p2Screen.X, p2Screen.Y),
								Color = col
							})
						end
					end
				end
			elseif Cache.CS2Boxes[player] then
				hideCS2Box(Cache.CS2Boxes[player])
			end
		end
	end

	if not State.CS2BoxESP then
		for _, entry in pairs(Cache.CS2Boxes) do
			hideCS2Box(entry)
		end
	end

	if State.SkeletonESP then
		ensureSkeletonPool(activeBoneCount)
		for idx, line in ipairs(Cache.SkeletonLines) do
			local bData = pendingBones[idx]
			if bData then
				pcall(function()
					line.From = bData.From
					line.To = bData.To
					line.Color = bData.Color
					line.Visible = true
				end)
			else
				pcall(function() line.Visible = false end)
			end
		end
	else
		hideAllSkeletonLines()
	end

	updateAimbotAndSilentAim(cam, now)
end


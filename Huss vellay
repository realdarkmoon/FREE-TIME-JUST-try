local function ensureFOVCircle()
	if fovOutline and fovCore then return end
	clearFOVCircle()

	fovOutline = newDrawing("Circle")
	if fovOutline then
		pcall(function()
			fovOutline.Visible = false
			fovOutline.Color = Color3.fromRGB(6, 8, 14)
			fovOutline.Thickness = 2.8
			fovOutline.Filled = false
			fovOutline.NumSides = 48
			fovOutline.Transparency = 0.8
		end)
	end

	fovCore = newDrawing("Circle")
	if fovCore then
		pcall(function()
			fovCore.Visible = false
			fovCore.Color = Color3.fromRGB(95, 225, 255)
			fovCore.Thickness = 1.4
			fovCore.Filled = false
			fovCore.NumSides = 48
			fovCore.Transparency = 0.95
		end)
	end
end

local function updateFOVCircle(cam)
	local needFOV = State.ShowFOV and (State.AimbotEnabled or State.SilentAimEnabled)
	if not needFOV then
		if fovOutline then pcall(function() fovOutline.Visible = false end) end
		if fovCore then pcall(function() fovCore.Visible = false end) end
		return
	end

	ensureFOVCircle()
	local center = getScreenCenter(cam)
	local activeColor = State.CurrentTarget and Color3.fromRGB(255, 85, 115) or Color3.fromRGB(95, 225, 255)

	if fovOutline then
		pcall(function()
			fovOutline.Position = center
			fovOutline.Radius = State.FOVRadius + 1
			fovOutline.Visible = true
		end)
	end
	if fovCore then
		pcall(function()
			fovCore.Position = center
			fovCore.Radius = State.FOVRadius
			fovCore.Color = activeColor
			fovCore.Visible = true
		end)
	end
end

local function ensureSkeletonRig(plr, boneCount)
	local rig = skeletonRigs[plr]
	if rig and rig.BoneCount == boneCount then
		return rig
	end

	clearSkeletonForPlayer(plr)

	local outlines = {}
	local cores = {}

	for i = 1, boneCount do
		local bg = newDrawing("Line")
		if bg then
			pcall(function()
				bg.Visible = false
				bg.Color = Color3.fromRGB(6, 8, 14)
				bg.Thickness = 3.2
				bg.Transparency = 0.85
			end)
			outlines[i] = bg
		end

		local fg = newDrawing("Line")
		if fg then
			pcall(function()
				fg.Visible = false
				fg.Color = Color3.fromRGB(105, 240, 165)
				fg.Thickness = 1.6
				fg.Transparency = 1
			end)
			cores[i] = fg
		end
	end

	local headOutline = newDrawing("Circle")
	if headOutline then
		pcall(function()
			headOutline.Visible = false
			headOutline.Color = Color3.fromRGB(6, 8, 14)
			headOutline.Thickness = 2.4
			headOutline.Filled = false
			headOutline.NumSides = 20
			headOutline.Transparency = 0.9
		end)
	end

	local headCore = newDrawing("Circle")
	if headCore then
		pcall(function()
			headCore.Visible = false
			headCore.Color = Color3.fromRGB(255, 255, 255)
			headCore.Thickness = 1.6
			headCore.Filled = false
			headCore.NumSides = 20
			headCore.Transparency = 1
		end)
	end

	local boxOutline = newDrawing("Square")
	if boxOutline then
		pcall(function()
			boxOutline.Visible = false
			boxOutline.Color = Color3.fromRGB(6, 8, 14)
			boxOutline.Thickness = 3.0
			boxOutline.Filled = false
			boxOutline.Transparency = 0.85
		end)
	end

	local boxCore = newDrawing("Square")
	if boxCore then
		pcall(function()
			boxCore.Visible = false
			boxCore.Color = Color3.fromRGB(105, 240, 165)
			boxCore.Thickness = 1.5
			boxCore.Filled = false
			boxCore.Transparency = 1
		end)
	end

	rig = {
		BoneCount = boneCount,
		OutlineLines = outlines,
		CoreLines = cores,
		HeadOutline = headOutline,
		HeadCore = headCore,
		BoxOutline = boxOutline,
		BoxCore = boxCore
	}
	skeletonRigs[plr] = rig
	return rig
end

local function hideSkeletonRig(rig)
	if not rig then return end
	if rig.OutlineLines then
		for _, ln in ipairs(rig.OutlineLines) do
			if ln then pcall(function() ln.Visible = false end) end
		end
	end
	if rig.CoreLines then
		for _, ln in ipairs(rig.CoreLines) do
			if ln then pcall(function() ln.Visible = false end) end
		end
	end
	if rig.HeadOutline then
		pcall(function() rig.HeadOutline.Visible = false end)
	end
	if rig.HeadCore then
		pcall(function() rig.HeadCore.Visible = false end)
	end
	if rig.BoxOutline then
		pcall(function() rig.BoxOutline.Visible = false end)
	end
	if rig.BoxCore then
		pcall(function() rig.BoxCore.Visible = false end)
	end
end

local function getPartWorldPoint(char, partName)
	local part = char:FindFirstChild(partName)
	if part and part:IsA("BasePart") then
		return part.Position
	end
	return nil
end

local function updateSkeletonESP(cam)
	local anyVisualActive = State.SkeletonESP or State.HeadDotESP or State.BoxESP
	if not anyVisualActive then
		clearAllSkeletons()
		return
	end

	for plr in pairs(skeletonRigs) do
		if not plr or not plr.Parent then
			clearSkeletonForPlayer(plr)
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")

			if char and hum and root and root:IsA("BasePart") and hum.Health > 0 then
				local isR15 = (hum.RigType == Enum.HumanoidRigType.R15) or (char:FindFirstChild("UpperTorso") ~= nil)
				local bones = isR15 and R15_BONES or R6_BONES
				local rig = ensureSkeletonRig(plr, #bones)
				local _, roleColor = getPlayerRole(plr)

				if State.SkeletonESP then
					for idx, pair in ipairs(bones) do
						local bg = rig.OutlineLines[idx]
						local fg = rig.CoreLines[idx]
						local pA = getPartWorldPoint(char, pair[1])
						local pB = getPartWorldPoint(char, pair[2])

						if bg and fg and pA and pB then
							local sA, visA = cam:WorldToViewportPoint(pA)
							local sB, visB = cam:WorldToViewportPoint(pB)

							if (visA or visB) and sA.Z > 0 and sB.Z > 0 then
								local vA = Vector2.new(sA.X, sA.Y)
								local vB = Vector2.new(sB.X, sB.Y)
								pcall(function()
									bg.From = vA
									bg.To = vB
									bg.Visible = true

									fg.From = vA
									fg.To = vB
									fg.Color = roleColor
									fg.Visible = true
								end)
							else
								pcall(function()
									bg.Visible = false
									fg.Visible = false
								end)
							end
						elseif bg and fg then
							pcall(function()
								bg.Visible = false
								fg.Visible = false
							end)
						end
					end
				else
					for idx = 1, rig.BoneCount do
						local bg = rig.OutlineLines[idx]
						local fg = rig.CoreLines[idx]
						if bg then pcall(function() bg.Visible = false end) end
						if fg then pcall(function() fg.Visible = false end) end
					end
				end

				local headPos = getPartWorldPoint(char, "Head")
				if State.HeadDotESP and headPos and rig.HeadOutline and rig.HeadCore then
					local hScreen, hVis = cam:WorldToViewportPoint(headPos)
					if hVis and hScreen.Z > 0 then
						local radius = math.clamp(190 / math.max(hScreen.Z, 1), 3, 12)
						local center = Vector2.new(hScreen.X, hScreen.Y)
						pcall(function()
							rig.HeadOutline.Position = center
							rig.HeadOutline.Radius = radius + 1.2
							rig.HeadOutline.Visible = true

							rig.HeadCore.Position = center
							rig.HeadCore.Radius = radius
							rig.HeadCore.Color = roleColor
							rig.HeadCore.Visible = true
						end)
					else
						pcall(function()
							rig.HeadOutline.Visible = false
							rig.HeadCore.Visible = false
						end)
					end
				elseif rig.HeadOutline and rig.HeadCore then
					pcall(function()
						rig.HeadOutline.Visible = false
						rig.HeadCore.Visible = false
					end)
				end

				if State.BoxESP and rig.BoxOutline and rig.BoxCore then
					local rootScreen, rVis = cam:WorldToViewportPoint(root.Position)
					if rVis and rootScreen.Z > 0 then
						local topScreen = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, 2.7, 0)).Position)
						local botScreen = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, -3.1, 0)).Position)
						local boxH = math.clamp(math.abs(topScreen.Y - botScreen.Y), 16, 420)
						local boxW = math.clamp(boxH * 0.58, 10, 260)
						local pos = Vector2.new(rootScreen.X - boxW * 0.5, topScreen.Y)
						local sz = Vector2.new(boxW, boxH)

						pcall(function()
							rig.BoxOutline.Position = pos
							rig.BoxOutline.Size = sz
							rig.BoxOutline.Visible = true

							rig.BoxCore.Position = pos
							rig.BoxCore.Size = sz
							rig.BoxCore.Color = roleColor
							rig.BoxCore.Visible = true
						end)
					else
						pcall(function()
							rig.BoxOutline.Visible = false
							rig.BoxCore.Visible = false
						end)
					end
				elseif rig.BoxOutline and rig.BoxCore then
					pcall(function()
						rig.BoxOutline.Visible = false
						rig.BoxCore.Visible = false
					end)
				end
			elseif skeletonRigs[plr] then
				hideSkeletonRig(skeletonRigs[plr])
			end
		end
	end
end

local function updateRoleESP(cam, localPos)
	if not State.RoleESP then
		clearRoleTags()
		return
	end

	for plr, tag in pairs(roleTags) do
		if not plr or not plr.Parent then
			removeDrawing(tag)
			roleTags[plr] = nil
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			local tag = roleTags[plr]
			if not tag then
				tag = newDrawing("Text")
				if tag then
					pcall(function()
						tag.Size = 15
						tag.Center = true
						tag.Outline = true
						tag.Transparency = 1
					end)
					roleTags[plr] = tag
				end
			end

			if tag and root and root:IsA("BasePart") and hum and hum.Health > 0 then
				local roleName, roleColor = getPlayerRole(plr)
				local screenPos, onScreen = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 3.2, 0))
				local dist = localPos and math.floor((localPos - root.Position).Magnitude) or 0

				pcall(function()
					tag.Text = string.format("[%s] %s (%dm)", roleName, plr.Name, dist)
					tag.Color = roleColor
					tag.Position = Vector2.new(screenPos.X, screenPos.Y)
					tag.Visible = onScreen and screenPos.Z > 0
				end)
			elseif tag then
				pcall(function()
					tag.Visible = false
				end)
			end
		end
	end
end

local function updateGunESP(cam, localPos)
	if not State.GunESP then
		clearGunMarker()
		return
	end

	local gunPart = getDroppedGunPart()
	if not gunPart then
		if gunMarker then
			pcall(function()
				gunMarker.Visible = false
			end)
		end
		return
	end

	if not gunMarker then
		gunMarker = newDrawing("Text")
		if gunMarker then
			pcall(function()
				gunMarker.Size = 16
				gunMarker.Center = true
				gunMarker.Outline = true
				gunMarker.Color = Color3.fromRGB(255, 220, 75)
				gunMarker.Transparency = 1
			end)
		end
	end

	if gunMarker then
		local pos, onScreen = cam:WorldToViewportPoint(gunPart.Position + Vector3.new(0, 1.5, 0))
		local dist = localPos and math.floor((localPos - gunPart.Position).Magnitude) or 0
		pcall(function()
			gunMarker.Text = string.format("★ DROPPED GUN [%dm]", dist)
			gunMarker.Position = Vector2.new(pos.X, pos.Y)
			gunMarker.Visible = onScreen and pos.Z > 0
		end)
	end
end

local function updateFrame()
	if State.Unloaded or not State.Unlocked then
		State.CurrentTarget = nil
		State.CurrentAimPos = nil
		clearAllVisuals()
		return
	end

	local cam = Workspace.CurrentCamera
	if not cam then
		State.CurrentTarget = nil
		State.CurrentAimPos = nil
		clearAllVisuals()
		return
	end

	if State.AimbotEnabled or State.SilentAimEnabled then
		State.CurrentTarget, State.CurrentAimPos = getBestAimTarget(cam)
	else
		State.CurrentTarget = nil
		State.CurrentAimPos = nil
	end

	applyCameraAimbot(cam)

	if not drawingOk then
		clearAllVisuals()
		return
	end

	local localPos = getLocalRootPos()
	updateFOVCircle(cam)
	updateSkeletonESP(cam)
	updateRoleESP(cam, localPos)
	updateGunESP(cam, localPos)
end


local function getCharacterScreenBox(char)
	if not char then return nil end
	local root = getRootPart(char)
	if not root then return nil end
	local head = char:FindFirstChild("Head")
	local topWorld = head and (head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.45, 0)) or (root.Position + Vector3.new(0, 2.75, 0))
	local bottomWorld = root.Position - Vector3.new(0, 3.1, 0)
	local topScreen, topVis = Camera:WorldToViewportPoint(topWorld)
	local botScreen, botVis = Camera:WorldToViewportPoint(bottomWorld)
	if topScreen.Z <= 0 and botScreen.Z <= 0 then return nil end
	if not topVis and not botVis then return nil end
	local height = math.abs(botScreen.Y - topScreen.Y)
	if height < 10 or height > 2000 then return nil end
	local width = math.clamp(height * 0.56, 8, 900)
	local centerX = (topScreen.X + botScreen.X) * 0.5
	local topY = math.min(topScreen.Y, botScreen.Y)
	return { x = centerX - (width * 0.5), y = topY, w = width, h = height }
end

local function update2DBoxESP(userId, char, color, inRange)
	if not Drawing or not Drawing.new then return end
	local entry = trackedBoxESP[userId]
	if not entry then
		local ok, created = pcall(function()
			local outlineSq = Drawing.new("Square")
			outlineSq.Thickness = 3
			outlineSq.Filled = false
			outlineSq.Color = Color3.fromRGB(10, 8, 12)
			outlineSq.Transparency = 0.75
			outlineSq.Visible = false

			local boxSq = Drawing.new("Square")
			boxSq.Thickness = 1.5
			boxSq.Filled = false
			boxSq.Color = color
			boxSq.Transparency = 0.96
			boxSq.Visible = false
			return { outline = outlineSq, box = boxSq, smooth = nil }
		end)
		if not ok or not created then return end
		entry = created
		trackedBoxESP[userId] = entry
	end

	if not inRange or not char then
		entry.outline.Visible = false
		entry.box.Visible = false
		entry.smooth = nil
		return
	end

	local targetRect = getCharacterScreenBox(char)
	if not targetRect then
		entry.outline.Visible = false
		entry.box.Visible = false
		entry.smooth = nil
		return
	end

	if not entry.smooth then
		entry.smooth = { x = targetRect.x, y = targetRect.y, w = targetRect.w, h = targetRect.h }
	else
		local alpha = 0.65
		entry.smooth.x = entry.smooth.x + (targetRect.x - entry.smooth.x) * alpha
		entry.smooth.y = entry.smooth.y + (targetRect.y - entry.smooth.y) * alpha
		entry.smooth.w = entry.smooth.w + (targetRect.w - entry.smooth.w) * alpha
		entry.smooth.h = entry.smooth.h + (targetRect.h - entry.smooth.h) * alpha
	end

	local topLeft = Vector2.new(math.floor(entry.smooth.x), math.floor(entry.smooth.y))
	local boxSize = Vector2.new(math.floor(entry.smooth.w), math.floor(entry.smooth.h))
	entry.outline.Position = topLeft
	entry.outline.Size = boxSize
	entry.outline.Visible = true
	entry.box.Position = topLeft
	entry.box.Size = boxSize
	entry.box.Color = color
	entry.box.Visible = true
end

local function updateTracer(id, targetPos, color)
	if not Drawing or not Drawing.new then return end
	local line = trackedTracers[id]
	if not line then
		pcall(function()
			line = Drawing.new("Line")
			line.Thickness = 1.5
			line.Transparency = 0.8
			line.Color = color
			trackedTracers[id] = line
		end)
		line = trackedTracers[id]
	end
	if not line then return end

	if Config.ESPTracers then
		local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos - Vector3.new(0, 2.5, 0))
		if onScreen then
			local localRoot = getRootPart(LocalPlayer.Character)
			local fromPos = nil
			if localRoot then
				local myScreenPos, myOnScreen = Camera:WorldToViewportPoint(localRoot.Position - Vector3.new(0, 2.8, 0))
				if myOnScreen then fromPos = Vector2.new(myScreenPos.X, myScreenPos.Y) end
			end
			if not fromPos then
				fromPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
			end
			line.From = fromPos
			line.To = Vector2.new(screenPos.X, screenPos.Y)
			line.Color = color
			line.Visible = true
		else
			line.Visible = false
		end
	else
		line.Visible = false
	end
end

local function removeTracer(id)
	if trackedTracers[id] then
		pcall(function() trackedTracers[id]:Remove() end)
		trackedTracers[id] = nil
	end
end

-- SILENT AIM HOOK
if hookmetamethod and getnamecallmethod then
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if silentAimHookActive and not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
			local remoteName = tostring(self.Name)
			local lremote = string.lower(remoteName)
			local isKnifeThrowRemote = (remoteName == "KnifeThrown") or string.find(lremote, "throw", 1, true)

			if isKnifeThrowRemote and (Config.KnifeSilentAim or Config.AutoSilentKnife or Config.SilentAim) then
				local args = {...}
				local target = getClosestKnifeTarget()
				if target and target.Character then
					local tRoot = getRootPart(target.Character)
					if tRoot then
						local targetPos = computeAimPos(tRoot)
						if targetPos then
							if typeof(args[2]) == "CFrame" then
								args[2] = CFrame.new(targetPos)
							elseif typeof(args[2]) == "Vector3" then
								args[2] = targetPos
							elseif typeof(args[1]) == "CFrame" then
								args[1] = CFrame.new(targetPos)
							elseif typeof(args[1]) == "Vector3" then
								args[1] = targetPos
							else
								args[2] = CFrame.new(targetPos)
							end
							if setnamecallmethod then setnamecallmethod(method) end
							return oldNamecall(self, unpack(args))
						end
					end
				end
			elseif remoteName == "Shoot" and Config.SilentAim then
				local args = {...}
				local murderer = getMurderer()
				if murderer and murderer.Character then
					local mRoot = getRootPart(murderer.Character)
					if mRoot then
						local targetPos = computeAimPos(mRoot)
						if targetPos then
							args[2] = CFrame.new(targetPos)
							if setnamecallmethod then setnamecallmethod(method) end
							return oldNamecall(self, unpack(args))
						end
					end
				end
			end
		end
		if setnamecallmethod then setnamecallmethod(method) end
		return oldNamecall(self, ...)
	end))
end


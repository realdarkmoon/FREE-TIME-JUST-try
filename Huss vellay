-- ==========================================
-- SERVER & REMOTE BYPASS STEP TELEPORT ENGINE
-- ==========================================
local function stepCharacterToward(char, hum, root, nextPos, flatLook, velHint)
	if not char or not root or not root.Parent then return end
	cleanCharacterTethers(char, hum, root, State.ServerSystemBypass)

	local targetCF = flatLook.Magnitude > 0.001
		and CFrame.new(nextPos, nextPos + flatLook.Unit)
		or CFrame.new(nextPos)

	root.CFrame = targetCF
	pcall(function()
		char:PivotTo(targetCF)
	end)

	if State.ServerSystemBypass and State.BypassVelocitySync and isValidPos(velHint) then
		root.AssemblyLinearVelocity = velHint
	end

	if State.RemoteSystemBypass and State.RemoteSyncGuard then
		pulseMovementRemotes("step", targetCF)
	end
end

local function teleportToCFrame(targetCF, customOffsetY)
	if State.Unloaded or State.TpRunning or typeof(targetCF) ~= "CFrame" then
		return false
	end
	if not isValidPos(targetCF.Position) then
		return false
	end

	local now = os.clock()
	if (now - State.LastTpTime) < 0.15 then
		return false
	end
	State.LastTpTime = now

	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char or not root then
		return false
	end

	local yOff = (typeof(customOffsetY) == "number") and customOffsetY or 3.0
	local goalPos = targetCF.Position + Vector3.new(0, yOff, 0)
	local look = targetCF.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)

	markIntent(1.6)
	State.TpRunning = true

	task.spawn(function()
		local startPos = root.Position
		local dist = (goalPos - startPos).Magnitude
		local stepSize = math.max(8, tonumber(State.StepStuds) or 16)
		local steps = math.clamp(math.ceil(dist / stepSize), 1, 30)

		for i = 1, steps do
			if State.Unloaded or not Cached.Char or not Cached.Hum or not Cached.Root or Cached.Hum.Health <= 0 then
				break
			end
			markIntent(1.0)
			local alpha = i / steps
			local curPos = startPos:Lerp(goalPos, alpha)
			local dir = goalPos - curPos
			local vel = dir.Magnitude > 0.1 and (dir.Unit * math.min(dir.Magnitude * 8, 60)) or Vector3.zero
			stepCharacterToward(Cached.Char, Cached.Hum, Cached.Root, curPos, flatLook, vel)
			RunService.Heartbeat:Wait()
		end

		local holdCount = math.clamp(tonumber(State.HoldFrames) or 6, 1, 15)
		for _ = 1, holdCount do
			if State.Unloaded or not Cached.Char or not Cached.Hum or not Cached.Root or Cached.Hum.Health <= 0 then
				break
			end
			markIntent(1.0)
			stepCharacterToward(Cached.Char, Cached.Hum, Cached.Root, goalPos, flatLook, Vector3.zero)
			RunService.Heartbeat:Wait()
		end

		if not State.Unloaded and Cached.Root and isValidPos(Cached.Root.Position) then
			State.LastCleanCFrame = Cached.Root.CFrame
		end
		State.TpRunning = false
	end)

	return true
end

local function saveCurrentSpot()
	local root = Cached.Root
	if not root or not isValidPos(root.Position) then return false end
	State.SavedCFrame = root.CFrame
	return true
end

local function teleportSavedSpot()
	if not State.SavedCFrame then
		if not saveCurrentSpot() then return false end
	end
	return teleportToCFrame(State.SavedCFrame, 3.0)
end

local function teleportNearestPlayer()
	local root = Cached.Root
	if not root or not isValidPos(root.Position) then return false end

	local bestRoot = nil
	local bestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local otherRoot = plr.Character:FindFirstChild("HumanoidRootPart")
				or plr.Character:FindFirstChild("Torso")
				or plr.Character:FindFirstChild("UpperTorso")
			if otherRoot and isValidPos(otherRoot.Position) then
				local d = (otherRoot.Position - root.Position).Magnitude
				if d < bestDist then
					bestDist = d
					bestRoot = otherRoot
				end
			end
		end
	end

	if not bestRoot then return false end
	return teleportToCFrame(bestRoot.CFrame * CFrame.new(0, 0, 3.5), 2.5)
end

-- ==========================================
-- UNDER MAP & RETURN SURFACE
-- ==========================================
local refreshFloatText = nil

local function setUnderMap(enabled)
	if State.Unloaded then return end
	local root = Cached.Root
	if not root or not isValidPos(root.Position) then return end

	if enabled then
		if not State.UnderMapEnabled then
			State.SavedSurfaceCFrame = root.CFrame
		end
		State.UnderMapEnabled = true
		markIntent(1.5)
		local targetY = root.Position.Y - math.max(5, tonumber(State.UnderMapDepth) or 14)
		State.UnderAnchorY = targetY
		ensurePlatform()
		underPlatform.Parent = Workspace
		underPlatform.CFrame = CFrame.new(root.Position.X, targetY - 3.5, root.Position.Z)

		local look = root.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		local destPos = Vector3.new(root.Position.X, targetY, root.Position.Z)
		local destCF = flatLook.Magnitude > 0.001 and CFrame.new(destPos, destPos + flatLook.Unit) or CFrame.new(destPos)
		stepCharacterToward(Cached.Char, Cached.Hum, root, destPos, flatLook, Vector3.zero)
		State.LastCleanCFrame = destCF
	else
		State.UnderMapEnabled = false
		State.UnderAnchorY = nil
		if underPlatform then
			underPlatform.Parent = nil
		end
		if State.SavedSurfaceCFrame then
			local destCF = State.SavedSurfaceCFrame + Vector3.new(0, 3.0, 0)
			State.SavedSurfaceCFrame = nil
			teleportToCFrame(destCF, 0)
		else
			local upPos = root.Position + Vector3.new(0, (tonumber(State.UnderMapDepth) or 14) + 5, 0)
			teleportToCFrame(CFrame.new(upPos), 0)
		end
	end

	if refreshFloatText then
		refreshFloatText()
	end
end

-- ==========================================
-- WALL BYPASS & SERVER BYPASS SYSTEMS
-- ==========================================
local function getMoveDirFlat()
	local hum = Cached.Hum
	local root = Cached.Root
	if hum and hum.MoveDirection.Magnitude > 0.05 then
		local v = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
		if v.Magnitude > 0.001 then return v.Unit end
	end
	if root then
		local l = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if l.Magnitude > 0.001 then return l.Unit end
	end
	return Vector3.new(0, 0, -1)
end

local function isClearSpot(pos)
	local hits = Workspace:GetPartBoundsInRadius(pos, 1.6, overlapParams)
	for _, p in ipairs(hits) do
		if p:IsA("BasePart") and p.CanCollide and p.Transparency < 0.98 then
			return false
		end
	end
	return true
end

local function executeWallBypass(force)
	if State.Unloaded or State.TpRunning then return false end
	local char = Cached.Char
	local root = Cached.Root
	if not char or not root or not isValidPos(root.Position) then return false end

	local dir = getMoveDirFlat()
	if not force then
		local hit = Workspace:Raycast(root.Position, dir * 3.5, rayParams)
		if not hit then
			return false
		end
	end

	local maxScan = math.clamp(tonumber(State.BypassScanDist) or 22, 6, 50)
	local chosen = nil

	for d = 3, maxScan do
		local probe = root.Position + (dir * d)
		if isClearSpot(probe) then
			local floorHit = Workspace:Raycast(probe + Vector3.new(0, 2.5, 0), Vector3.new(0, -10, 0), rayParams)
			if floorHit and isValidPos(floorHit.Position) then
				chosen = Vector3.new(probe.X, floorHit.Position.Y + 3.0, probe.Z)
			else
				chosen = probe
			end
			break
		end
	end

	if not chosen then
		chosen = root.Position + (dir * math.min(maxScan, 14))
	end

	State.LastBypassTime = os.clock()
	return teleportToCFrame(CFrame.new(chosen, chosen + dir), 0)
end

local function applyServerBypassSystems(char, hum, root, now)
	if not char or not hum or not root then return end

	if State.ServerSystemBypass and State.BypassStateLock then
		enforceStateLock(hum)
	end

	if State.ServerSystemBypass and State.BypassVelocitySync then
		local maxSpd = State.SpeedEnabled and (95 + State.ExtraSpeed) or 95
		if isValidPos(root.AssemblyLinearVelocity) and root.AssemblyLinearVelocity.Magnitude > maxSpd then
			local dir = root.AssemblyLinearVelocity.Magnitude > 0.001 and root.AssemblyLinearVelocity.Unit or Vector3.zero
			root.AssemblyLinearVelocity = dir * maxSpd
		end
		if isValidPos(root.AssemblyAngularVelocity) and root.AssemblyAngularVelocity.Magnitude > 28 then
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if State.ServerSystemBypass and (now - State.LastCleanSweep) >= 0.45 then
		State.LastCleanSweep = now
		cleanCharacterTethers(char, hum, root, true)
	end

	if State.AntiPullbackGuard and not State.UnderMapEnabled and not State.TpRunning and now > State.IgnoreGuardUntil then
		if State.LastCleanCFrame and isValidPos(root.Position) then
			local jumpDist = (root.Position - State.LastCleanCFrame.Position).Magnitude
			if jumpDist > (tonumber(State.PullbackThreshold) or 42) then
				stepCharacterToward(char, hum, root, State.LastCleanCFrame.Position, State.LastCleanCFrame.LookVector, Vector3.zero)
				return
			end
		end
		if isValidPos(root.Position) then
			State.LastCleanCFrame = root.CFrame
		end
	elseif isValidPos(root.Position) then
		State.LastCleanCFrame = root.CFrame
	end
end

-- ==========================================
-- VISUALS: PLAYER ESP & FULLBRIGHT
-- ==========================================
local espEntries = {}
local drawingAvailable = (typeof(Drawing) == "table" and typeof(Drawing.new) == "function")

local function safeDrawing(kind)
	if not drawingAvailable then return nil end
	local ok, obj = pcall(function()
		return Drawing.new(kind)
	end)
	return ok and obj or nil
end

local function ensureEspEntry(plr)
	if espEntries[plr] then return espEntries[plr] end
	local box = safeDrawing("Square")
	local label = safeDrawing("Text")
	local line = safeDrawing("Line")

	if box then
		pcall(function()
			box.Visible = false
			box.Color = Color3.fromRGB(255, 95, 95)
			box.Thickness = 1.5
			box.Filled = false
			box.Transparency = 1
		end)
	end
	if label then
		pcall(function()
			label.Visible = false
			label.Color = Color3.fromRGB(235, 245, 255)
			label.Size = 14
			label.Center = true
			label.Outline = true
			label.Transparency = 1
		end)
	end
	if line then
		pcall(function()
			line.Visible = false
			line.Color = Color3.fromRGB(110, 195, 255)
			line.Thickness = 1.2
			line.Transparency = 1
		end)
	end

	local entry = { Box = box, Label = label, Line = line }
	espEntries[plr] = entry
	return entry
end

local function hideEspEntry(entry)
	if not entry then return end
	if entry.Box then pcall(function() entry.Box.Visible = false end) end
	if entry.Label then pcall(function() entry.Label.Visible = false end) end
	if entry.Line then pcall(function() entry.Line.Visible = false end) end
end

local function removeEspForPlayer(plr)
	local entry = espEntries[plr]
	if entry then
		if entry.Box then pcall(function() entry.Box:Remove() end) end
		if entry.Label then pcall(function() entry.Label:Remove() end) end
		if entry.Line then pcall(function() entry.Line:Remove() end) end
		espEntries[plr] = nil
	end
end

local function clearAllEsp()
	for plr in pairs(espEntries) do
		removeEspForPlayer(plr)
	end
end

local function setFullbright(enabled)
	State.FullbrightEnabled = enabled
	pcall(function()
		if enabled then
			Lighting.Brightness = 2.5
			Lighting.ClockTime = 14
			Lighting.FogEnd = 100000
			Lighting.GlobalShadows = false
		else
			Lighting.Brightness = Cached.OrigLighting.Brightness
			Lighting.ClockTime = Cached.OrigLighting.ClockTime
			Lighting.FogEnd = Cached.OrigLighting.FogEnd
			Lighting.GlobalShadows = Cached.OrigLighting.GlobalShadows
		end
	end)
end

local function updateVisualsFrame()
	if State.Unloaded or not State.PlayerESPEnabled or not drawingAvailable then
		for _, entry in pairs(espEntries) do
			hideEspEntry(entry)
		end
		return
	end

	local cam = Workspace.CurrentCamera
	if not cam then return end

	for plr, entry in pairs(espEntries) do
		if not plr or not plr.Parent then
			removeEspForPlayer(plr)
		end
	end

	local myPos = Cached.Root and Cached.Root.Position or cam.CFrame.Position
	local originTracer = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local entry = ensureEspEntry(plr)
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and (
				char:FindFirstChild("HumanoidRootPart")
				or char:FindFirstChild("Torso")
				or char:FindFirstChild("UpperTorso")
			)

			if root and hum and hum.Health > 0 and isValidPos(root.Position) then
				local rootScreen, onScreen = cam:WorldToViewportPoint(root.Position)
				if onScreen and rootScreen.Z > 0 then
					local topScreen = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, 2.6, 0)).Position)
					local botScreen = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, -3.1, 0)).Position)
					local h = math.clamp(math.abs(topScreen.Y - botScreen.Y), 18, 400)
					local w = math.clamp(h * 0.6, 12, 250)
					local dist = math.floor((root.Position - myPos).Magnitude)

					if entry.Box then
						pcall(function()
							entry.Box.Size = Vector2.new(w, h)
							entry.Box.Position = Vector2.new(rootScreen.X - (w * 0.5), topScreen.Y)
							entry.Box.Visible = State.ESPBoxes
						end)
					end

					if entry.Label then
						local textOut = State.ESPDistance and string.format("%s [%dm]", plr.Name, dist) or plr.Name
						pcall(function()
							entry.Label.Text = textOut
							entry.Label.Position = Vector2.new(rootScreen.X, topScreen.Y - 18)
							entry.Label.Visible = true
						end)
					end

					if entry.Line then
						pcall(function()
							entry.Line.From = originTracer
							entry.Line.To = Vector2.new(rootScreen.X, botScreen.Y)
							entry.Line.Visible = State.ESPTracers
						end)
					end
				else
					hideEspEntry(entry)
				end
			else
				hideEspEntry(entry)
			end
		end
	end
end


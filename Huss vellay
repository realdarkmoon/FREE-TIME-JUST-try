local conns = {}

if LocalPlayer.Character then
	rebuildCharCache(LocalPlayer.Character)
end

table.insert(conns, LocalPlayer.CharacterAdded:Connect(function(char)
	if State.Unloaded then return end
	table.clear(Cache.OrigHandleSize)
	rebuildCharCache(char)
	task.wait(0.15)
	if State.SpeedEnabled then applySpeed() end
	if State.KnifeReachEnabled then updateKnifeReach() end
end))

table.insert(conns, Players.PlayerRemoving:Connect(function(plr)
	Cache.PlayerRoles[plr] = nil
	clearRoleVisualFor(plr)
	removeCS2Box(plr)
end))

table.insert(conns, RunService.RenderStepped:Connect(function()
	if State.Unloaded then return end
	local now = os.clock()
	updateRenderVisuals(Workspace.CurrentCamera, now)
end))

table.insert(conns, RunService.Heartbeat:Connect(function()
	if State.Unloaded then return end
	local now = os.clock()

	if State.PingCompensation then
		sampleNetworkPing(now)
	end

	if State.KnifeReachEnabled then
		updateKnifeReach()
	end

	if State.SpeedEnabled and Cache.Hum and Cache.Hum.WalkSpeed ~= State.WalkSpeedBoost then
		Cache.Hum.WalkSpeed = State.WalkSpeedBoost
	end

	if State.NoclipEnabled then
		stepNoclip(now)
	end

	if State.RoleESP and (now - State.LastRoleScan) >= 0.35 then
		State.LastRoleScan = now
		scanRoles()
	end

	if State.GunESP and (now - State.LastGunScan) >= 0.45 then
		State.LastGunScan = now
		updateGunESP()
	end

	if State.AutoGrabGun and (now - State.LastGunGrab) >= 0.55 then
		if findDroppedGunTarget() then
			State.LastGunGrab = now
			pullDroppedGunToPocket()
		end
	end
end))

local function unloadHub()
	if State.Unloaded then return end
	State.Unloaded = true
	State.RoleESP = false
	State.GunESP = false
	State.CS2BoxESP = false
	State.SkeletonESP = false
	State.AutoGrabGun = false
	State.AimbotEnabled = false
	State.SilentAimEnabled = false
	State.KnifeReachEnabled = false
	State.SpeedEnabled = false
	State.NoclipEnabled = false
	restoreKnifeHandles()
	restoreCollisions()
	if Cache.Hum then
		Cache.Hum.WalkSpeed = State.DefaultWalkSpeed
	end
	clearAllRoleVisuals()
	clearGunVisuals()
	clearAllCS2Boxes()
	clearAllSkeletonLines()
	disconnectAll(conns)
	if floatGui then
		floatGui:Destroy()
		floatGui = nil
	end
	pcall(function() Window:Destroy() end)
end


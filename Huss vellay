table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	if State.Unloaded then return end
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char or not hum or not root or hum.Health <= 0 then return end

	local clampedDt = math.min(dt, 0.05)
	local now = os.clock()

	if State.AutoWallBypass and not State.TpRunning and hum.MoveDirection.Magnitude > 0.1 and (now - State.LastBypassTime) > 0.3 then
		executeWallBypass(false)
	end

	if State.UnderMapEnabled and not State.TpRunning and isValidPos(root.Position) then
		markIntent(0.35)
		local targetY = State.UnderMapLockY and State.UnderAnchorY or root.Position.Y
		if targetY then
			if root.Position.Y < (targetY - 1.5) then
				local look = root.CFrame.LookVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				local p = Vector3.new(root.Position.X, targetY, root.Position.Z)
				stepCharacterToward(char, hum, root, p, flatLook, Vector3.zero)
			end
			ensurePlatform()
			underPlatform.Parent = Workspace
			underPlatform.CFrame = CFrame.new(root.Position.X, targetY - 3.5, root.Position.Z)
		end
	end

	if State.SpeedEnabled and not State.TpRunning and hum.MoveDirection.Magnitude > 0.05 then
		local flatDir = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
		if flatDir.Magnitude > 0.001 then
			flatDir = flatDir.Unit
			markIntent(0.25)
			root.CFrame = root.CFrame + (flatDir * State.ExtraSpeed * clampedDt)
			if State.ServerSystemBypass and State.BypassVelocitySync then
				local curV = root.AssemblyLinearVelocity
				local targetSpd = hum.WalkSpeed + State.ExtraSpeed
				root.AssemblyLinearVelocity = Vector3.new(flatDir.X * targetSpd, isValidPos(curV) and curV.Y or 0, flatDir.Z * targetSpd)
			end
		end
	end

	if State.JumpEnabled then
		if hum.UseJumpPower then
			if hum.JumpPower ~= State.JumpPower then
				hum.JumpPower = State.JumpPower
			end
		else
			local h = State.JumpPower / 5
			if hum.JumpHeight ~= h then
				hum.JumpHeight = h
			end
		end
	end

	applyServerBypassSystems(char, hum, root, now)
end))


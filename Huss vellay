local function applySpeed()
	if Cache.Hum and not State.Unloaded then
		Cache.Hum.WalkSpeed = State.SpeedEnabled and State.WalkSpeedBoost or State.DefaultWalkSpeed
	end
end

local function restoreCollisions()
	for part, orig in pairs(Cache.OrigCollide) do
		if part and part.Parent and part:IsA("BasePart") then
			part.CanCollide = orig
		end
	end
end

local function stepNoclip(now)
	if not State.NoclipEnabled or State.Unloaded then return end
	if (now - State.LastNoclipStep) < 0.04 then return end
	State.LastNoclipStep = now

	for i = #Cache.Parts, 1, -1 do
		local part = Cache.Parts[i]
		if part and part.Parent then
			part.CanCollide = false
		else
			table.remove(Cache.Parts, i)
		end
	end
end


end))

getgenv().DarkMoonWindUIUnload = function()
	for _, conn in ipairs(activeConnections) do pcall(function() conn:Disconnect() end) end
	activeConnections = {}
	silentAimHookActive = false
	clearESPCategory("")
	if auraRingPart then pcall(function() auraRingPart:Destroy() end) end
	if fovCircle then pcall(function() fovCircle:Remove() end) end
	for part, sz in pairs(originalHitboxSizes) do
		if part and part.Parent then part.Size = sz part.Transparency = 1 end
	end
	originalHitboxSizes = {}
	pcall(function() Window:Destroy() end)
	getgenv().DarkMoonWindUIUnload = nil
end

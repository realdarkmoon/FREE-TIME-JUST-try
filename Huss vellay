-- ==========================================
-- HEARTBEAT LOOP
-- ==========================================
table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	if State.Unloaded or State.TpRunning then return end
	local hum = Cached.Hum
	local root = Cached.Root
	if not hum or not root or hum.Health <= 0 then return end

	if State.SpeedEnabled and hum.MoveDirection.Magnitude > 0.05 then
		local flatDir = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
		if flatDir.Magnitude > 0.001 then
			root.CFrame = root.CFrame + (flatDir.Unit * State.ExtraSpeed * math.min(dt, 0.05))
		end
	end

	if State.JumpEnabled then
		if hum.UseJumpPower then
			if hum.JumpPower ~= State.JumpPower then
				hum.JumpPower = State.JumpPower
			end
		else
			local h = State.JumpPower / 5
			if hum.JumpHeight ~= h then
				hum.JumpHeight = h
			end
		end
	end
end))


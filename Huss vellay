local function cleanupAll()
	if State.Unloaded then return end
	State.Unloaded = true
	State.Unlocked = false
	State.RoleESP = false
	State.GunESP = false
	State.SkeletonESP = false
	State.HeadDotESP = false
	State.BoxESP = false
	State.AimbotEnabled = false
	State.SilentAimEnabled = false
	State.ShowFOV = false
	State.CachedGunPart = nil
	State.CurrentTarget = nil
	State.CurrentAimPos = nil

	removeSilentAimHooks()
	clearAllVisuals()

	for _, conn in ipairs(Connections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(Connections)

	if gui then
		gui:Destroy()
	end
end

local function attemptUnlock()
	if State.Unloaded or State.Unlocked or State.Unlocking then return end

	local entered = tostring(keyBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if entered == CONFIG.AccessKey then
		State.Unlocking = true
		statusLbl.TextColor3 = Color3.fromRGB(105, 240, 165)
		statusLbl.Text = "Access granted! Opening hub..."
		boxStroke.Color = Color3.fromRGB(105, 240, 165)

		local cardTween = TweenService:Create(lockCard, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(362, 276),
			BackgroundTransparency = 0.35
		})
		local bgTween = TweenService:Create(lockFrame, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 1
		})

		cardTween:Play()
		bgTween:Play()

		task.delay(0.26, function()
			if State.Unloaded then return end
			State.Unlocked = true
			State.Unlocking = false
			lockFrame.Visible = false
			mainPanel.Visible = State.HubVisible
			moonBtn.Visible = true
		end)
	else
		statusLbl.TextColor3 = Color3.fromRGB(255, 95, 125)
		statusLbl.Text = "Invalid key! Use: " .. CONFIG.AccessKey
		boxStroke.Color = Color3.fromRGB(255, 85, 115)
	end
end


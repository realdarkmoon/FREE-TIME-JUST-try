local auraRingPart, auraRingGui, fovCircle
if Drawing and Drawing.new then
	pcall(function()
		fovCircle = Drawing.new("Circle")
		fovCircle.Thickness = 1.5
		fovCircle.Color = Colors.Accent
		fovCircle.Filled = false
		fovCircle.Transparency = 0.8
		fovCircle.Visible = false
	end)
end

local function updateAuraRing(root)
	if not Config.ShowAuraRing or not root then
		if auraRingPart then
			auraRingPart.Transparency = 1
			if auraRingGui then auraRingGui.Enabled = false end
		end
		return
	end
	local diameter = Config.AuraRange * 2
	if not auraRingPart or not auraRingPart.Parent then
		auraRingPart = Instance.new("Part")
		auraRingPart.Name = "DarkMoon_WindUI_AuraRing"
		auraRingPart.Size = Vector3.new(diameter, 0.01, diameter)
		auraRingPart.Anchored = true
		auraRingPart.CanCollide = false
		auraRingPart.CastShadow = false
		auraRingPart.Transparency = 1
		auraRingPart.Parent = Workspace

		auraRingGui = Instance.new("SurfaceGui")
		auraRingGui.Face = Enum.NormalId.Top
		auraRingGui.AlwaysOnTop = true
		auraRingGui.LightInfluence = 0
		auraRingGui.Adornee = auraRingPart
		auraRingPart.Parent = Workspace
		auraRingGui.Parent = auraRingPart

		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundColor3 = Colors.Accent
		frame.BackgroundTransparency = 0.92
		frame.BorderSizePixel = 0
		frame.Parent = auraRingGui
		Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)
		local st = Instance.new("UIStroke", frame)
		st.Color = Colors.Accent
		st.Thickness = 2.5
	end
	if auraRingGui then auraRingGui.Enabled = true end
	auraRingPart.Size = Vector3.new(diameter, 0.01, diameter)
	auraRingPart.CFrame = CFrame.new(root.Position.X, root.Position.Y - 2.85, root.Position.Z)
end

local lastShootTick, lastKnifeTick = 0, 0

table.insert(activeConnections, RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	local root = getRootPart(char)
	local hum = getHumanoid(char)
	local now = tick()

	updateAuraRing(root)
	if fovCircle then
		fovCircle.Visible = Config.ShowFOV
		fovCircle.Radius = Config.FOVRadius
		fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	end

	local murderer = getMurderer()

	if Config.RoleESP and root then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and isPlayerAlive(p) then
				local pRoot = getRootPart(p.Character)
				if pRoot then
					local dist = math.floor((root.Position - pRoot.Position).Magnitude)
					local role = getPlayerRole(p)
					local col = (role == "Murderer" and Colors.Bad) or (role == "Sheriff" and Colors.Blue) or Colors.Good
					local inRange = dist <= Config.ESPDistanceMax
					local text = Config.ESPNames and ("[" .. role .. "] " .. p.Name) or p.Name
					if Config.ESPDistance then text = text .. " (" .. dist .. "s)" end

					if inRange then
						getOrCreateESP("mm2_" .. p.UserId, pRoot, text, col)
						if Config.ESPChams then getOrCreateCham(p.UserId, p.Character, col) end
						updateTracer("mm2_" .. p.UserId, pRoot.Position, col)
					else
						if trackedESPElements["mm2_" .. p.UserId] then trackedESPElements["mm2_" .. p.UserId]:Destroy() trackedESPElements["mm2_" .. p.UserId] = nil end
						if trackedESPElements["cham_" .. p.UserId] then trackedESPElements["cham_" .. p.UserId]:Destroy() trackedESPElements["cham_" .. p.UserId] = nil end
						removeTracer("mm2_" .. p.UserId)
					end

					if Config.ESPBoxes then
						update2DBoxESP(p.UserId, p.Character, col, inRange)
					else
						removeBoxESPForId(p.UserId)
					end
				end
			else
				if trackedESPElements["mm2_" .. p.UserId] then trackedESPElements["mm2_" .. p.UserId]:Destroy() trackedESPElements["mm2_" .. p.UserId] = nil end
				if trackedESPElements["cham_" .. p.UserId] then trackedESPElements["cham_" .. p.UserId]:Destroy() trackedESPElements["cham_" .. p.UserId] = nil end
				removeTracer("mm2_" .. p.UserId)
				removeBoxESPForId(p.UserId)
			end
		end
	else
		clear2DBoxESP()
	end

	if Config.GunESP and root then
		local drop = getGunDrop()
		local gunPart = getGunDropPart(drop)
		if gunPart then
			local dist = math.floor((root.Position - gunPart.Position).Magnitude)
			if dist <= Config.ESPDistanceMax then
				getOrCreateESP("gun_drop", gunPart, "[GUN DROP] " .. dist .. "m", Colors.Yellow)
			end
		else
			clearESPCategory("gun_")
		end
	end

	if root and hum then
		local bp = LocalPlayer:FindFirstChild("Backpack")
		local gun = (bp and bp:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun"))
		if Config.AutoEquipGun and gun and bp and gun.Parent == bp and murderer then
			hum:EquipTool(gun)
		end
		if Config.GrabGunAuto then
			local drop = getGunDrop()
			local gunPart = getGunDropPart(drop)
			if gunPart and (root.Position - gunPart.Position).Magnitude <= Config.GunGrabDist then
				interactWithGunDrop(gunPart, drop)
			end
		end
	end

	if Config.AutoShoot and root and (now - lastShootTick >= 0.5) then
		local bp = LocalPlayer:FindFirstChild("Backpack")
		local gun = (bp and bp:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun"))
		if gun and murderer and murderer.Character and isPlayerAlive(murderer) then
			local mRoot = getRootPart(murderer.Character)
			if mRoot then
				if hum and bp and gun.Parent == bp then hum:EquipTool(gun) end
				local rayAtt = root:FindFirstChild("GunRaycastAttachment")
				local origin = rayAtt and rayAtt.WorldCFrame or root.CFrame
				if gun:FindFirstChild("Shoot") then
					gun.Shoot:FireServer(origin, CFrame.new(computeAimPos(mRoot) or mRoot.Position))
					lastShootTick = now
					if Config.SingleShot then
						Config.AutoShoot = false
						local t = uiToggles.AutoShoot
						if t and t.Set then pcall(t.Set, t, false) end
					end
				end
			end
		end
	end

	if Config.ProximityKnife and root and hum then
		local knife, knifeParent = getKnifeTool(char)
		local bp = LocalPlayer:FindFirstChild("Backpack")
		if knife and bp and knifeParent == bp then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and isPlayerAlive(p) and p.Character then
					local tRoot = getRootPart(p.Character)
					if tRoot and (root.Position - tRoot.Position).Magnitude <= Config.KnifeProxDist then
						hum:EquipTool(knife)
						break
					end
				end
			end
		end
	end

	if (Config.KillAura or Config.AutoKill or Config.AutoSilentKnife) and root and (now - lastKnifeTick >= 0.22) then
		local knife, knifeParent = getKnifeTool(char)
		if knife then
			local bp = LocalPlayer:FindFirstChild("Backpack")
			if (Config.AutoEquipKnife or Config.AutoKill or Config.AutoSilentKnife) and hum and bp and knifeParent == bp then
				hum:EquipTool(knife)
			end
			local throwRemote = getKnifeThrowRemote(knife)
			local wantsThrow = Config.AutoSilentKnife or (Config.KillMode == "Throw")

			if wantsThrow and throwRemote then
				local originPart = getKnifeOriginPart(knife, root)
				local originCF = (originPart and originPart:IsA("BasePart") and originPart.CFrame) or root.CFrame
				if Config.KillAll then
					local threwAny = false
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer and isPlayerAlive(p) and p.Character then
							local tRoot = getRootPart(p.Character)
							if tRoot and (Config.AutoSilentKnife or (root.Position - tRoot.Position).Magnitude <= Config.AuraRange) then
								if fireKnifeThrowRemote(throwRemote, originCF, computeAimPos(tRoot)) then threwAny = true end
							end
						end
					end
					if threwAny then lastKnifeTick = now end
				else
					local target = getClosestKnifeTarget()
					if target and target.Character then
						local tRoot = getRootPart(target.Character)
						if tRoot and (Config.AutoSilentKnife or (root.Position - tRoot.Position).Magnitude <= Config.AuraRange) then
							if fireKnifeThrowRemote(throwRemote, originCF, computeAimPos(tRoot)) then lastKnifeTick = now end
						end
					end
				end
			elseif (Config.KillAura or Config.AutoKill) and Config.KillMode ~= "Throw" then
				local events = knife:FindFirstChild("Events")
				if events and events:FindFirstChild("HandleTouched") then
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer and isPlayerAlive(p) then
							local tRoot = getRootPart(p.Character)
							if tRoot and (Config.KillAll or (root.Position - tRoot.Position).Magnitude <= Config.AuraRange) then
								events.HandleTouched:FireServer(tRoot)
								if events:FindFirstChild("KnifeStabbed") then events.KnifeStabbed:FireServer() end
								lastKnifeTick = now
								if not Config.KillAll then break end
							end
						end
					end
				end
			end
		end
	end

	if Config.HitboxExpander then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and isPlayerAlive(p) then
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					if not originalHitboxSizes[hrp] then originalHitboxSizes[hrp] = hrp.Size end
					hrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
					hrp.Transparency = Config.HitboxTransparency
					hrp.CanCollide = false
				end
			end
		end
	end

	if Config.FollowMurderer and root and murderer and murderer.Character then
		local mRoot = getRootPart(murderer.Character)
		if mRoot then
			local targetPos = mRoot.Position - (mRoot.CFrame.LookVector * Config.FollowDist)
			root.CFrame = root.CFrame:Lerp(CFrame.new(targetPos, mRoot.Position), 0.15)
		end
	end
end))


})

-- === TAB 4: FAVORITES ===
FavTab:Section({ Title = "Quick Favorites" })

FavTab:Button({
	Title = "Favorite Current Song",
	Desc = "Saves currently playing Roblox ID or local track",
	Icon = "star",
	Callback = function()
		local entryLabel = state.currentTitle
		if favMap[entryLabel] then
			notify("Already Saved", entryLabel .. " is already in Favorites.", "star")
			return
		end
		if state.sourceMode == "local" and state.selectedFileLabel then
			table.insert(favorites, {
				label = state.selectedFileLabel,
				mode = "local",
				value = state.selectedFileLabel,
			})
		else
			table.insert(favorites, {
				label = state.currentTitle,
				mode = "roblox",
				value = state.currentId,
			})
		end
		refreshFavorites()
		notify("Favorited", "Added " .. entryLabel, "star")
	end,
})

refreshFavorites()

favDropdown = FavTab:Dropdown({
	Title = "Favorite Tracks",
	Values = favLabels,
	Value = favLabels[1],
	Callback = function(v)
		if v and v ~= "No favorites yet" then
			state.selectedFavLabel = v
		end
	end,
})

FavTab:Button({
	Title = "Play Favorite",
	Icon = "play",
	Callback = function()
		local item = state.selectedFavLabel and favMap[state.selectedFavLabel]
		if not item then
			notify("Empty", "No favorite track selected.", "alert-circle")
			return
		end
		if item.mode == "local" then
			playFileByLabel(item.value)
		else
			playRobloxId(item.value, item.label)
		end
	end,
})

FavTab:Button({
	Title = "Remove Favorite",
	Icon = "trash",
	Callback = function()
		local target = state.selectedFavLabel
		if not target or not favMap[target] then
			return
		end
		for i, item in ipairs(favorites) do
			if item.label == target then
				table.remove(favorites, i)
				break
			end
		end
		state.selectedFavLabel = nil
		refreshFavorites()
		notify("Removed", "Removed from Favorites.", "trash")
	end,
})


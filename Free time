-- === TAB 2: EMOTES & POPULAR ANIMATIONS (75 TOTAL) ===
EmotesTab:Section({ Title = "Emote & Animation Selector (75)" })

EmotesTab:Input({
	Title = "Search Emote / Animation",
	Desc = "Filter all 75 items by name (e.g. Ninja, Levitation, Chicken, Rodeo)",
	Placeholder = "Type name to filter...",
	Callback = function(query)
		local q = tostring(query or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
		local filtered = {}
		for _, item in ipairs(AllEmotes) do
			if q == "" or item.name:lower():find(q, 1, true) then
				table.insert(filtered, item.name)
			end
		end
		if #filtered == 0 then
			table.insert(filtered, "No matching animation")
		end
		if EmoteDropdown and typeof(EmoteDropdown.Refresh) == "function" then
			pcall(EmoteDropdown.Refresh, EmoteDropdown, filtered, true)
		end
	end,
})

EmoteDropdown = EmotesTab:Dropdown({
	Title = "Select Emote / Animation",

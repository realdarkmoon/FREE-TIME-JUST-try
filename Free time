		local item = state.selectedFavLabel and favMap[state.selectedFavLabel]
		if not item then
			notify("Empty", "No favorite track selected.", "alert-circle")
			return
		end
		if item.mode == "local" then
			playFileByLabel(item.value)
		else
			playRobloxId(item.value, item.label)
		end
	end,
})

FavTab:Button({
	Title = "Remove Favorite",
	Icon = "trash",
	Callback = function()
		local target = state.selectedFavLabel
		if not target or not favMap[target] then
			return
		end
		for i, item in ipairs(favorites) do
			if item.label == target then
				table.remove(favorites, i)
				break
			end
		end
		state.selectedFavLabel = nil
		refreshFavorites()
		notify("Removed", "Removed from Favorites.", "trash")
	end,
})


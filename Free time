local function applyAtmosphereSettings(silent)
	local preset = SkyPresetByName[state.selectedSkyPreset]
	local useDefaultSky = (not state.atmosEnabled) or (preset and preset.isDefault)

	if useDefaultSky then
		local existingAtmos = Lighting:FindFirstChild(ATMOS_NAME)
		if existingAtmos then
			pcall(function()
				existingAtmos:Destroy()
			end)
		end
		restoreDefaultSky()
		pcall(function()
			Lighting.ClockTime = defaultLightingSnap.ClockTime
			Lighting.Brightness = defaultLightingSnap.Brightness
		end)
	else
		if preset then
			applyAnimeSkyTexture(preset)
		end

		local atmo = getOrCreateAtmosphere()
		pcall(function()
			atmo.Density = math.clamp(tonumber(state.atmosDensity) or 0.35, 0, 1)
			atmo.Offset = math.clamp(tonumber(state.atmosOffset) or 0.25, 0, 1)
			atmo.Glare = math.clamp(tonumber(state.atmosGlare) or 0.2, 0, 10)
			atmo.Haze = math.clamp(tonumber(state.atmosHaze) or 1.5, 0, 10)
			atmo.Color = state.atmosColor
			atmo.Decay = state.atmosDecay
		end)

		pcall(function()
			Lighting.ClockTime = math.clamp(tonumber(state.clockTime) or 21.5, 0, 24)
			Lighting.Brightness = math.clamp(tonumber(state.brightness) or 2.0, 0, 10)
		end)
	end

	applyEightKGraphics(state.eightKGraphicsEnabled)

	if not silent then
		if state.eightKGraphicsEnabled then
			notify(
				"8K Graphics",
				state.mobileSafe8K and "Mobile-safe 8K graphics enabled." or "Full 8K graphics enabled.",
				"sparkles"
			)
		elseif useDefaultSky then
			notify("Default Graphics", "Restored default sky & graphics.", "sun")
		else
			notify("Anime Sky", "Applied " .. tostring(state.selectedSkyPreset) .. ".", "cloud")
		end
	end
end

local function applySkyOrAtmospherePreset(presetName)
	local preset = SkyPresetByName[presetName]
	state.selectedSkyPreset = presetName

	if not preset or preset.isDefault then
		state.selectedSkyPreset = "Default Sky"
		applyAtmosphereSettings(false)
		return
	end

	state.atmosEnabled = true

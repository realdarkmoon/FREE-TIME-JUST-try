	end
	state.activeUGCEmoteId = nil
	if not silent then
		notify("UGC Emote Stopped", "Stopped active UGC emote.", "square")
	end
end

local function extractAnimIdFromInstance(obj)
	if not obj then
		return nil
	end
	if obj:IsA("Animation") then
		local id = tostring(obj.AnimationId or ""):match("%d+")
		if id and id ~= "0" then
			return id
		end
	end
	for _, desc in ipairs(obj:GetDescendants()) do
		if desc:IsA("Animation") then
			local id = tostring(desc.AnimationId or ""):match("%d+")
			if id and id ~= "0" then
				return id
			end
		end
	end
	return nil
end

local function resolveEmoteAnimationId(rawId, humanoid)
	local digits = tostring(rawId or ""):match("%d+")
	if not digits or digits == "0" then
		return nil
	end

	if resolvedEmoteIdCache[digits] then
		return resolvedEmoteIdCache[digits]
	end

	if humanoid then
		pcall(function()
			local desc = humanoid:FindFirstChildOfClass("HumanoidDescription") or humanoid:GetAppliedDescription()
			if desc and typeof(desc.GetEmotes) == "function" then
				local emotesDict = desc:GetEmotes()
				if type(emotesDict) == "table" then
					for _, animList in pairs(emotesDict) do
						if type(animList) == "table" and table.find(animList, tonumber(digits) or digits) then
							for _, v in ipairs(animList) do
								local found = tostring(v):match("%d+")
								if found and found ~= "0" then
									resolvedEmoteIdCache[digits] = found
									break
								end
							end
						end
					end
				end
			end
		end)
		if resolvedEmoteIdCache[digits] then
			return resolvedEmoteIdCache[digits]
		end
	end

	local okObjs, objs = pcall(function()
		return game:GetObjects("rbxassetid://" .. digits)
	end)
	if okObjs and type(objs) == "table" then
		for _, item in ipairs(objs) do
			local extracted = extractAnimIdFromInstance(item)
			pcall(function()
				item:Destroy()
			end)
			if extracted then
				resolvedEmoteIdCache[digits] = extracted
				return extracted
			end
		end
	end

	resolvedEmoteIdCache[digits] = digits
	return digits
end

local function playUGCEmote(rawId, label)
	local digits = tostring(rawId or ""):match("%d+")
	if not digits or digits == "0" then
		notify("Invalid ID", "Enter a valid numeric UGC Emote / Animation ID.", "alert-circle")
		return
	end

	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		notify("Character Missing", "Wait for your character to spawn first.", "alert-circle")
		return
	end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		notify("R15 Required", "UGC emotes require an R15 avatar rig.", "alert-triangle")
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	task.spawn(function()
		local resolvedId = resolveEmoteAnimationId(digits, humanoid) or digits
		local candidateIds = { resolvedId }
		if digits ~= resolvedId then
			table.insert(candidateIds, digits)
		end

		local loadedAnim, loadedTrack = nil, nil
		for _, tryId in ipairs(candidateIds) do
			local anim = Instance.new("Animation")
			anim.Name = "DarkMoonUGCEmote"
			anim.AnimationId = "rbxassetid://" .. tryId

			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			if ok and track then
				loadedAnim = anim
				loadedTrack = track
				break
			else
				anim:Destroy()
			end
		end

		if loadedAnim and loadedTrack then
			stopCurrentUGCEmote(true)
			currentUGCEmoteAnim = loadedAnim
			currentUGCEmoteTrack = loadedTrack
			state.activeUGCEmoteId = digits

			loadedTrack.Priority = Enum.AnimationPriority.Action4
			loadedTrack.Looped = true
			loadedTrack:Play(0.15)
			loadedTrack:AdjustSpeed(state.ugcEmoteSpeed)

			notify("Playing UGC Emote", label or ("Emote ID: " .. digits), "sparkles")
		else
			notify("Emote Error", "Could not load emote ID: " .. digits, "x-circle")
		end
	end)
end


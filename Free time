		end
	end

	if favDropdown and typeof(favDropdown.Refresh) == "function" then
		pcall(favDropdown.Refresh, favDropdown, favLabels, true)
	end
end

local function playRobloxId(raw, label)
	local digits = tostring(raw or ""):match("%d+")
	if not digits or digits == "0" then
		notify("Missing ID", "Enter a valid public Roblox Audio ID.", "alert-circle")
		return
	end
	state.sourceMode = "roblox"
	state.currentId = digits
	state.currentTitle = label or ("ID: " .. digits)
	state.mm2RadioId = digits

	Sound:Stop()
	Sound.SoundId = "rbxassetid://" .. digits
	Sound.Looped = state.loopSingle
	Sound.PlaybackSpeed = state.speed
	Sound:Play()

	updateStatus("Playing: " .. state.currentTitle)
	notify("Playing", state.currentTitle)

	if state.mm2AutoSyncPlayer then
		playSongOnMM2Radio(digits, state.currentTitle, true)
	end
end

local function playFileByLabel(lbl)
	if not canGetAsset then
		notify("Unsupported", "Executor lacks getcustomasset().", "alert-triangle")
		return
	end
	local path = lbl and fileMap[lbl]
	if not path then
		notify("No Song", "Select or add a local .mp3/.ogg file first.", "alert-circle")
		return
	end
	if canIsFile and not isfile(path) then
		notify("File Missing", "Not found: " .. path, "alert-circle")
		return
	end
	local ok, asset = pcall(getcustomasset, path)
	if ok and asset and asset ~= "" then
		state.sourceMode = "local"
		state.selectedFileLabel = lbl
		state.currentTitle = lbl

		Sound:Stop()
		Sound.SoundId = asset
		Sound.Looped = state.loopSingle
		Sound.PlaybackSpeed = state.speed
		Sound:Play()

		updateStatus("Playing Local: " .. lbl)
		notify("Playing File", lbl)
	else
		notify("Error", "Failed to load audio asset.", "x-circle")
	end
end

local function playNextTrack(step)
	step = step or 1
	if state.sourceMode == "local" and #fileLabels > 0 and fileLabels[1] ~= "No saved songs" then
		local idx = table.find(fileLabels, state.selectedFileLabel) or 1
		if state.shuffle and #fileLabels > 1 then
			idx = math.random(1, #fileLabels)
		else
			idx = ((idx - 1 + step) % #fileLabels) + 1
		end
		playFileByLabel(fileLabels[idx])
	else
		local validTracks = {}
		for _, t in ipairs(Tracks) do
			if t.id ~= "0" then
				table.insert(validTracks, t)
			end
		end
		if #validTracks == 0 then
			return
		end
		local idx = 1
		for i, t in ipairs(validTracks) do
			if t.id == state.currentId then
				idx = i
				break
			end
		end
		if state.shuffle and #validTracks > 1 then
			idx = math.random(1, #validTracks)
		else
			idx = ((idx - 1 + step) % #validTracks) + 1
		end
		playRobloxId(validTracks[idx].id, validTracks[idx].label)
	end
end

Sound.Ended:Connect(function()
	if not state.loopSingle and state.autoNext then
		playNextTrack(1)
	else
		updateStatus("Stopped / Ended: " .. state.currentTitle)
	end
end)

local function addExistingAndPlay(rawPath, customName)
	local path = resolvePath(rawPath)
	if not path then
		notify("Invalid Path", "Enter a valid file name or path.", "alert-circle")
		return
	end
	if canIsFile and not isfile(path) then
		notify("Not Found", "File does not exist: " .. path, "alert-circle")
		return
	end
	local finalPath = path
	if customName and customName:gsub("%s+", "") ~= "" and canWrite and canRead then
		local ext = path:lower():match("%.ogg") and ".ogg" or ".mp3"
		local renamed = FOLDER .. "/" .. sanitize(customName) .. ext
		if renamed ~= path then
			local rOk, rawBytes = pcall(readfile, path)
			if rOk and rawBytes and pcall(writefile, renamed, rawBytes) then
				finalPath = renamed
			end
		end
	end
	refreshFiles(finalPath)
	playFileByLabel(state.selectedFileLabel)
end

local function downloadAndPlay(url, customName)
	if not (canWrite and canGetAsset) then
		notify("Unsupported", "Executor lacks writefile/getcustomasset.", "alert-triangle")
		return
	end
	if not url or not url:match("^https?://") then
		notify("Invalid URL", "Paste a direct http/https .mp3 or .ogg link.", "alert-circle")
		return
	end
	notify("Downloading", "Fetching audio...", "loader")
	task.spawn(function()
		local bytes = fetchAudio(url)
		if not bytes then
			notify("Download Failed", "Link did not return valid MP3/OGG audio.", "x-circle")
			return
		end
		local ext = url:lower():match("%.ogg") and ".ogg" or ".mp3"
		local base = (customName and customName:gsub("%s+", "") ~= "") and sanitize(customName)
			or sanitize(url:match("([^/%?]+)%.%w+") or "Audio")
		local savePath = FOLDER .. "/" .. base .. ext
		if not pcall(writefile, savePath, bytes) then
			notify("Save Failed", "Could not save file.", "x-circle")
			return
		end
		refreshFiles(savePath)
		playFileByLabel(state.selectedFileLabel)
	end)
end

local function applyAudioPreset(preset)
	if preset == "Normal" then
		state.speed = 1.0
		Equalizer.Enabled = false
		Reverb.Enabled = false
	elseif preset == "Nightcore" then
		state.speed = 1.25
		Equalizer.Enabled = false
		Reverb.Enabled = false
	elseif preset == "Slowed + Reverb" then
		state.speed = 0.85
		Equalizer.Enabled = false
		Reverb.Enabled = true
	elseif preset == "Bass Boost" then
		state.speed = 1.0
		Equalizer.LowGain = 10
		Equalizer.MidGain = -2
		Equalizer.HighGain = 2
		Equalizer.Enabled = true
		Reverb.Enabled = false
	end
	Sound.PlaybackSpeed = state.speed
	notify("Audio FX", "Applied preset: " .. preset, "sliders")
end


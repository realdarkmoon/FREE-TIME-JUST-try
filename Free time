-- === ANTI-VOICE CHAT & ANTI-CHAT BYPASS HELPERS ===
local function isVoiceAudioObject(inst)
	if not inst or inst == Sound or inst == spatialSound then
		return false
	end
	if inst:IsA("AudioDeviceInput") or inst:IsA("AudioDeviceOutput") or inst:IsA("AudioPlayer") or inst:IsA("AudioEmitter") then
		return true
	end
	if inst:IsA("Sound") then
		local n = inst.Name:lower()
		local idStr = tostring(inst.SoundId):lower()
		if n:find("voice") or n:find("vc") or idStr:find("voice") or idStr:find("audiochat") then
			return true
		end
		if inst.Parent and (inst.Parent.Name == "VoiceChat" or inst.Parent:IsA("Head")) then
			return true
		end
	end
	return false
end

local function setVoiceStateOnObject(inst, shouldMute)
	if not isVoiceAudioObject(inst) then
		return
	end

	if inst:IsA("AudioDeviceInput") then
		if shouldMute then
			if mutedInputStates[inst] == nil then
				local okM, curM = pcall(function()
					return inst.Muted
				end)
				if okM then
					mutedInputStates[inst] = curM
				end
			end
			pcall(function()
				inst.Muted = true
			end)
		else
			local prevM = mutedInputStates[inst]
			if prevM ~= nil then
				pcall(function()
					inst.Muted = prevM
				end)
				mutedInputStates[inst] = nil
			end
		end
	end

	if shouldMute then
		if mutedVoiceObjects[inst] == nil then
			local okVol, curVol = pcall(function()
				return inst.Volume
			end)
			if okVol and type(curVol) == "number" then
				mutedVoiceObjects[inst] = curVol
			end
		end
		pcall(function()
			inst.Volume = 0
		end)
	else
		local prevVol = mutedVoiceObjects[inst]
		if prevVol ~= nil then
			pcall(function()
				inst.Volume = prevVol
			end)
			mutedVoiceObjects[inst] = nil
		end
	end
end

local function scanAndApplyVoiceMute(rootContainer, shouldMute)
	if not rootContainer then
		return
	end
	pcall(function()
		for _, desc in ipairs(rootContainer:GetDescendants()) do

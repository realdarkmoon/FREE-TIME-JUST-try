local function suppressIncomingMessage(message)
	if not message then
		return nil
	end
	if message.TextSource then
		handleIncomingTagPayload(message.TextSource.Name, message.Text)
	end
	if state.antiChatEnabled then
		local props = Instance.new("TextChatMessageProperties")
		props.Text = ""
		if typeof(props.PrefixText) == "string" then
			props.PrefixText = ""
		end
		pcall(function()
			props.Visible = false
		end)
		return props
	end
	return nil
end

local function hookTextChannel(channel)
	if not channel or not channel:IsA("TextChannel") or hookedChannels[channel] then
		return
	end
	hookedChannels[channel] = true
	pcall(function()
		channel.OnIncomingMessage = function(message)
			return suppressIncomingMessage(message)
		end
	end)
end


-- === MURDER MYSTERY 2 (MM2) RADIO HELPERS ===
local function findMM2RadioTool()
	local char = LocalPlayer and LocalPlayer.Character
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") and item.Name:lower():find("radio", 1, true) then
				return item, true
			end
		end
	end
	local backpack = LocalPlayer and LocalPlayer:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and item.Name:lower():find("radio", 1, true) then
				return item, false
			end
		end
	end
	return nil, false
end

local function findRadioRemotes()
	local remotes = {}
	local containers = { ReplicatedStorage, Workspace, LocalPlayer }
	for _, root in ipairs(containers) do
		if root then
			for _, desc in ipairs(root:GetDescendants()) do
				if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
					local lowName = desc.Name:lower()
					if lowName:find("radio", 1, true) or lowName:find("boombox", 1, true) or lowName:find("playsong", 1, true) or lowName:find("soundid", 1, true) then
						table.insert(remotes, desc)
					end
				end
			end
		end
	end
	return remotes
end

local function trySetRadioGuiBox(digits)
	local gui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not gui then
		return false
	end
	local applied = false
	for _, desc in ipairs(gui:GetDescendants()) do
		if desc:IsA("TextBox") then
			local pathStr = tostring(desc:GetFullName()):lower()
			if pathStr:find("radio", 1, true) or pathStr:find("boombox", 1, true) or pathStr:find("song", 1, true) or pathStr:find("id", 1, true) then
				pcall(function()
					desc.Text = digits
					desc:CaptureFocus()
					desc:ReleaseFocus(true)
					applied = true
				end)
			end
		end
	end
	return applied
end

local function playSongOnMM2Radio(rawId, songLabel, silent)
	local digits = tostring(rawId or ""):match("%d+")
	if not digits or digits == "0" then
		if not silent then
			notify("Invalid ID", "Enter a valid numeric Roblox Audio ID for MM2 Radio.", "alert-circle")
		end
		return false
	end

	state.mm2RadioId = digits
	state.mm2LastSentId = digits

	local radioTool, isEquipped = findMM2RadioTool()
	if radioTool and not isEquipped then
		local char = LocalPlayer and LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function()
				hum:EquipTool(radioTool)
			end)
			task.wait(0.1)
		end
	end

	local triggered = false

	if radioTool then
		for _, desc in ipairs(radioTool:GetDescendants()) do
			if desc:IsA("RemoteEvent") then
				pcall(function()
					desc:FireServer(digits)
					desc:FireServer("Play", digits)
					desc:FireServer(tonumber(digits) or digits)
					triggered = true
				end)
			elseif desc:IsA("RemoteFunction") then
				pcall(function()
					desc:InvokeServer(digits)
					desc:InvokeServer("Play", digits)
					triggered = true
				end)
			elseif desc:IsA("Sound") then
				pcall(function()
					desc.SoundId = "rbxassetid://" .. digits
					desc:Play()
					triggered = true
				end)
			end
		end
	end

	local remotes = findRadioRemotes()
	for _, rem in ipairs(remotes) do
		if rem:IsA("RemoteEvent") then
			pcall(function()
				rem:FireServer(digits)
				rem:FireServer("Play", digits)
				rem:FireServer(tonumber(digits) or digits)
				triggered = true
			end)
		elseif rem:IsA("RemoteFunction") then
			pcall(function()
				rem:InvokeServer(digits)
				rem:InvokeServer("Play", digits)
				triggered = true
			end)
		end
	end

	local guiUpdated = trySetRadioGuiBox(digits)

	if canClipboard and not silent then
		copyText(digits)
	end

	local displayName = songLabel and (songLabel .. " (" .. digits .. ")") or ("ID: " .. digits)
	local statusMsg = "Sent to MM2 Radio: " .. displayName
	if not radioTool and #remotes == 0 and not guiUpdated then
		statusMsg = "Copied ID " .. digits .. " (Equip MM2 Radio gamepass/tool to play)"
	end
	updateMM2Status(statusMsg)

	if not silent then
		if radioTool or #remotes > 0 or guiUpdated or triggered then
			notify("MM2 Radio", "Sent song ID " .. digits .. " to MM2 Radio.", "radio")
		else
			notify("MM2 Radio ID Copied", "Copied " .. digits .. ". Equip your MM2 Radio to play.", "radio")
		end
	end

	return true
end

-- === SHARED HEAD TAG PARSER (DECLARED BEFORE CHAT CONNECTIONS) ===
local applyPlayerHeadTag

local function handleIncomingTagPayload(senderName, rawText)
	if type(rawText) ~= "string" then
		return
	end
	local enabledFlag, logoStr, textStr, hexStr = rawText:match("^DMHT|([01])|([^|]+)|([^|]+)|([0-9a-fA-F]+)$")
	if not enabledFlag then
		return
	end

	local senderPlr = Players:FindFirstChild(senderName)
	if not senderPlr or senderPlr == LocalPlayer then
		return
	end

	local okColor, parsedColor = pcall(Color3.fromHex, hexStr)
	peerTagConfigs[senderPlr.UserId] = {
		enabled = (enabledFlag == "1"),
		logo = logoStr,
		text = textStr,
		accent = (okColor and parsedColor) or Color3.fromHex("E9D5FF"),
	}

	if senderPlr.Character and applyPlayerHeadTag then
		applyPlayerHeadTag(senderPlr, senderPlr.Character)
	end
end

-- === ANTI-VOICE CHAT & ANTI-CHAT HELPERS ===
local function isVoiceAudioObject(inst)
	if not inst or inst == Sound then
		return false
	end
	if inst:IsA("AudioPlayer") or inst:IsA("AudioDeviceInput") or inst:IsA("AudioDeviceOutput") or inst:IsA("AudioEmitter") then
		return true
	end
	if inst:IsA("Sound") then
		local n = inst.Name:lower()
		local idStr = tostring(inst.SoundId):lower()
		if n:find("voice") or n:find("vc") or idStr:find("voice") or idStr:find("audiochat") then
			return true
		end
		if inst.Parent and (inst.Parent.Name == "VoiceChat" or inst.Parent:IsA("Head")) then
			return true
		end
	end
	return false
end

local function setVoiceVolumeOnObject(inst, shouldMute)
	if not isVoiceAudioObject(inst) then
		return
	end
	if shouldMute then
		if mutedVoiceObjects[inst] == nil then
			local okVol, curVol = pcall(function()
				return inst.Volume
			end)
			if okVol and type(curVol) == "number" then
				mutedVoiceObjects[inst] = curVol
			end
		end
		pcall(function()
			inst.Volume = 0
		end)
	else
		local prevVol = mutedVoiceObjects[inst]
		if prevVol ~= nil then
			pcall(function()
				inst.Volume = prevVol
			end)
			mutedVoiceObjects[inst] = nil
		end
	end
end

local function scanAndApplyVoiceMute(rootContainer, shouldMute)
	if not rootContainer then
		return
	end
	for _, desc in ipairs(rootContainer:GetDescendants()) do
		setVoiceVolumeOnObject(desc, shouldMute)
	end
end

local function applyAntiVoiceChat(silent)
	local shouldMute = state.antiVoiceChat and state.muteVoiceAudioStreams

	pcall(function()
		local vcService = game:GetService("VoiceChatService")
		if vcService then
			scanAndApplyVoiceMute(vcService, shouldMute)
		end
	end)

	scanAndApplyVoiceMute(SoundService, shouldMute)
	scanAndApplyVoiceMute(Workspace, shouldMute)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			scanAndApplyVoiceMute(plr.Character, shouldMute)
		end
	end

	if not silent then
		notify(
			"Anti-Voice Chat",
			state.antiVoiceChat and "Voice chat audio muted." or "Voice chat audio unmuted.",
			state.antiVoiceChat and "mic-off" or "mic"
		)
	end
end

local function applyAntiChat(silent)
	local active = state.antiChatEnabled

	pcall(function()
		local chatWin = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
		if chatWin then
			if active and state.hideChatWindow then
				if savedChatConfigs.winVisible == nil then
					savedChatConfigs.winVisible = chatWin.Enabled
				end
				chatWin.Enabled = false
			elseif savedChatConfigs.winVisible ~= nil then
				chatWin.Enabled = savedChatConfigs.winVisible
				savedChatConfigs.winVisible = nil
			end
		end

		local chatBar = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
		if chatBar then
			if active and state.hideChatInputBar then
				if savedChatConfigs.barVisible == nil then
					savedChatConfigs.barVisible = chatBar.Enabled
				end
				chatBar.Enabled = false
			elseif savedChatConfigs.barVisible ~= nil then
				chatBar.Enabled = savedChatConfigs.barVisible
				savedChatConfigs.barVisible = nil
			end
		end

		local bubbleCfg = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
		if bubbleCfg then
			if active and state.hideBubbleChat then
				if savedChatConfigs.bubbleVisible == nil then
					savedChatConfigs.bubbleVisible = bubbleCfg.Enabled
				end
				bubbleCfg.Enabled = false
			elseif savedChatConfigs.bubbleVisible ~= nil then
				bubbleCfg.Enabled = savedChatConfigs.bubbleVisible
				savedChatConfigs.bubbleVisible = nil
			end
		end
	end)

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, not (active and state.hideChatWindow))
	end)

	local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		for _, gui in ipairs(playerGui:GetChildren()) do
			if gui:IsA("ScreenGui") and (gui.Name == "Chat" or gui.Name == "ExperienceChat") then
				if active and state.hideChatWindow then
					if savedLegacyChatStates[gui] == nil then
						savedLegacyChatStates[gui] = gui.Enabled
					end
					gui.Enabled = false
				elseif savedLegacyChatStates[gui] ~= nil then
					gui.Enabled = savedLegacyChatStates[gui]
					savedLegacyChatStates[gui] = nil
				end
			end
		end
	end

	if not silent then
		notify(
			"Anti-Chat",
			active and "Chat blocked & hidden." or "Chat restored.",
			active and "message-square-off" or "message-square"
		)
	end
end

local function hookAudioWatcher(container)

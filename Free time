	local s = ensureSpatialSound()
	if not s then
		return
	end

	s.SoundId = "rbxassetid://" .. tostring(state.currentId)
	s.Volume = math.clamp(state.volume, 0, 2)
	s.PlaybackSpeed = state.speed
	s.Looped = state.loopSingle

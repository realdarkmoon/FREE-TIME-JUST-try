-- === EMOTES HELPERS (WITH ASSET/EMOTE ID RESOLUTION) ===
local function stopCurrentEmote(silent)
	if currentEmoteTrack then
		pcall(function()
			currentEmoteTrack:Stop(0.15)
			currentEmoteTrack:Destroy()
		end)
		currentEmoteTrack = nil
	end
	if currentEmoteAnim then
		pcall(function()
			currentEmoteAnim:Destroy()
		end)
		currentEmoteAnim = nil
	end
	state.activeEmoteId = nil
	if not silent then
		notify("Emote Stopped", "Stopped active emote.", "square")
	end
end

local function extractAnimIdFromInstance(obj)
	if not obj then
		return nil
	end
	if obj:IsA("Animation") then
		local id = tostring(obj.AnimationId or ""):match("%d+")
		if id and id ~= "0" then
			return id
		end
	end
	for _, desc in ipairs(obj:GetDescendants()) do
		if desc:IsA("Animation") then
			local id = tostring(desc.AnimationId or ""):match("%d+")
			if id and id ~= "0" then
				return id
			end
		end
	end
	return nil
end

local function resolveEmoteAnimationId(rawId, humanoid)
	local digits = tostring(rawId or ""):match("%d+")
	if not digits or digits == "0" then
		return nil
	end

	if resolvedEmoteIdCache[digits] then
		return resolvedEmoteIdCache[digits]
	end

	if humanoid then
		pcall(function()
			local desc = humanoid:FindFirstChildOfClass("HumanoidDescription") or humanoid:GetAppliedDescription()
			if desc and typeof(desc.GetEmotes) == "function" then
				local emotesDict = desc:GetEmotes()
				if type(emotesDict) == "table" then
					for _, animList in pairs(emotesDict) do
						if type(animList) == "table" and table.find(animList, tonumber(digits) or digits) then
							for _, v in ipairs(animList) do
								local found = tostring(v):match("%d+")
								if found and found ~= "0" then
									resolvedEmoteIdCache[digits] = found
									break
								end
							end
						end
					end
				end
			end
		end)
		if resolvedEmoteIdCache[digits] then
			return resolvedEmoteIdCache[digits]
		end
	end

	pcall(function()
		local info = MarketplaceService:GetProductInfo(tonumber(digits) or 0)
		if type(info) == "table" and info.AssetId and tonumber(info.AssetId) then
			local assetDigits = tostring(info.AssetId):match("%d+")
			if assetDigits and assetDigits ~= "0" and assetDigits ~= digits then
				local okObjs, objs = pcall(function()
					return game:GetObjects("rbxassetid://" .. assetDigits)
				end)
				if okObjs and type(objs) == "table" then
					for _, item in ipairs(objs) do
						local extracted = extractAnimIdFromInstance(item)
						pcall(function()
							item:Destroy()
						end)
						if extracted then
							resolvedEmoteIdCache[digits] = extracted
						end
					end
				end
			end
		end
	end)
	if resolvedEmoteIdCache[digits] then
		return resolvedEmoteIdCache[digits]
	end

	local okObjs, objs = pcall(function()
		return game:GetObjects("rbxassetid://" .. digits)
	end)
	if okObjs and type(objs) == "table" then
		for _, item in ipairs(objs) do
			local extracted = extractAnimIdFromInstance(item)
			pcall(function()
				item:Destroy()
			end)
			if extracted then
				resolvedEmoteIdCache[digits] = extracted
				return extracted
			end
		end
	end

	resolvedEmoteIdCache[digits] = digits
	return digits
end

local function playEmote(rawId, label)
	local digits = tostring(rawId or ""):match("%d+")
	if not digits or digits == "0" then
		notify("Invalid ID", "Enter a valid numeric Emote / Animation ID.", "alert-circle")
		return
	end

	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		notify("Character Missing", "Wait for your character to spawn first.", "alert-circle")
		return
	end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		notify("R15 Required", "Emotes require an R15 avatar rig.", "alert-triangle")
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	task.spawn(function()
		local resolvedId = resolveEmoteAnimationId(digits, humanoid) or digits
		local candidateIds = { resolvedId }
		if digits ~= resolvedId then
			table.insert(candidateIds, digits)
		end

		local loadedAnim, loadedTrack = nil, nil
		for _, tryId in ipairs(candidateIds) do
			local anim = Instance.new("Animation")
			anim.Name = "DarkMoonEmote"
			anim.AnimationId = "rbxassetid://" .. tryId

			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			if ok and track then
				loadedAnim = anim
				loadedTrack = track
				break
			else
				anim:Destroy()
			end
		end

		if loadedAnim and loadedTrack then
			stopCurrentEmote(true)
			currentEmoteAnim = loadedAnim
			currentEmoteTrack = loadedTrack
			state.activeEmoteId = digits

			loadedTrack.Priority = Enum.AnimationPriority.Action4
			loadedTrack.Looped = true
			loadedTrack:Play(0.15)
			loadedTrack:AdjustSpeed(state.emoteSpeed)

			notify("Playing Emote", label or ("Emote ID: " .. digits), "sparkles")
		else
			notify("Emote Error", "Could not load emote ID: " .. digits, "x-circle")
		end
	end)
end

-- === ATMOSPHERE, ANIME SKY & 8K GRAPHICS HELPERS ===
local ATMOS_NAME = "DarkMoonCustomAtmosphere"
local SKY_NAME = "DarkMoonCustomSky"
local EIGHT_K_PREFIX = "DarkMoon8K_"

local function clearEightKEffects()
	for _, child in ipairs(Lighting:GetChildren()) do
		if tostring(child.Name):sub(1, #EIGHT_K_PREFIX) == EIGHT_K_PREFIX then
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

local function applyEightKGraphics(enabled)
	clearEightKEffects()

	if enabled then
		local mobileSafe = state.mobileSafe8K

		pcall(function()
			if not mobileSafe then
				Lighting.Technology = Enum.Technology.Future
			end
		end)
		pcall(function()
			Lighting.GlobalShadows = true
			Lighting.EnvironmentDiffuseScale = mobileSafe and 0.75 or 1
			Lighting.EnvironmentSpecularScale = mobileSafe and 0.75 or 1
		end)

		local bloom = Instance.new("BloomEffect")
		bloom.Name = EIGHT_K_PREFIX .. "Bloom"
		bloom.Intensity = mobileSafe and 0.28 or 0.42
		bloom.Size = mobileSafe and 16 or 24
		bloom.Threshold = 1.15
		bloom.Parent = Lighting

		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = EIGHT_K_PREFIX .. "ColorCorrection"
		cc.Brightness = 0.03
		cc.Contrast = mobileSafe and 0.10 or 0.14
		cc.Saturation = mobileSafe and 0.14 or 0.18
		cc.TintColor = Color3.fromHex("FFFDF9")
		cc.Parent = Lighting

		if not mobileSafe then
			local sunRays = Instance.new("SunRaysEffect")
			sunRays.Name = EIGHT_K_PREFIX .. "SunRays"
			sunRays.Intensity = 0.12
			sunRays.Spread = 0.65
			sunRays.Parent = Lighting

			local dof = Instance.new("DepthOfFieldEffect")
			dof.Name = EIGHT_K_PREFIX .. "DepthOfField"
			dof.FarIntensity = 0.18
			dof.FocusDistance = 42
			dof.InFocusRadius = 28
			dof.NearIntensity = 0.05
			dof.Parent = Lighting
		end
	else
		pcall(function()
			Lighting.GlobalShadows = defaultLightingSnap.GlobalShadows
			Lighting.EnvironmentDiffuseScale = defaultLightingSnap.EnvironmentDiffuseScale
			Lighting.EnvironmentSpecularScale = defaultLightingSnap.EnvironmentSpecularScale
			if defaultLightingSnap.Technology then
				Lighting.Technology = defaultLightingSnap.Technology
			end
		end)
	end
end


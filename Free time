-- === HEADLESS & KORBLOX LIMITEDS HELPERS ===
local function snapshotPartOnce(part)
	if not part or not part:IsA("BasePart") or savedLimbSnapshots[part] then
		return
	end
	savedLimbSnapshots[part] = {
		Transparency = part.Transparency,
		LocalTransparencyModifier = part.LocalTransparencyModifier,
		Color = part.Color,
		Material = part.Material,
		Size = part.Size,
		CanCollide = part.CanCollide,
	}
end

local function restorePartSnapshot(part)
	local snap = part and savedLimbSnapshots[part]
	if not snap then
		return
	end
	pcall(function()
		part.Transparency = snap.Transparency
		part.LocalTransparencyModifier = snap.LocalTransparencyModifier
		part.Color = snap.Color
		part.Material = snap.Material
		part.Size = snap.Size
		part.CanCollide = snap.CanCollide
	end)
	savedLimbSnapshots[part] = nil
end

local function setPartVisualHidden(part, hidden)
	if not part or not part:IsA("BasePart") then
		return
	end
	if hidden then
		snapshotPartOnce(part)
		pcall(function()
			part.Transparency = 1
			part.LocalTransparencyModifier = 1
			part.CanCollide = false
		end)
	else
		restorePartSnapshot(part)
	end

	for _, desc in ipairs(part:GetDescendants()) do
		if desc:IsA("Decal") or desc:IsA("Texture") then
			pcall(function()
				if hidden then
					if not desc:GetAttribute("DMOrigTrans") then
						desc:SetAttribute("DMOrigTrans", desc.Transparency)
					end
					desc.Transparency = 1
				else
					local origT = desc:GetAttribute("DMOrigTrans")
					desc.Transparency = (type(origT) == "number") and origT or 0
				end
			end)
		elseif desc:IsA("SpecialMesh") then
			pcall(function()
				if hidden then
					if not desc:GetAttribute("DMOrigScale") then
						desc:SetAttribute("DMOrigScale", desc.Scale)
					end
					desc.Scale = Vector3.new(0.001, 0.001, 0.001)
				else
					local origScale = desc:GetAttribute("DMOrigScale")
					if typeof(origScale) == "Vector3" then
						desc.Scale = origScale
					end
				end
			end)
		end
	end
end

local function setHeadAccessoriesHidden(character, hidden)
	if not character then
		return
	end
	local shouldHide = hidden and state.hideHeadAccessories
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Accessory") then
			local handle = child:FindFirstChild("Handle")
			local isHeadAcc = false
			if handle then
				for _, att in ipairs(handle:GetDescendants()) do
					if att:IsA("Attachment") and (att.Name:find("Hat") or att.Name:find("Hair") or att.Name:find("Face")) then
						isHeadAcc = true
						break
					end
				end
			end
			if isHeadAcc and handle and handle:IsA("BasePart") then
				setPartVisualHidden(handle, shouldHide)
			end
		end
	end
end

local function getKorbloxLegParts(character)
	local parts = {}
	if not character then
		return parts
	end
	local r6Leg = character:FindFirstChild("Right Leg")
	if r6Leg and r6Leg:IsA("BasePart") then
		table.insert(parts, r6Leg)
	end
	for _, name in ipairs({ "RightUpperLeg", "RightLowerLeg", "RightFoot" }) do
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			table.insert(parts, p)
		end
	end
	return parts
end

local function fireAvatarRemotesIfEnabled(modeTag)
	if not state.tryAvatarRemotes then
		return
	end
	local candidateKeys = { "morph", "avatar", "outfit", "character", "headless", "korblox", "bundle" }
	for _, root in ipairs({ ReplicatedStorage, Workspace }) do
		pcall(function()
			for _, desc in ipairs(root:GetDescendants()) do
				if desc:IsA("RemoteEvent") then
					local low = desc.Name:lower()
					for _, kw in ipairs(candidateKeys) do
						if low:find(kw, 1, true) then
							pcall(function()
								desc:FireServer(modeTag)
							end)
							pcall(function()
								desc:FireServer({
									mode = modeTag,
									headless = state.headlessEnabled,
									korblox = state.korbloxEnabled,
								})
							end)
							break
						end
					end
				end
			end
		end)
	end
end

local function applyHeadlessToCharacter(character, silent)
	if not character then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end

	setPartVisualHidden(head, state.headlessEnabled)
	setHeadAccessoriesHidden(character, state.headlessEnabled)

	if state.headlessEnabled then
		fireAvatarRemotesIfEnabled("headless")
		if not silent then
			notify("Headless Applied", "Headless applied to character.", "ghost")
		end
	elseif not silent then
		notify("Headless Removed", "Restored head visibility.", "user")
	end
end

local function applyKorbloxToCharacter(character, silent)
	if not character then
		return
	end
	local legParts = getKorbloxLegParts(character)
	if #legParts == 0 then
		return
	end

	if state.korbloxEnabled then
		for _, part in ipairs(legParts) do
			snapshotPartOnce(part)
			local snap = savedLimbSnapshots[part]
			pcall(function()
				part.Color = state.korbloxColor
				part.Material = Enum.Material.SmoothPlastic
				if state.korbloxSlimLeg and snap then
					if part.Name == "RightUpperLeg" or part.Name == "Right Leg" then
						part.Size = Vector3.new(snap.Size.X * 0.72, snap.Size.Y, snap.Size.Z * 0.72)
					elseif part.Name == "RightLowerLeg" then
						part.Size = Vector3.new(snap.Size.X * 0.52, snap.Size.Y, snap.Size.Z * 0.52)
					elseif part.Name == "RightFoot" then
						part.Size = Vector3.new(snap.Size.X * 0.65, snap.Size.Y * 0.85, snap.Size.Z * 0.8)
					end
				elseif snap then
					part.Size = snap.Size
				end
			end)
			for _, desc in ipairs(part:GetDescendants()) do
				if desc:IsA("SpecialMesh") then
					pcall(function()
						desc.VertexColor = Vector3.new(
							state.korbloxColor.R,
							state.korbloxColor.G,
							state.korbloxColor.B
						)
					end)
				end
			end
		end
		fireAvatarRemotesIfEnabled("korblox")
		if not silent then
			notify("Korblox Applied", "Korblox right leg styling applied.", "footprints")
		end
	else
		for _, part in ipairs(legParts) do
			restorePartSnapshot(part)
		end
		if not silent then
			notify("Korblox Removed", "Restored original right leg.", "user")
		end
	end
end


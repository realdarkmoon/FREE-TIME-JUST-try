-- === 10 SKYBOX PRESETS & SKY ANIMATION HELPERS ===
local SKY_NAME = "DarkMoonCustomSky"

local function removeCustomSky()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") and child.Name == SKY_NAME then
			child:Destroy()
		end
	end
end

local function ensureCustomSky()
	local sky = Lighting:FindFirstChild(SKY_NAME)
	if sky and sky:IsA("Sky") then
		return sky
	end
	removeCustomSky()
	local created = Instance.new("Sky")
	created.Name = SKY_NAME
	created.Parent = Lighting
	return created
end

local function stopSkyAnimation()
	if skyAnimConn then
		skyAnimConn:Disconnect()
		skyAnimConn = nil
	end
end

local function startSkyAnimation(animCfg, silent)
	stopSkyAnimation()
	if not state.skyAnimEnabled or not animCfg then
		if not silent then
			notify("Sky Animation", "Sky animation stopped.", "cloud-off")
		end
		return
	end

	state.selectedSkyAnimName = animCfg.name
	skyAnimElapsed = 0

	local sky = ensureCustomSky()
	sky.SkyboxBk = animCfg.texA or "rbxassetid://159454299"
	sky.SkyboxDn = animCfg.texA or "rbxassetid://159454299"
	sky.SkyboxFt = animCfg.texA or "rbxassetid://159454299"
	sky.SkyboxLf = animCfg.texA or "rbxassetid://159454299"
	sky.SkyboxRt = animCfg.texA or "rbxassetid://159454299"
	sky.SkyboxUp = animCfg.texA or "rbxassetid://159454299"
	sky.CelestialBodiesShown = true
	sky.StarCount = 3000

	skyAnimConn = RunService.Heartbeat:Connect(function(dt)
		if not state.skyAnimEnabled then
			stopSkyAnimation()
			return
		end
		local speed = math.clamp(tonumber(state.skyAnimSpeed) or 1.0, 0.1, 5.0)
		skyAnimElapsed += dt * speed

		local activeSky = ensureCustomSky()
		if animCfg.mode == "cycle" then
			local startH = animCfg.startHour or 18.0
			local endH = animCfg.endHour or 24.0
			local span = math.max(1.0, endH - startH)
			local t = (skyAnimElapsed * 0.25) % 1
			Lighting.ClockTime = (startH + (span * t)) % 24
			local useAltTex = (t > 0.5)
			local chosenTex = useAltTex and (animCfg.texB or animCfg.texA) or (animCfg.texA or "rbxassetid://159454299")
			activeSky.SkyboxBk = chosenTex
			activeSky.SkyboxDn = chosenTex
			activeSky.SkyboxFt = chosenTex
			activeSky.SkyboxLf = chosenTex
			activeSky.SkyboxRt = chosenTex
			activeSky.SkyboxUp = chosenTex
		else
			local wave = (math.sin(skyAnimElapsed * 1.4) + 1) * 0.5
			local baseH = animCfg.baseHour or 21.5
			Lighting.ClockTime = (baseH + (wave - 0.5) * 4.0) % 24
			activeSky.SunAngularSize = 10 + (wave * 10)
			activeSky.MoonAngularSize = 11 + ((1 - wave) * 8)
		end
	end)

	if not silent then
		notify("Sky Animation Active", animCfg.name, "cloud")
	end
end

local function applySkyBoxPreset(skyCfg, silent)
	if not state.skyBoxEnabled or not skyCfg then
		if not state.skyAnimEnabled then
			removeCustomSky()
			Lighting.ClockTime = defaultLightingSnap.ClockTime
		end
		if not silent then
			notify("Sky Box", "Custom skybox disabled.", "cloud-off")
		end
		return
	end

	stopSkyAnimation()
	state.skyAnimEnabled = false
	state.selectedSkyBoxName = skyCfg.name

	local sky = ensureCustomSky()
	sky.SkyboxBk = skyCfg.tex
	sky.SkyboxDn = skyCfg.tex
	sky.SkyboxFt = skyCfg.tex
	sky.SkyboxLf = skyCfg.tex
	sky.SkyboxRt = skyCfg.tex
	sky.SkyboxUp = skyCfg.tex
	sky.SunAngularSize = skyCfg.sunAngularSize or 11
	sky.MoonAngularSize = skyCfg.moonAngularSize or 14
	sky.StarCount = skyCfg.starCount or 2500
	sky.CelestialBodiesShown = (skyCfg.celestialBodiesShown ~= false)

	Lighting.ClockTime = math.clamp(tonumber(skyCfg.clockTime) or 21.5, 0, 24)

	if not silent then

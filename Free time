local function getPlayerListLabels()
	local labels = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local display = (plr.DisplayName and plr.DisplayName ~= "" and plr.DisplayName ~= plr.Name)
				and (plr.DisplayName .. " (@" .. plr.Name .. ")")
				or plr.Name
			table.insert(labels, display)
		end
	end
	table.sort(labels)
	if #labels == 0 then
		table.insert(labels, "No other players")
	end
	return labels
end

local function findTargetPlayerByLabel(label)
	if not label or label == "No other players" then
		return nil
	end
	local handleMatch = label:match("@([%w_]+)")
	local searchName = handleMatch or label
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and (plr.Name == searchName or plr.DisplayName == searchName or label:find(plr.Name, 1, true)) then
			return plr
		end
	end
	return nil
end

local function refreshTrollTargets(preferredLabel)
	table.clear(trollPlayerLabels)
	local fresh = getPlayerListLabels()
	for _, lbl in ipairs(fresh) do
		table.insert(trollPlayerLabels, lbl)
	end

	if trollPlayerLabels[1] == "No other players" then
		state.selectedTrollTarget = nil
	else
		if preferredLabel and table.find(trollPlayerLabels, preferredLabel) then
			state.selectedTrollTarget = preferredLabel
		elseif not state.selectedTrollTarget or not table.find(trollPlayerLabels, state.selectedTrollTarget) then
			state.selectedTrollTarget = trollPlayerLabels[1]
		end
	end

	if trollPlayerDropdown and typeof(trollPlayerDropdown.Refresh) == "function" then
		pcall(trollPlayerDropdown.Refresh, trollPlayerDropdown, trollPlayerLabels, true)
	end
end

local function performTrollAction(actionType)
	local targetPlr = findTargetPlayerByLabel(state.selectedTrollTarget)
	if not targetPlr then
		notify("No Target", "Select a player in the Trolling tab first.", "alert-circle")
		return
	end

	local myChar = LocalPlayer and LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local targetChar = targetPlr.Character
	local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

	if not myRoot or not myRoot:IsA("BasePart") then
		notify("Character Missing", "Wait for your character to spawn.", "alert-circle")
		return
	end

	if not targetRoot or not targetRoot:IsA("BasePart") then
		notify("Target Unavailable", targetPlr.Name .. " does not have an active character right now.", "alert-circle")
		return
	end

	local dist = math.clamp(tonumber(state.trollOffsetDistance) or 1.4, 0.8, 4.0)
	local targetPos = targetRoot.Position
	local forward = targetRoot.CFrame.LookVector
	local flatForward = Vector3.new(forward.X, 0, forward.Z)
	if flatForward.Magnitude < 0.01 then
		flatForward = Vector3.new(0, 0, -1)
	else
		flatForward = flatForward.Unit
	end

	if actionType == "kiss" then
		local kissSpot = targetPos + (flatForward * dist)
		myRoot.CFrame = CFrame.lookAt(kissSpot, Vector3.new(targetPos.X, kissSpot.Y, targetPos.Z))
		notify("Kiss", "Kissed " .. targetPlr.Name .. " 💋", "heart")
	elseif actionType == "hug" then
		local hugSpot = targetPos + (flatForward * math.max(0.95, dist * 0.85))
		myRoot.CFrame = CFrame.lookAt(hugSpot, Vector3.new(targetPos.X, hugSpot.Y, targetPos.Z))
		notify("Hug", "Hugged " .. targetPlr.Name .. " 🤗", "sparkles")
	end
end

-- === ANIMATION BUNDLE HELPERS ===
local function findAnimFolderCaseInsensitive(animateScript, targetKey)
	local lowerTarget = tostring(targetKey):lower()
	for _, child in ipairs(animateScript:GetChildren()) do
		if child:IsA("StringValue") and child.Name:lower() == lowerTarget then
			return child
		end
	end
	return nil
end

local function snapshotDefaultAnimate(animateScript)
	local snap = {}
	for _, child in ipairs(animateScript:GetChildren()) do
		if child:IsA("StringValue") then
			local anims = {}
			for _, animChild in ipairs(child:GetChildren()) do
				if animChild:IsA("Animation") then
					anims[animChild.Name] = animChild.AnimationId
				end
			end
			snap[child.Name] = anims
		end
	end
	return snap
end

local function writeBundleAnimValue(animateScript, valueName, assetIds)
	local valObj = findAnimFolderCaseInsensitive(animateScript, valueName)
	if not valObj then
		return
	end

	local animations = {}
	for _, child in ipairs(valObj:GetChildren()) do
		if child:IsA("Animation") then
			table.insert(animations, child)
		end
	end

	if #animations == 0 then
		return
	end

	local list = (type(assetIds) == "table") and assetIds or { assetIds }
	local weightIdx = 1
	for i, animObj in ipairs(animations) do
		local chosenId = list[i] or list[((i - 1) % #list) + 1]
		if chosenId and tostring(chosenId) ~= "" then
			animObj.AnimationId = "rbxassetid://" .. tostring(chosenId)
		end
		local weightObj = animObj:FindFirstChild("Weight")
		if weightObj and weightObj:IsA("NumberValue") then
			if #list > 1 then
				weightObj.Value = (weightIdx == 1) and 9 or 1
			else
				weightObj.Value = 10
			end
			weightIdx += 1
		end
	end
end

local function refreshAnimateState(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")
	if not humanoid or not animate then
		return
	end

	local wasEnabled = animate.Enabled
	animate.Enabled = false
	task.wait(0.03)
	animate.Enabled = wasEnabled or true

	pcall(function()
		local floorMat = humanoid.FloorMaterial
		if floorMat and floorMat ~= Enum.Material.Air then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)
end

local function applyAnimationBundle(bundle, silent)
	if not bundle or isApplyingBundle then
		return
	end

	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")

	if not humanoid or not animate then
		if not silent then
			notify("Character Missing", "Wait for your character and Animate script to load.", "alert-circle")
		end
		return
	end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		if not silent then
			notify("R15 Required", "Animations require an R15 avatar rig.", "alert-triangle")
		end
		return
	end

	isApplyingBundle = true

	if not originalAnimateIds then
		originalAnimateIds = snapshotDefaultAnimate(animate)
	end

	writeBundleAnimValue(animate, "idle", bundle.idle)
	writeBundleAnimValue(animate, "walk", bundle.walk)
	writeBundleAnimValue(animate, "run", bundle.run)
	writeBundleAnimValue(animate, "jump", bundle.jump)
	writeBundleAnimValue(animate, "fall", bundle.fall)
	writeBundleAnimValue(animate, "climb", bundle.climb)

	state.activeBundle = bundle
	state.selectedBundleName = bundle.name
	refreshAnimateState(character)

	isApplyingBundle = false

	if not silent then
		notify("Animation Applied", bundle.name .. " animation pack active.", "user-check")
	end
end

local function resetAnimationBundle()
	local character = LocalPlayer and LocalPlayer.Character
	local animate = character and character:FindFirstChild("Animate")

	state.activeBundle = nil

	if not animate or not originalAnimateIds then
		notify("Reset Complete", "Default movement animations restored.", "rotate-ccw")
		return
	end

	isApplyingBundle = true

	for valueName, animMap in pairs(originalAnimateIds) do
		local valObj = animate:FindFirstChild(valueName)
		if valObj and valObj:IsA("StringValue") then
			for _, animChild in ipairs(valObj:GetChildren()) do
				if animChild:IsA("Animation") and animMap[animChild.Name] then
					animChild.AnimationId = animMap[animChild.Name]
				end
			end
		end
	end

	refreshAnimateState(character)
	isApplyingBundle = false
	notify("Animation Reset", "Reverted to default animations.", "rotate-ccw")
end

local function hookPlayerCharacter(plr)
	hookAudioWatcher(plr)
	if plr.Character then
		applyPlayerHeadTag(plr, plr.Character)
		hookAudioWatcher(plr.Character)
		if plr == LocalPlayer then
			if state.headlessEnabled then
				applyHeadlessToCharacter(plr.Character, true)
			end
			if state.korbloxEnabled then
				applyKorbloxToCharacter(plr.Character, true)
			end
		end
		if state.antiVoiceChat and state.muteVoiceAudioStreams then
			scanAndApplyVoiceMute(plr.Character, true)
		end
	end
	plr.CharacterAdded:Connect(function(char)
		hookAudioWatcher(char)
		if plr == LocalPlayer then
			spatialSound = nil
			table.clear(savedLimbSnapshots)
			originalAnimateIds = nil
			isApplyingBundle = false
			currentUGCEmoteTrack = nil
			currentUGCEmoteAnim = nil
		end
		char:WaitForChild("Head", 5)
		if plr == LocalPlayer then
			char:WaitForChild("Humanoid", 5)
			char:WaitForChild("Animate", 5)
		end
		task.wait(0.35)

		applyPlayerHeadTag(plr, char)

		if state.antiVoiceChat and state.muteVoiceAudioStreams then
			scanAndApplyVoiceMute(char, true)
		end

		if plr == LocalPlayer then
			if state.persistLimitedsOnRespawn then
				if state.headlessEnabled then
					applyHeadlessToCharacter(char, true)
				end
				if state.korbloxEnabled then
					applyKorbloxToCharacter(char, true)
				end
			end
			if state.shareToOthers then
				syncSpatialSoundPlayback()
			end
			if state.bundleAutoRespawn and state.activeBundle then
				applyAnimationBundle(state.activeBundle, true)
			end
			if state.ugcEmoteAutoRespawn and state.activeUGCEmoteId then
				playUGCEmote(state.activeUGCEmoteId, state.selectedUGCEmoteName)
			else
				state.activeUGCEmoteId = nil
			end
			if state.atmosEnabled then
				applyAtmosphereSettings(true)
			end
			if state.antiChatEnabled then
				applyAntiChat(true)
			end
		end
	end)
end


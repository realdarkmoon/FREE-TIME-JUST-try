	end

	local wasEnabled = animate.Enabled
	animate.Enabled = false
	task.wait(0.03)
	animate.Enabled = wasEnabled or true

	pcall(function()
		local floorMat = humanoid.FloorMaterial
		if floorMat and floorMat ~= Enum.Material.Air then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)
end

local function applyAnimationBundle(bundle, silent)
	if not bundle or isApplyingBundle then
		return
	end

	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")

	if not humanoid or not animate then
		if not silent then
			notify("Character Missing", "Wait for your character and Animate script to load.", "alert-circle")
		end
		return
	end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		if not silent then
			notify("R15 Required", "Animations require an R15 avatar rig.", "alert-triangle")
		end
		return
	end

	isApplyingBundle = true

	local okApply, errApply = pcall(function()
		if not originalAnimateIds then
			originalAnimateIds = snapshotDefaultAnimate(animate)
		end

		writeBundleAnimValue(animate, "idle", bundle.idle)
		writeBundleAnimValue(animate, "walk", bundle.walk)
		writeBundleAnimValue(animate, "run", bundle.run)
		writeBundleAnimValue(animate, "jump", bundle.jump)
		writeBundleAnimValue(animate, "fall", bundle.fall)
		writeBundleAnimValue(animate, "climb", bundle.climb)

		state.activeBundle = bundle
		state.selectedBundleName = bundle.name
		refreshAnimateState(character)
	end)

	isApplyingBundle = false

	if not okApply then
		if not silent then
			notify("Animation Error", tostring(errApply), "x-circle")
		end
		return
	end

	if not silent then
		notify("Animation Applied", bundle.name .. " animation pack active.", "user-check")
	end
end

local function resetAnimationBundle()
	local character = LocalPlayer and LocalPlayer.Character
	local animate = character and character:FindFirstChild("Animate")

	state.activeBundle = nil

	if not animate or not originalAnimateIds then
		notify("Reset Complete", "Default movement animations restored.", "rotate-ccw")
		return
	end

	isApplyingBundle = true

	pcall(function()
		for valueName, animMap in pairs(originalAnimateIds) do
			local valObj = animate:FindFirstChild(valueName)
			if valObj and valObj:IsA("StringValue") then
				for _, animChild in ipairs(valObj:GetChildren()) do
					if animChild:IsA("Animation") and animMap[animChild.Name] then
						animChild.AnimationId = animMap[animChild.Name]
					end
				end
			end
		end

		refreshAnimateState(character)
	end)

	isApplyingBundle = false
	notify("Animation Reset", "Reverted to default animations.", "rotate-ccw")
end


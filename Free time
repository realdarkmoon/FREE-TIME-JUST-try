-- === ANIMATION BUNDLE HELPERS ===
local function snapshotDefaultAnimate(animateScript)
	local snap = {}
	for _, child in ipairs(animateScript:GetChildren()) do
		if child:IsA("StringValue") then
			local anims = {}
			for _, animChild in ipairs(child:GetChildren()) do
				if animChild:IsA("Animation") then
					anims[animChild.Name] = animChild.AnimationId
				end
			end
			snap[child.Name] = anims
		end
	end
	return snap
end

local function setAnimValue(animateScript, valueName, assetIds)
	local valObj = animateScript:FindFirstChild(valueName)
	if not valObj or not valObj:IsA("StringValue") then
		return
	end
	if type(assetIds) == "table" then
		local idx = 1
		for _, child in ipairs(valObj:GetChildren()) do
			if child:IsA("Animation") then
				local id = assetIds[idx] or assetIds[1]
				if id then
					child.AnimationId = "rbxassetid://" .. tostring(id)
				end
				idx += 1
			end
		end
	else
		for _, child in ipairs(valObj:GetChildren()) do
			if child:IsA("Animation") then
				child.AnimationId = "rbxassetid://" .. tostring(assetIds)
			end
		end
	end
end

local function refreshAnimateState(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")
	if not humanoid or not animate then
		return
	end
	animate.Disabled = true
	task.wait(0.05)
	animate.Disabled = false
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Landed)
	end)
end

local function applyAnimationBundle(bundle, silent)
	if not bundle then
		return
	end
	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")

	if not humanoid or not animate then
		if not silent then
			notify("Character Missing", "Wait for your character and Animate script to load.", "alert-circle")
		end
		return
	end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		if not silent then
			notify("R15 Required", "These 20 animation bundles are designed for R15 avatars.", "alert-triangle")
		end
		return
	end

	if not originalAnimateIds then
		originalAnimateIds = snapshotDefaultAnimate(animate)
	end

	setAnimValue(animate, "idle", bundle.idle)
	setAnimValue(animate, "walk", { bundle.walk })
	setAnimValue(animate, "run", { bundle.run })
	setAnimValue(animate, "jump", { bundle.jump })
	setAnimValue(animate, "fall", { bundle.fall })
	setAnimValue(animate, "climb", { bundle.climb })

	state.activeBundle = bundle
	state.selectedBundleName = bundle.name
	refreshAnimateState(character)

	if not silent then
		notify("Bundle Applied", bundle.name .. " animation pack active.", "user-check")
	end
end

local function resetAnimationBundle()
	local character = LocalPlayer and LocalPlayer.Character
	local animate = character and character:FindFirstChild("Animate")
	if not animate or not originalAnimateIds then
		state.activeBundle = nil
		notify("Reset Complete", "Default movement animations restored.", "rotate-ccw")
		return
	end

	for valueName, animMap in pairs(originalAnimateIds) do
		local valObj = animate:FindFirstChild(valueName)
		if valObj and valObj:IsA("StringValue") then
			for _, animChild in ipairs(valObj:GetChildren()) do
				if animChild:IsA("Animation") and animMap[animChild.Name] then
					animChild.AnimationId = animMap[animChild.Name]
				end
			end
		end
	end

	state.activeBundle = nil
	refreshAnimateState(character)
	notify("Bundle Reset", "Reverted to default animations.", "rotate-ccw")
end

-- === EMOTE HELPERS ===
local function stopCurrentEmote(silent)
	if currentAnimTrack then
		pcall(function()
			currentAnimTrack:Stop(0.15)
			currentAnimTrack:Destroy()
		end)
		currentAnimTrack = nil
	end
	if currentAnimInstance then
		pcall(function()
			currentAnimInstance:Destroy()
		end)
		currentAnimInstance = nil
	end
	state.activeEmoteId = nil
	if not silent then
		notify("Emote Stopped", "Stopped active emote.", "square")
	end
end

local function playEmote(rawId, label)
	local digits = tostring(rawId or ""):match("%d+")
	if not digits or digits == "0" then
		notify("Set Emote ID", "Enter a valid numeric Animation ID for this emote.", "alert-circle")
		return
	end

	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		notify("Character Missing", "Wait for your character to spawn first.", "alert-circle")
		return
	end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		notify("R15 Required", "Emotes require an R15 avatar rig.", "alert-triangle")
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	stopCurrentEmote(true)

	local anim = Instance.new("Animation")
	anim.Name = "DarkMoonCustomEmote"
	anim.AnimationId = "rbxassetid://" .. digits

	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)

	if ok and track then
		currentAnimInstance = anim
		currentAnimTrack = track
		state.activeEmoteId = digits

		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		track:Play(0.15)
		track:AdjustSpeed(state.emoteSpeed)

		notify("Playing Emote", label or ("Emote ID: " .. digits), "sparkles")
	else
		anim:Destroy()
		notify("Emote Error", "Could not load animation ID: " .. digits, "x-circle")
	end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	currentAnimTrack = nil

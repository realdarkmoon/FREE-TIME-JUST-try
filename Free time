-- === SPATIAL CHARACTER SOUND & REMOTE AUDIO TRIGGER ===
local function getCharacterAudioAnchor()
	local char = LocalPlayer and LocalPlayer.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function ensureSpatialSound()
	local anchor = getCharacterAudioAnchor()
	if not anchor then
		return nil
	end
	if spatialSound and spatialSound.Parent ~= anchor then
		pcall(function()
			spatialSound:Destroy()
		end)
		spatialSound = nil
	end
	if not spatialSound then
		spatialSound = Instance.new("Sound")
		spatialSound.Name = "DarkMoonSpatialEmitter"
		spatialSound.RollOffMode = Enum.RollOffMode.Linear
		spatialSound.RollOffMinDistance = 10
		spatialSound.RollOffMaxDistance = state.shareRange
		spatialSound.Parent = anchor
	end
	spatialSound.RollOffMaxDistance = state.shareRange
	return spatialSound
end

local function fireGameAudioRemotes(digits)
	local assetId = "rbxassetid://" .. tostring(digits)
	local numericId = tonumber(digits) or digits
	local candidateNames = {
		"playsong", "playmusic", "playsound", "setmusic", "setsong",
		"equipradio", "radioremote", "boombox", "playaudio", "soundevent"
	}

	local containers = { ReplicatedStorage, Workspace }
	for _, container in ipairs(containers) do
		pcall(function()
			for _, desc in ipairs(container:GetDescendants()) do
				if desc:IsA("RemoteEvent") then
					local low = desc.Name:lower()
					for _, key in ipairs(candidateNames) do
						if low:find(key, 1, true) then
							pcall(function()
								desc:FireServer(assetId)
							end)
							pcall(function()
								desc:FireServer(numericId)
							end)
							break
						end
					end
				end
			end
		end)
	end
end


-- === FILE & MUSIC HELPERS ===
local function sanitize(str)
	local s = tostring(str or "Track"):gsub("[^%w%-%_]", "_"):gsub("_+", "_"):gsub("^_+", ""):gsub("_+$", "")
	return (#s > 0 and s:sub(1, 40)) or ("Track_" .. tostring(math.random(1000, 9999)))
end

local function resolvePath(raw)
	local p = tostring(raw or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("\\", "/")
	if p == "" then
		return nil
	end
	if not p:find("/") and canIsFile and isfile(FOLDER .. "/" .. p) then
		return FOLDER .. "/" .. p
	end
	return p
end

local function isAudio(data)
	if type(data) ~= "string" or #data < 2048 then
		return false
	end
	local head = data:sub(1, 32):lower()
	if head:find("<!doctype") or head:find("<html") or head:find("{") then
		return false
	end
	if data:sub(1, 4) == "OggS" or data:sub(1, 3) == "ID3" then
		return true
	end
	local b1, b2 = data:byte(1, 2)
	return b1 == 0xFF and b2 ~= nil and b2 >= 0xE0
end

local function fetchAudio(url)
	local req = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (syn and typeof(syn.request) == "function" and syn.request)

	if req then
		local ok, res = pcall(req, {
			Url = url,
			Method = "GET",
			Headers = {
				["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
				["Accept"] = "*/*",
			},
		})
		if ok and type(res) == "table" and res.Success and isAudio(res.Body) then
			return res.Body
		end
	end

	local ok, body = pcall(game.HttpGet, game, url)
	if ok and isAudio(body) then
		return body
	end
	return nil
end

local function refreshFiles(preferredPath)
	table.clear(fileLabels)
	table.clear(fileMap)

	local seen = {}
	if canListFiles then
		local ok, list = pcall(listfiles, FOLDER)
		if ok and type(list) == "table" then
			for _, f in ipairs(list) do
				local norm = tostring(f):gsub("\\", "/")
				local low = norm:lower()
				if low:match("%.mp3$") or low:match("%.ogg$") then
					seen[norm] = true
				end
			end
		end
	end

	if preferredPath and preferredPath ~= "" then
		seen[preferredPath] = true
	end

	for path in pairs(seen) do
		local name = path:match("[^/]+$") or path
		local lbl = fileMap[name] and path or name
		fileMap[lbl] = path
		table.insert(fileLabels, lbl)
	end

	table.sort(fileLabels)

	if #fileLabels == 0 then
		table.insert(fileLabels, "No saved songs")
		state.selectedFileLabel = nil
	else
		if preferredPath then
			for lbl, p in pairs(fileMap) do
				if p == preferredPath then
					state.selectedFileLabel = lbl
					break
				end
			end
		end
		if not state.selectedFileLabel or not fileMap[state.selectedFileLabel] then
			state.selectedFileLabel = fileLabels[1]
		end
	end

	if fileDropdown and typeof(fileDropdown.Refresh) == "function" then
		pcall(fileDropdown.Refresh, fileDropdown, fileLabels, true)
	end
end

local function refreshFavorites()
	table.clear(favLabels)

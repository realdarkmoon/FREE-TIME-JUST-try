local function hasWallAhead(origin, dir, distance)
	local offsets = { -1.35, 0.0, 1.35 }
	for _, yOff in ipairs(offsets) do
		local ray = Workspace:Raycast(origin + Vector3.new(0, yOff, 0), dir * distance, sharedRayParams)
		if ray and ray.Instance and ray.Instance:IsA("BasePart") and ray.Instance.CanCollide then
			return true
		end
	end
	return false
end

local function isCharacterInsideSolid(origin)
	local parts = Workspace:GetPartBoundsInRadius(origin, 1.35, sharedOverlapParams)
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.98 then
			return true
		end
	end
	return false
end

local function getBetaSlideVector(rootPos, flatDir, stepDist)
	local testPos = rootPos + (flatDir * stepDist)
	if isPositionClear(testPos) then
		return flatDir
	end

	if State.NoclipBetaUltra then
		local angles = {
			math.rad(20), math.rad(-20),
			math.rad(40), math.rad(-40),
			math.rad(65), math.rad(-65)
		}
		for _, angle in ipairs(angles) do
			local rotated = (CFrame.Angles(0, angle, 0) * flatDir)
			local candidate = rootPos + (rotated * stepDist)
			if isPositionClear(candidate) then
				return rotated.Unit
			end
		end
	end

	return flatDir
end

local function applyStrongNoclipFrame()
	if not State.Noclip or State.Unloaded then return end
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char then return end

	if hum and hum.Sit then
		hum.Sit = false
	end

	for i = #Cached.Parts, 1, -1 do
		local part = Cached.Parts[i]
		if part and part.Parent then
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
		else
			table.remove(Cached.Parts, i)
		end
	end

	for i = #Cached.Seats, 1, -1 do
		local seat = Cached.Seats[i]
		if seat and seat.Parent then
			seat.Disabled = true
		else
			table.remove(Cached.Seats, i)
		end
	end

	if State.WallMicroStep and hum and root and hum.MoveDirection.Magnitude > 0.06 then
		local now = os.clock()
		local probeInterval = State.NoclipBetaUltra and 0.016 or 0.025
		if (now - State.LastWallProbeTime) >= probeInterval then
			State.LastWallProbeTime = now
			local flatDir = getMoveDirectionFlat()
			local checkDist = State.NoclipBetaUltra and 3.1 or 2.5
			local wallDetected = hasWallAhead(root.Position, flatDir, checkDist)
			local insideWall = State.NoclipPhaseBoost and isCharacterInsideSolid(root.Position)

			if wallDetected or insideWall then
				local stepScale = insideWall and (State.NoclipStepPower * 1.25) or State.NoclipStepPower
				local pushDir = insideWall and flatDir or getBetaSlideVector(root.Position, flatDir, stepScale)
				markMovementIntent(0.35)

				local destCF = root.CFrame + (pushDir * stepScale)
				root.CFrame = destCF
				if not State.UnderMap then
					State.LastCleanCFrame = destCF
				end

				local v = root.AssemblyLinearVelocity
				if isValidVector3(v) then
					local boostXY = State.NoclipBetaUltra and 22 or 18
					root.AssemblyLinearVelocity = Vector3.new(pushDir.X * boostXY, math.max(v.Y, 0), pushDir.Z * boostXY)
				end
			end
		end
	end
end

local function restoreNoclipProps()
	for part, props in pairs(Cached.OrigProps) do
		if part and part.Parent and part:IsA("BasePart") then
			part.CanCollide = props.CanCollide
			part.CanTouch = props.CanTouch
			part.CanQuery = props.CanQuery
		end
	end
	table.clear(Cached.OrigProps)
end

local function setNoclip(enabled)
	State.Noclip = enabled
	disconnectList(noclipConnections)

	if charDescendantConn then
		charDescendantConn:Disconnect()
		charDescendantConn = nil
	end

	if enabled and not State.Unloaded then
		if Cached.Char then
			charDescendantConn = Cached.Char.DescendantAdded:Connect(registerDescendant)
		end
		applyStrongNoclipFrame()

		if RunService.PreSimulation then
			table.insert(noclipConnections, RunService.PreSimulation:Connect(applyStrongNoclipFrame))
		end
		table.insert(noclipConnections, RunService.Stepped:Connect(applyStrongNoclipFrame))
		table.insert(noclipConnections, RunService.Heartbeat:Connect(applyStrongNoclipFrame))
	else
		restoreNoclipProps()
	end
end

local function executeHardWallBypass(forceScan)
	local char = Cached.Char
	local root = Cached.Root
	if not char or not root then return false end

	local flatDir = getMoveDirectionFlat()
	if not forceScan and not hasWallAhead(root.Position, flatDir, 4.2) then
		return false
	end

	local maxDist = math.max(5, State.BypassScanDistance)
	local chosenPos = nil

	for dist = 2, maxDist do
		local probePos = root.Position + (flatDir * dist)
		if not hasWallAhead(probePos, flatDir, 1.0) and isPositionClear(probePos) then
			local floorHit = Workspace:Raycast(probePos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), sharedRayParams)
			if floorHit then
				local groundedPos = Vector3.new(probePos.X, floorHit.Position.Y + 3.0, probePos.Z)
				if isPositionClear(groundedPos) then
					chosenPos = groundedPos
					break
				end
			else
				chosenPos = probePos
				break
			end
		end
	end

	if not chosenPos then
		chosenPos = root.Position + (flatDir * math.min(maxDist, 14))
	end

	markMovementIntent(0.55)
	local curY = isValidVector3(root.AssemblyLinearVelocity) and math.max(root.AssemblyLinearVelocity.Y, 0) or 0
	root.AssemblyLinearVelocity = Vector3.new(0, curY, 0)
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.new(chosenPos, chosenPos + flatDir)
	State.LastCleanCFrame = root.CFrame
	State.LastBypassTime = os.clock()
	return true
end


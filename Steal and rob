	Desc = "Adjust character jump height/power",
	Default = false,
	Callback = function(value)
		applyJumpBoost(value)
		markFeatureUsed()
	end
})

UIRefs.JumpHeight = MovementTab:Slider({
	Title = "Jump Boost Amount",
	Desc = "Jump height (or scaled JumpPower)",
	Step = 1,
	Value = {
		Min = 8,
		Max = 50,
		Default = 14
	},
	Callback = function(value)
		State.JumpHeight = value
		State.JumpPower = value * 5
		if State.JumpEnabled then
			applyJumpBoost(true)
		end
		markFeatureUsed()
	end
})


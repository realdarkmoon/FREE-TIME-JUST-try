local lootKeywords = { "vault", "diamond", "loot", "cash", "money", "safe", "gold", "gem", "emerald", "ruby" }

local function classifyLootOrVault(textStr)
	if typeof(textStr) ~= "string" or textStr == "" then
		return false, false
	end
	local lower = textStr:lower()
	for _, kw in ipairs(lootKeywords) do
		if lower:find(kw, 1, true) then
			local isVault = (kw == "vault" or kw == "safe")
			return true, isVault
		end
	end
	return false, false
end

local function getInstanceWorldPosition(obj)
	if not obj or not obj.Parent then return nil end
	if obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") then
		if obj.PrimaryPart and obj.PrimaryPart:IsA("BasePart") then
			return obj.PrimaryPart.Position
		end
		local part = obj:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return part.Position
		end
		local ok, cf = pcall(function()
			return obj:GetPivot()
		end)
		if ok and typeof(cf) == "CFrame" and isValidVector3(cf.Position) then
			return cf.Position
		end
	elseif obj:IsA("GuiObject") or obj:IsA("TextLabel") then
		local ancestor = obj:FindFirstAncestorWhichIsA("BasePart") or obj:FindFirstAncestorWhichIsA("Model")
		if ancestor then
			return getInstanceWorldPosition(ancestor)
		end
	end
	return nil
end

local function createLogoBadge(isVault)
	local accent = isVault and Color3.fromRGB(255, 200, 65) or Color3.fromRGB(80, 225, 255)
	local logoOuter = createBox(accent, 2, false)
	local logoInner = createBox(accent, 1.5, true)
	if logoOuter then
		pcall(function() logoOuter.Rotation = 45 end)
	end
	if logoInner then
		pcall(function() logoInner.Rotation = 45 end)
	end
	local dot = createBox(accent, 1.5, false)
	local label = createLabel(accent, 14)
	return logoOuter, logoInner, dot, label
end

local function scanLootAndVaults()
	clearLootMarkers()
	local seenPositions = {}
	local count = 0

	for _, desc in ipairs(Workspace:GetDescendants()) do
		if count >= 24 then break end
		if desc and desc.Name then
			local matched, isVault = classifyLootOrVault(desc.Name)
			local displayName = desc.Name

			if not matched and desc:IsA("TextLabel") and desc.Text ~= "" then
				matched, isVault = classifyLootOrVault(desc.Text)
				if matched then
					displayName = desc.Text
				end
			end

			if matched then
				local worldPos = getInstanceWorldPosition(desc)
				if isValidVector3(worldPos) then
					local duplicate = false
					for _, prevPos in ipairs(seenPositions) do
						if (prevPos - worldPos).Magnitude < 2.0 then
							duplicate = true
							break
						end
					end

					if not duplicate then
						table.insert(seenPositions, worldPos)
						count += 1
						local logoOuter, logoInner, dot, label = createLogoBadge(isVault)
						table.insert(lootMarkers, {
							Pos = worldPos,
							Name = displayName,
							IsVault = isVault,
							LogoOuter = logoOuter,
							LogoInner = logoInner,
							Dot = dot,
							Label = label
						})
					end
				end
			end
		end
	end
end


-- ==========================================
-- BOX ESP & LOOT / VAULT ESP (DRAWING API)
-- ==========================================
local espBoxes = {}
local lootEntries = {}
local drawingAvailable = (typeof(Drawing) == "table" and typeof(Drawing.new) == "function")

local function createDrawingObj(objType, props)
	if not drawingAvailable then return nil end
	local ok, obj = pcall(function()
		local d = Drawing.new(objType)
		for k, v in pairs(props) do
			d[k] = v
		end
		return d
	end)
	return ok and obj or nil
end

local function safeRemoveDrawing(d)
	if d then
		pcall(function()
			d:Remove()
		end)
	end
end

local function createBox()
	return createDrawingObj("Square", {
		Visible = false,
		Color = Color3.fromRGB(255, 85, 85),
		Thickness = 1.5,
		Filled = false,
		Transparency = 1
	})
end

local function hideAllBoxes()
	for _, box in pairs(espBoxes) do
		if box then
			pcall(function() box.Visible = false end)
		end
	end
end

local function hideAllLootESP()
	for _, entry in ipairs(lootEntries) do
		if entry.box then pcall(function() entry.box.Visible = false end) end
		if entry.label then pcall(function() entry.label.Visible = false end) end
	end
end

local function clearLootEntries()
	for i = #lootEntries, 1, -1 do
		local entry = lootEntries[i]
		safeRemoveDrawing(entry.box)
		safeRemoveDrawing(entry.label)
		table.remove(lootEntries, i)
	end
end

local function rescanLootAndVaults()
	clearLootEntries()
	if not State.LootVaultESP or State.Unloaded then return end

	local seenAnchors = {}
	local candidates = {}

	for _, desc in ipairs(Workspace:GetDescendants()) do
		if #candidates >= 80 then break end
		if desc:IsA("Model") or desc:IsA("BasePart") or desc:IsA("BillboardGui") then
			local score, labelText = scoreLootCandidate(desc)
			local anchor = resolveAnchorInstance(desc)
			if score > 0 and anchor and not seenAnchors[anchor] then
				local pos = getTargetWorldPosition(anchor)
				if pos and isValidVector3(pos) then
					seenAnchors[anchor] = true
					table.insert(candidates, {
						anchor = anchor,
						score = score,
						labelText = labelText or anchor.Name
					})
				end
			end
		end
	end

	table.sort(candidates, function(a, b)
		return a.score > b.score
	end)

	local maxEntries = math.min(#candidates, 40)
	for i = 1, maxEntries do
		local c = candidates[i]
		local box = createDrawingObj("Square", {
			Visible = false,
			Color = Color3.fromRGB(80, 220, 255),
			Thickness = 1.4,
			Filled = false,
			Transparency = 1
		})
		local label = createDrawingObj("Text", {
			Visible = false,
			Color = Color3.fromRGB(165, 240, 255),
			Size = 13,
			Center = true,
			Outline = true,
			Text = c.labelText
		})
		table.insert(lootEntries, {
			target = c.anchor,
			baseText = c.labelText,
			box = box,
			label = label
		})
	end
end

local function removePlayerESP(player)
	local box = espBoxes[player]
	if box then
		safeRemoveDrawing(box)
		espBoxes[player] = nil
	end
end

local function updateESPFrame()
	if State.Unloaded or not drawingAvailable then
		hideAllBoxes()
		hideAllLootESP()
		return
	end

	local activeCam = Workspace.CurrentCamera
	if not activeCam then
		hideAllBoxes()
		hideAllLootESP()
		return
	end

	if not State.BoxESP then
		hideAllBoxes()
	else
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local char = player.Character
				local root = char and (
					char:FindFirstChild("HumanoidRootPart")
					or char:FindFirstChild("Torso")
					or char:FindFirstChild("UpperTorso")
				)
				local humanoid = char and char:FindFirstChildOfClass("Humanoid")

				if root and humanoid and humanoid.Health > 0 then
					local box = espBoxes[player]
					if not box then
						box = createBox()
						espBoxes[player] = box
					end

					if box then
						local rootPos, onScreen = activeCam:WorldToViewportPoint(root.Position)
						if onScreen and rootPos.Z > 0 then
							local topPos = activeCam:WorldToViewportPoint((root.CFrame * CFrame.new(0, 2.6, 0)).Position)
							local bottomPos = activeCam:WorldToViewportPoint((root.CFrame * CFrame.new(0, -3.1, 0)).Position)

							local height = math.abs(topPos.Y - bottomPos.Y)
							local width = math.clamp(height * 0.6, 12, 250)

							box.Size = Vector2.new(width, math.clamp(height, 18, 400))
							box.Position = Vector2.new(rootPos.X - box.Size.X / 2, topPos.Y)
							box.Visible = true
						else
							box.Visible = false
						end
					end
				elseif espBoxes[player] then
					pcall(function() espBoxes[player].Visible = false end)
				end
			end
		end
	end

	if not State.LootVaultESP then
		hideAllLootESP()
	else
		local now = os.clock()
		if (now - State.LastLootScanTime) >= 4.0 then
			State.LastLootScanTime = now
			rescanLootAndVaults()
		end

		local myRoot = Cached.Root
		for _, entry in ipairs(lootEntries) do
			local pos = getTargetWorldPosition(entry.target)
			if pos and entry.box and entry.label then
				local screenPos, onScreen = activeCam:WorldToViewportPoint(pos)
				if onScreen and screenPos.Z > 0 then
					local scale = math.clamp(220 / math.max(screenPos.Z, 1), 12, 48)
					entry.box.Size = Vector2.new(scale, scale)
					entry.box.Position = Vector2.new(screenPos.X - scale / 2, screenPos.Y - scale / 2)
					entry.box.Visible = true

					local distText = ""
					if myRoot then
						distText = string.format(" [%dm]", math.floor((pos - myRoot.Position).Magnitude))
					end
					entry.label.Text = entry.baseText .. distText
					entry.label.Position = Vector2.new(screenPos.X, screenPos.Y - scale / 2 - 16)
					entry.label.Visible = true
				else
					entry.box.Visible = false
					entry.label.Visible = false
				end
			else
				if entry.box then pcall(function() entry.box.Visible = false end) end
				if entry.label then pcall(function() entry.label.Visible = false end) end
			end
		end
	end
end


local function persistSaveNow()
	if State.Unloaded or State.LoadingSaved then return end
	if not State.AutoSaveEnabled or not hasFileIO() then return end

	local okEncoded, encoded = pcall(function()
		return HttpService:JSONEncode(buildSavePayload())
	end)
	if okEncoded and typeof(encoded) == "string" then
		pcall(function()
			writefile(SAVE_FILE_NAME, encoded)
		end)
	end
end

local function markFeatureUsed()
	if State.Unloaded or State.LoadingSaved or not State.AutoSaveEnabled then return end
	State.LastAutoSaveTime = os.clock()
	persistSaveNow()
end

local function loadSavedData()
	if not hasFileIO() then
		return nil, true
	end

	local exists = true
	if typeof(isfile) == "function" then
		local okExists, isFile = pcall(function()
			return isfile(SAVE_FILE_NAME)
		end)
		if okExists then
			exists = isFile
		end
	end

	if not exists then
		return nil, true
	end

	local okRead, raw = pcall(function()
		return readfile(SAVE_FILE_NAME)
	end)
	if not okRead or typeof(raw) ~= "string" or raw == "" then
		return nil, true
	end

	local okDecode, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not okDecode or typeof(decoded) ~= "table" then
		return nil, true
	end

	local shouldShowChangelog = (decoded.LastSeenVersion ~= SCRIPT_VERSION)
	return decoded, shouldShowChangelog
end


local function scoreServerCandidate(srv)
	local playing = tonumber(srv.playing) or 0
	local maxPlayers = math.max(1, tonumber(srv.maxPlayers) or 12)
	local ping = tonumber(srv.ping) or 160
	local fps = tonumber(srv.fps) or 55

	local pingScore = math.max(0, 300 - ping) * 2.2
	local fpsScore = math.clamp(fps, 10, 60) * 3.0
	local freeSlots = math.max(0, maxPlayers - playing)
	local ratio = playing / maxPlayers
	local popScore = (ratio >= 0.2 and ratio <= 0.75) and 65 or (freeSlots * 4)

	return pingScore + fpsScore + popScore
end

local function fetchBestServers(placeId)
	local ranked = {}
	local cursor = ""

	for _ = 1, 4 do
		local url = string.format(
			"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
			placeId,
			cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or ""
		)

		local okGet, raw = pcall(function()
			return game:HttpGet(url)
		end)
		if not okGet or typeof(raw) ~= "string" or raw == "" then
			break
		end

		local okDecode, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not okDecode or typeof(decoded) ~= "table" or typeof(decoded.data) ~= "table" then
			break
		end

		for _, srv in ipairs(decoded.data) do
			if typeof(srv) == "table" and typeof(srv.id) == "string" and srv.id ~= "" then
				local playing = tonumber(srv.playing) or 0
				local maxPlayers = tonumber(srv.maxPlayers) or 0
				if srv.id ~= game.JobId and not VisitedServers[srv.id] and playing >= 1 and (maxPlayers <= 0 or playing < maxPlayers) then
					table.insert(ranked, {
						id = srv.id,
						score = scoreServerCandidate(srv)
					})
				end
			end
		end

		if typeof(decoded.nextPageCursor) == "string" and decoded.nextPageCursor ~= "" then
			cursor = decoded.nextPageCursor
		else
			break
		end
	end

	table.sort(ranked, function(a, b)
		return a.score > b.score
	end)

	return ranked
end

local function joinBestServer()
	if State.Unloaded or State.ServerHopBusy then return end
	local now = os.clock()
	if (now - State.LastServerHopAttempt) < 2.5 then return end
	State.LastServerHopAttempt = now

	local placeId = game.PlaceId
	if not placeId or placeId <= 0 then return end

	State.ServerHopBusy = true
	persistSaveNow()
	armAutoExecuteForTeleport()

	task.spawn(function()
		local candidates = fetchBestServers(placeId)
		local attempts = math.min(#candidates, 5)

		for i = 1, attempts do
			if State.Unloaded then break end
			local jobId = candidates[i].id
			VisitedServers[jobId] = true
			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
			end)
			if ok then
				task.wait(2.5)
			end
		end

		if not State.Unloaded then
			pcall(function()
				TeleportService:Teleport(placeId, LocalPlayer)
			end)
		end

		task.wait(2.0)
		State.ServerHopBusy = false
	end)
end


-- ==========================================
-- APPLY SAVED FEATURES, AUTO-EXEC & CHANGELOG
-- ==========================================
do
	local savedData, shouldShowChangelog = loadSavedData()
	State.LoadingSaved = true

	if typeof(savedData) == "table" then
		if typeof(savedData.AutoSaveEnabled) == "boolean" then
			State.AutoSaveEnabled = savedData.AutoSaveEnabled
			if UIRefs.AutoSaveEnabled and UIRefs.AutoSaveEnabled.Set then
				pcall(function()
					UIRefs.AutoSaveEnabled:Set(State.AutoSaveEnabled)
				end)
			end
		end

		if typeof(savedData.AutoExecuteEnabled) == "boolean" then
			State.AutoExecuteEnabled = savedData.AutoExecuteEnabled
			if UIRefs.AutoExecuteEnabled and UIRefs.AutoExecuteEnabled.Set then
				pcall(function()
					UIRefs.AutoExecuteEnabled:Set(State.AutoExecuteEnabled)
				end)
			end
		end

		if typeof(savedData.Features) == "table" then
			for key, val in pairs(savedData.Features) do
				local ctrl = UIRefs[key]
				if ctrl and ctrl.Set and val ~= nil then
					pcall(function()
						ctrl:Set(val)
					end)
				end
			end
		end
	end

	State.LoadingSaved = false

	if State.AutoExecuteEnabled then
		armAutoExecuteForTeleport()
	end

	if shouldShowChangelog then
		task.defer(function()
			showChangelogScreen()
		end)
	end
end

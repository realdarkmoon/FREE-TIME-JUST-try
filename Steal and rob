local sharedRayParams = RaycastParams.new()
sharedRayParams.FilterType = Enum.RaycastFilterType.Exclude

local sharedOverlapParams = OverlapParams.new()
sharedOverlapParams.FilterType = Enum.RaycastFilterType.Exclude

local SHIELD_KEYWORDS = {
	"shield",
	"barrier",
	"forcefield",
	"dome",
	"wallfield",
	"energywall",
	"laserwall",
	"safezone",
	"border",
	"hitbox",
	"guard",
	"block",
	"repel",
	"field"
}

local function markMovementIntent(duration)
	State.IgnoreUnusualUntil = math.max(State.IgnoreUnusualUntil, os.clock() + (duration or 0.45))
end

local function isValidVector3(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
end

local function isSafeVelocity(vel)
	return isValidVector3(vel) and vel.Magnitude <= State.MaxSafeVelocity
end

local function disconnectList(list)
	for _, conn in ipairs(list) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(list)
end

local function matchesShieldKeyword(name)
	if type(name) ~= "string" or name == "" then return false end
	local lower = name:lower()
	for _, kw in ipairs(SHIELD_KEYWORDS) do
		if lower:find(kw, 1, true) then
			return true
		end
	end
	return false
end

local function hasShieldTagOrAttribute(inst)
	if not inst then return false end

	local okTag, tags = pcall(function()
		return inst:GetTags()
	end)
	if okTag and type(tags) == "table" then
		for _, tag in ipairs(tags) do
			if matchesShieldKeyword(tostring(tag)) then
				return true
			end
		end
	end

	local okAttr, attrs = pcall(function()
		return inst:GetAttributes()
	end)
	if okAttr and type(attrs) == "table" then
		for k, v in pairs(attrs) do
			if matchesShieldKeyword(tostring(k)) or (type(v) == "string" and matchesShieldKeyword(v)) then
				return true
			end
		end
	end

	return false
end

local function isShieldOrBarrierInstance(inst)
	if not inst then return false end
	if Cached.Char and inst:IsDescendantOf(Cached.Char) then
		return false
	end

	if inst:IsA("ForceField") then
		return true
	end

	if inst:IsA("BasePart") then
		if matchesShieldKeyword(inst.Name) or hasShieldTagOrAttribute(inst) then
			return true
		end
		if inst.Material == Enum.Material.ForceField then
			return true
		end

		local ancestor = inst.Parent
		local depth = 0
		while ancestor and ancestor ~= Workspace and depth < 5 do
			if matchesShieldKeyword(ancestor.Name) or hasShieldTagOrAttribute(ancestor) then
				return true
			end
			ancestor = ancestor.Parent
			depth += 1
		end
	end

	return false
end

local function rebuildCharacterCache(char)
	table.clear(Cached.Parts)
	table.clear(Cached.Seats)

	Cached.Char = char
	Cached.Hum = char and char:FindFirstChildOfClass("Humanoid") or nil
	Cached.Root = char and (
		char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
	) or nil

	sharedRayParams.FilterDescendantsInstances = char and { char } or {}
	sharedOverlapParams.FilterDescendantsInstances = char and { char } or {}

	if not char then return end

	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") then
			table.insert(Cached.Parts, desc)
			if Cached.OrigCollide[desc] == nil then
				Cached.OrigCollide[desc] = desc.CanCollide
			end
		elseif desc:IsA("Seat") or desc:IsA("VehicleSeat") then
			table.insert(Cached.Seats, desc)
		end
	end
end

local function registerDescendant(desc)
	if desc:IsA("BasePart") then
		table.insert(Cached.Parts, desc)
		if Cached.OrigCollide[desc] == nil then
			Cached.OrigCollide[desc] = desc.CanCollide
		end
		if State.Noclip and not State.Unloaded then
			desc.CanCollide = false
			desc.CanTouch = false
		end
	elseif desc:IsA("Seat") or desc:IsA("VehicleSeat") then
		table.insert(Cached.Seats, desc)
		if State.Noclip and not State.Unloaded then
			desc.Disabled = true
		end
	end
end

local function getMoveDirectionFlat()
	local hum = Cached.Hum
	local root = Cached.Root
	if hum and hum.MoveDirection.Magnitude > 0.05 then
		local flatMove = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
		if flatMove.Magnitude > 0.001 then
			return flatMove.Unit
		end
	end
	if root then
		local lookFlat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if lookFlat.Magnitude > 0.001 then
			return lookFlat.Unit
		end
	end
	return Vector3.new(0, 0, -1)
end

local function isPositionClear(pos)
	local parts = Workspace:GetPartBoundsInRadius(pos, 1.65, sharedOverlapParams)
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.98 and not isShieldOrBarrierInstance(part) then
			return false
		end
	end
	return true
end

-- ==========================================
-- PHYSICAL SHIELD & PUSHBACK BYPASS
-- ==========================================
local function applyShieldPartDisable(part)
	if not part or not part.Parent or not part:IsA("BasePart") then return end
	if Cached.Char and part:IsDescendantOf(Cached.Char) then return end

	if Cached.ModifiedShieldParts[part] == nil then
		Cached.ModifiedShieldParts[part] = {
			CanCollide = part.CanCollide,
			CanTouch = part.CanTouch,
			CanQuery = part.CanQuery
		}
	end

	pcall(function()
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
	end)
end

local function restoreShieldParts()
	for part, orig in pairs(Cached.ModifiedShieldParts) do
		if part and part.Parent and part:IsA("BasePart") then
			pcall(function()
				part.CanCollide = orig.CanCollide
				part.CanTouch = orig.CanTouch
				part.CanQuery = orig.CanQuery
			end)
		end
	end
	table.clear(Cached.ModifiedShieldParts)
end

local function scanNearbyShields(root)
	if not State.AntiShieldBypass or State.Unloaded or not root then return end

	for part in pairs(Cached.ModifiedShieldParts) do
		if part and part.Parent and part:IsA("BasePart") then
			applyShieldPartDisable(part)
		else
			Cached.ModifiedShieldParts[part] = nil
		end
	end

	local radius = math.max(18, State.ShieldBypassDistance + 16)
	local nearbySphere = Workspace:GetPartBoundsInRadius(root.Position, radius, sharedOverlapParams)
	for _, part in ipairs(nearbySphere) do
		if part:IsA("BasePart") and isShieldOrBarrierInstance(part) then
			applyShieldPartDisable(part)
		end
	end

	local flatDir = getMoveDirectionFlat()
	local boxCenter = root.Position + (flatDir * (radius * 0.45))
	local boxSize = Vector3.new(radius * 1.5, 18, radius * 1.5)
	local boxCFrame = CFrame.new(boxCenter, boxCenter + flatDir)
	local nearbyBox = Workspace:GetPartBoundsInBox(boxCFrame, boxSize, sharedOverlapParams)
	for _, part in ipairs(nearbyBox) do
		if part:IsA("BasePart") and isShieldOrBarrierInstance(part) then
			applyShieldPartDisable(part)
		end
	end
end

local function hasShieldAhead(origin, dir, distance)
	local heights = { -1.4, 0, 1.6 }
	local angles = { 0, math.rad(22), math.rad(-22) }

	for _, yOff in ipairs(heights) do
		local rayOrigin = origin + Vector3.new(0, yOff, 0)
		for _, ang in ipairs(angles) do
			local probeDir = (CFrame.Angles(0, ang, 0) * dir).Unit
			local ray = Workspace:Raycast(rayOrigin, probeDir * distance, sharedRayParams)
			if ray and ray.Instance and isShieldOrBarrierInstance(ray.Instance) then
				return true
			end
		end
	end

	local midPos = origin + (dir * (distance * 0.5))
	local boxCF = CFrame.new(midPos, midPos + dir)
	local boxSize = Vector3.new(math.max(6, distance * 0.8), 11, math.max(6, distance * 0.95))
	local parts = Workspace:GetPartBoundsInBox(boxCF, boxSize, sharedOverlapParams)
	for _, part in ipairs(parts) do
		if isShieldOrBarrierInstance(part) then
			return true
		end
	end

	return false
end

local function executeShieldBypassStep(forceStep)
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char or not root then return false end

	local flatDir = getMoveDirectionFlat()
	local maxDist = math.max(6, State.ShieldBypassDistance)

	if not forceStep and not hasShieldAhead(root.Position, flatDir, 6.0) then
		return false
	end

	local chosenPos = nil
	local chosenDir = flatDir
	local searchAngles = { 0, math.rad(25), math.rad(-25), math.rad(45), math.rad(-45) }

	for _, ang in ipairs(searchAngles) do
		local testDir = (CFrame.Angles(0, ang, 0) * flatDir).Unit
		for dist = 3, maxDist do
			local probePos = root.Position + (testDir * dist)
			if not hasShieldAhead(probePos, testDir, 2.2) and isPositionClear(probePos) then
				local floorHit = Workspace:Raycast(probePos + Vector3.new(0, 3, 0), Vector3.new(0, -14, 0), sharedRayParams)
				if floorHit then
					local groundedPos = Vector3.new(probePos.X, floorHit.Position.Y + 3.0, probePos.Z)
					if isPositionClear(groundedPos) then
						chosenPos = groundedPos
						chosenDir = testDir
						break
					end
				else
					chosenPos = probePos
					chosenDir = testDir
					break
				end
			end
		end
		if chosenPos then
			break
		end
	end

	if not chosenPos then
		chosenPos = root.Position + (flatDir * math.min(maxDist, 14))
	end

	markMovementIntent(0.65)
	if hum and hum:GetState() == Enum.HumanoidStateType.Seated then
		hum.Sit = false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.new(chosenPos, chosenPos + chosenDir)
	State.LastCleanCFrame = root.CFrame
	State.LastShieldSafeCFrame = root.CFrame
	State.LastShieldBypassTime = os.clock()
	return true
end

local function applyShieldPushAndBounceGuard(hum, root, dt)
	if not State.AntiShieldBypass or State.Unloaded or not hum or not root then return end

	local nearShield = hasShieldAhead(root.Position, getMoveDirectionFlat(), 5.5)
	local v = root.AssemblyLinearVelocity

	if State.AntiShieldBounce and isValidVector3(v) then
		local flatDir = getMoveDirectionFlat()
		local awayFromMove = v.X * flatDir.X + v.Z * flatDir.Z
		if (nearShield and awayFromMove < -12) or v.Magnitude > State.MaxSafeVelocity then
			markMovementIntent(0.4)
			root.AssemblyLinearVelocity = Vector3.new(flatDir.X * 14, math.max(v.Y, 0), flatDir.Z * 14)
			root.AssemblyAngularVelocity = Vector3.zero
			if State.AutoShieldStep and (os.clock() - State.LastShieldBypassTime) > 0.2 then
				executeShieldBypassStep(true)
			end
			return
		end
	end

	if State.ShieldPushAssist and hum.MoveDirection.Magnitude > 0.1 then
		local flatDir = getMoveDirectionFlat()
		if hasShieldAhead(root.Position, flatDir, 4.2) then
			markMovementIntent(0.25)
			local stepAmt = math.min(1.45, ((hum.WalkSpeed + (State.SpeedEnabled and State.ExtraSpeed or 0)) * dt * 1.65) + 0.35)
			root.CFrame = root.CFrame + (flatDir * stepAmt)
		end
	end

	if not nearShield then
		State.LastShieldSafeCFrame = root.CFrame
	end
end

local function setAntiShieldBypass(enabled)
	State.AntiShieldBypass = enabled
	if enabled and not State.Unloaded then
		if Cached.Root then
			State.LastShieldSafeCFrame = Cached.Root.CFrame
			scanNearbyShields(Cached.Root)
		end
	else
		State.AutoShieldStep = false
		restoreShieldParts()
	end
end

-- ==========================================
-- NOCLIP BETA (ULTRA) & HARD WALL BYPASS
-- ==========================================
local noclipConnections = {}
local charDescendantConn = nil

local function hasWallAhead(origin, dir, distance)
	local rayLow = Workspace:Raycast(origin - Vector3.new(0, 1.15, 0), dir * distance, sharedRayParams)
	if rayLow and rayLow.Instance and rayLow.Instance:IsA("BasePart") and rayLow.Instance.CanCollide then
		return true
	end

	local rayHigh = Workspace:Raycast(origin + Vector3.new(0, 1.15, 0), dir * distance, sharedRayParams)
	if rayHigh and rayHigh.Instance and rayHigh.Instance:IsA("BasePart") and rayHigh.Instance.CanCollide then
		return true
	end

	return false
end

local function getBetaSlideVector(rootPos, flatDir, stepDist)
	local testPos = rootPos + (flatDir * stepDist)
	if isPositionClear(testPos) then
		return flatDir
	end

	if State.NoclipBetaUltra then
		local angles = { math.rad(25), math.rad(-25), math.rad(45), math.rad(-45) }
		for _, angle in ipairs(angles) do
			local rotated = (CFrame.Angles(0, angle, 0) * flatDir)
			local candidate = rootPos + (rotated * stepDist)
			if isPositionClear(candidate) then
				return rotated.Unit
			end
		end
	end

	return flatDir
end

local function applyStrongNoclipFrame()
	if not State.Noclip or State.Unloaded then return end
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char then return end

	for i = #Cached.Parts, 1, -1 do
		local part = Cached.Parts[i]
		if part and part.Parent then
			part.CanCollide = false
			part.CanTouch = false
		else
			table.remove(Cached.Parts, i)
		end
	end

	for i = #Cached.Seats, 1, -1 do
		local seat = Cached.Seats[i]
		if seat and seat.Parent then
			seat.Disabled = true
		else
			table.remove(Cached.Seats, i)
		end
	end

	if State.WallMicroStep and hum and root and hum.MoveDirection.Magnitude > 0.08 then
		local now = os.clock()
		local probeInterval = State.NoclipBetaUltra and 0.025 or 0.035
		if (now - State.LastWallProbeTime) >= probeInterval then
			State.LastWallProbeTime = now
			local flatDir = getMoveDirectionFlat()
			local checkDist = State.NoclipBetaUltra and 2.5 or 2.35
			if hasWallAhead(root.Position, flatDir, checkDist) then
				local pushDir = getBetaSlideVector(root.Position, flatDir, State.NoclipStepPower)
				markMovementIntent(0.25)
				root.CFrame = root.CFrame + (pushDir * State.NoclipStepPower)
				local v = root.AssemblyLinearVelocity
				if isValidVector3(v) then
					local boostXY = State.NoclipBetaUltra and 18 or 16
					root.AssemblyLinearVelocity = Vector3.new(pushDir.X * boostXY, v.Y, pushDir.Z * boostXY)
				end
			end
		end
	end
end

local function restoreNoclipProps()
	for part, origCollide in pairs(Cached.OrigCollide) do
		if part and part.Parent and part:IsA("BasePart") then
			part.CanCollide = origCollide
		end
	end
	table.clear(Cached.OrigCollide)
end

local function setNoclip(enabled)
	State.Noclip = enabled
	disconnectList(noclipConnections)

	if charDescendantConn then
		charDescendantConn:Disconnect()
		charDescendantConn = nil
	end

	if enabled and not State.Unloaded then
		if Cached.Char then
			charDescendantConn = Cached.Char.DescendantAdded:Connect(registerDescendant)
		end
		applyStrongNoclipFrame()

		if RunService.PreSimulation then
			table.insert(noclipConnections, RunService.PreSimulation:Connect(applyStrongNoclipFrame))
		end
		table.insert(noclipConnections, RunService.Stepped:Connect(applyStrongNoclipFrame))
	else
		restoreNoclipProps()
	end
end

local function executeHardWallBypass(forceScan)
	local char = Cached.Char
	local root = Cached.Root
	if not char or not root then return false end

	local flatDir = getMoveDirectionFlat()
	if not forceScan and not hasWallAhead(root.Position, flatDir, 4.0) then
		return false
	end

	local maxDist = math.max(5, State.BypassScanDistance)
	local chosenPos = nil

	for dist = 2, maxDist do
		local probePos = root.Position + (flatDir * dist)
		if not hasWallAhead(probePos, flatDir, 1.0) and isPositionClear(probePos) then
			local floorHit = Workspace:Raycast(probePos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), sharedRayParams)
			if floorHit then
				local groundedPos = Vector3.new(probePos.X, floorHit.Position.Y + 3.0, probePos.Z)
				if isPositionClear(groundedPos) then
					chosenPos = groundedPos
					break
				end
			else
				chosenPos = probePos
				break
			end
		end
	end

	if not chosenPos then
		chosenPos = root.Position + (flatDir * math.min(maxDist, 14))
	end

	markMovementIntent(0.55)
	local curY = isValidVector3(root.AssemblyLinearVelocity) and math.max(root.AssemblyLinearVelocity.Y, 0) or 0
	root.AssemblyLinearVelocity = Vector3.new(0, curY, 0)
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.new(chosenPos, chosenPos + flatDir)
	State.LastCleanCFrame = root.CFrame
	State.LastBypassTime = os.clock()
	return true
end

-- ==========================================
-- BUG-RESISTANT UNDER MAP & RETURN SYSTEM
-- ==========================================
local underPlatform = Instance.new("Part")
underPlatform.Name = "YutaHub_UnderPlatform"
underPlatform.Size = Vector3.new(24, 1, 24)
underPlatform.Anchored = true
underPlatform.CanCollide = true
underPlatform.CanTouch = false
underPlatform.Transparency = 0.75
underPlatform.Material = Enum.Material.SmoothPlastic
underPlatform.Parent = nil

local underMapToggleRef = nil
local refreshFloatingButtonVisual = nil

local function syncUnderMapToggleUI(value)
	if underMapToggleRef and underMapToggleRef.Set then
		State.SyncingToggle = true
		pcall(function()
			underMapToggleRef:Set(value)
		end)
		State.SyncingToggle = false
	end
	if refreshFloatingButtonVisual then
		refreshFloatingButtonVisual()
	end
end

local function ensureUnderPlatform()
	if not underPlatform or not underPlatform.Parent then
		underPlatform = Instance.new("Part")
		underPlatform.Name = "YutaHub_UnderPlatform"
		underPlatform.Size = Vector3.new(24, 1, 24)
		underPlatform.Anchored = true
		underPlatform.CanCollide = true
		underPlatform.CanTouch = false
		underPlatform.Transparency = 0.75
		underPlatform.Material = Enum.Material.SmoothPlastic
	end
end

local function updateUnderMapLoop(root)
	if not State.UnderMap or not root then return end
	ensureUnderPlatform()
	markMovementIntent(0.2)

	local targetY = State.UnderMapLockY and State.UnderAnchorY or root.Position.Y
	if not targetY then
		targetY = root.Position.Y
		State.UnderAnchorY = targetY
	end

	if root.Position.Y < (targetY - 1.5) then
		local look = root.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		local targetPos = Vector3.new(root.Position.X, targetY, root.Position.Z)
		if flatLook.Magnitude > 0.001 then
			root.CFrame = CFrame.new(targetPos, targetPos + flatLook.Unit)
		else
			root.CFrame = CFrame.new(targetPos)
		end
		root.AssemblyLinearVelocity = Vector3.zero
	end

	underPlatform.Parent = Workspace
	underPlatform.CFrame = CFrame.new(root.Position.X, targetY - 3.5, root.Position.Z)
end

local function returnFromUnderMap()
	local root = Cached.Root
	State.UnderMap = false
	State.UnderAnchorY = nil
	if underPlatform then
		underPlatform.Parent = nil
	end
	markMovementIntent(0.75)

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if State.SavedCFrame then
			local returnPos = State.SavedCFrame.Position + Vector3.new(0, 2.5, 0)
			local look = State.SavedCFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			if flatLook.Magnitude > 0.001 then
				root.CFrame = CFrame.new(returnPos, returnPos + flatLook.Unit)
			else
				root.CFrame = CFrame.new(returnPos)
			end
			State.LastCleanCFrame = root.CFrame
			State.SavedCFrame = nil
		else
			local upHit = Workspace:Raycast(root.Position, Vector3.new(0, 120, 0), sharedRayParams)
			if upHit then
				local safeAbove = upHit.Position + Vector3.new(0, 4.5, 0)
				root.CFrame = CFrame.new(safeAbove)
			else
				local topDownHit = Workspace:Raycast(root.Position + Vector3.new(0, 220, 0), Vector3.new(0, -320, 0), sharedRayParams)
				if topDownHit then
					root.CFrame = CFrame.new(topDownHit.Position + Vector3.new(0, 4.0, 0))
				else
					root.CFrame = root.CFrame + Vector3.new(0, State.UnderMapOffset + 5, 0)
				end
			end
			State.LastCleanCFrame = root.CFrame
		end
	end

	syncUnderMapToggleUI(false)
end

local function setUnderMap(enabled)
	if State.SyncingToggle then return end
	local root = Cached.Root

	if enabled and not State.Unloaded then
		if not root then
			syncUnderMapToggleUI(false)
			return
		end

		if not State.UnderMap then
			State.SavedCFrame = root.CFrame
		end

		State.UnderMap = true
		markMovementIntent(0.75)

		local look = root.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		local targetPos = Vector3.new(root.Position.X, root.Position.Y - State.UnderMapOffset, root.Position.Z)
		State.UnderAnchorY = targetPos.Y

		ensureUnderPlatform()
		underPlatform.Parent = Workspace
		underPlatform.CFrame = CFrame.new(targetPos.X, targetPos.Y - 3.5, targetPos.Z)

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		if flatLook.Magnitude > 0.001 then
			root.CFrame = CFrame.new(targetPos, targetPos + flatLook.Unit)
		else
			root.CFrame = CFrame.new(targetPos)
		end

		if refreshFloatingButtonVisual then
			refreshFloatingButtonVisual()
		end
	else
		returnFromUnderMap()
	end
end


-- ==========================================
-- STATE & CACHED REFERENCES
-- ==========================================
local State = {
	Noclip = false,
	NoclipBetaUltra = true,
	WallMicroStep = true,
	AutoWallBypass = false,
	AntiRagdoll = false,
	AntiKnockback = false,
	AntiUnusualMovement = false,
	AntiUnusualStrict = true,
	SnapBackOnUnusual = true,
	UnderMap = false,
	SpeedEnabled = false,
	JumpEnabled = false,
	BoxESP = false,
	NoclipStepPower = 0.95,
	BypassScanDistance = 24,
	UnderMapOffset = 12,
	ExtraSpeed = 16,
	JumpHeight = 14,
	JumpPower = 75,
	DefaultJumpHeight = 7.2,
	DefaultJumpPower = 50,
	MaxSafeVelocity = 110,
	MaxUnusualSpeed = 85,
	MaxUnusualSnapDist = 28,
	SavedCFrame = nil,
	LastCleanCFrame = nil,
	LastBypassTime = 0,
	LastWallProbeTime = 0,
	LastRagdollSweepTime = 0,
	LastMoverSweepTime = 0,
	IgnoreUnusualUntil = 0,
	AnomalyStreak = 0,
	Unloaded = false
}

local Cached = {
	Char = nil,
	Hum = nil,
	Root = nil,
	Parts = {},
	Seats = {},
	OrigCollide = {}
}

local sharedRayParams = RaycastParams.new()
sharedRayParams.FilterType = Enum.RaycastFilterType.Exclude

local sharedOverlapParams = OverlapParams.new()
sharedOverlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function markMovementIntent(duration)
	State.IgnoreUnusualUntil = os.clock() + (duration or 0.35)
	State.AnomalyStreak = 0
end

local function isValidVector3(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
end

local function isSafeVelocity(vel)
	return isValidVector3(vel) and vel.Magnitude <= State.MaxSafeVelocity
end

local function disconnectList(list)
	for _, conn in ipairs(list) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(list)
end

local function rebuildCharacterCache(char)
	table.clear(Cached.Parts)
	table.clear(Cached.Seats)

	Cached.Char = char
	Cached.Hum = char and char:FindFirstChildOfClass("Humanoid") or nil
	Cached.Root = char and (
		char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
	) or nil

	sharedRayParams.FilterDescendantsInstances = char and { char } or {}
	sharedOverlapParams.FilterDescendantsInstances = char and { char } or {}

	if not char then return end

	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") then
			table.insert(Cached.Parts, desc)
			if Cached.OrigCollide[desc] == nil then
				Cached.OrigCollide[desc] = desc.CanCollide
			end
		elseif desc:IsA("Seat") or desc:IsA("VehicleSeat") then
			table.insert(Cached.Seats, desc)
		end
	end
end

local function registerDescendant(desc)
	if desc:IsA("BasePart") then
		table.insert(Cached.Parts, desc)
		if Cached.OrigCollide[desc] == nil then
			Cached.OrigCollide[desc] = desc.CanCollide
		end
		if State.Noclip and not State.Unloaded then
			desc.CanCollide = false
			desc.CanTouch = false
		end
	elseif desc:IsA("Seat") or desc:IsA("VehicleSeat") then
		table.insert(Cached.Seats, desc)
		if State.Noclip and not State.Unloaded then
			desc.Disabled = true
		end
	end
end

local function getMoveDirectionFlat()
	local hum = Cached.Hum
	local root = Cached.Root
	if hum and hum.MoveDirection.Magnitude > 0.05 then
		local flatMove = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
		if flatMove.Magnitude > 0.001 then
			return flatMove.Unit
		end
	end
	if root then
		local lookFlat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if lookFlat.Magnitude > 0.001 then
			return lookFlat.Unit
		end
	end
	return Vector3.new(0, 0, -1)
end

local function isPositionClear(pos)
	local parts = Workspace:GetPartBoundsInRadius(pos, 1.65, sharedOverlapParams)
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.98 then
			return false
		end
	end
	return true
end

-- ==========================================
-- NOCLIP BETA (ULTRA) & HARD WALL BYPASS
-- ==========================================
local noclipConnections = {}
local charDescendantConn = nil

local function hasWallAhead(origin, dir, distance)
	local rayLow = Workspace:Raycast(origin - Vector3.new(0, 1.15, 0), dir * distance, sharedRayParams)
	if rayLow and rayLow.Instance and rayLow.Instance:IsA("BasePart") and rayLow.Instance.CanCollide then
		return true
	end

	local rayHigh = Workspace:Raycast(origin + Vector3.new(0, 1.15, 0), dir * distance, sharedRayParams)
	if rayHigh and rayHigh.Instance and rayHigh.Instance:IsA("BasePart") and rayHigh.Instance.CanCollide then
		return true
	end

	return false
end

local function getBetaSlideVector(rootPos, flatDir, stepDist)
	local testPos = rootPos + (flatDir * stepDist)
	if isPositionClear(testPos) then
		return flatDir
	end

	if State.NoclipBetaUltra then
		local angles = { math.rad(25), math.rad(-25), math.rad(45), math.rad(-45) }
		for _, angle in ipairs(angles) do
			local rotated = (CFrame.Angles(0, angle, 0) * flatDir)
			local candidate = rootPos + (rotated * stepDist)
			if isPositionClear(candidate) then
				return rotated.Unit
			end
		end
	end

	return flatDir
end

local function applyStrongNoclipFrame()
	if not State.Noclip or State.Unloaded then return end
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char then return end

	for i = #Cached.Parts, 1, -1 do
		local part = Cached.Parts[i]
		if part and part.Parent then
			part.CanCollide = false
			part.CanTouch = false
		else
			table.remove(Cached.Parts, i)
		end
	end

	for i = #Cached.Seats, 1, -1 do
		local seat = Cached.Seats[i]
		if seat and seat.Parent then
			seat.Disabled = true
		else
			table.remove(Cached.Seats, i)
		end
	end

	if State.WallMicroStep and hum and root and hum.MoveDirection.Magnitude > 0.08 then
		local now = os.clock()
		local probeInterval = State.NoclipBetaUltra and 0.025 or 0.035
		if (now - State.LastWallProbeTime) >= probeInterval then
			State.LastWallProbeTime = now
			local flatDir = getMoveDirectionFlat()
			local checkDist = State.NoclipBetaUltra and 2.5 or 2.35
			if hasWallAhead(root.Position, flatDir, checkDist) then
				local pushDir = getBetaSlideVector(root.Position, flatDir, State.NoclipStepPower)
				markMovementIntent(0.25)
				root.CFrame = root.CFrame + (pushDir * State.NoclipStepPower)
				local v = root.AssemblyLinearVelocity
				if isValidVector3(v) then
					local boostXY = State.NoclipBetaUltra and 18 or 16
					root.AssemblyLinearVelocity = Vector3.new(pushDir.X * boostXY, v.Y, pushDir.Z * boostXY)
				end
			end
		end
	end
end

local function restoreNoclipProps()
	for part, origCollide in pairs(Cached.OrigCollide) do
		if part and part.Parent and part:IsA("BasePart") then
			part.CanCollide = origCollide
		end
	end
	table.clear(Cached.OrigCollide)
end

local function setNoclip(enabled)
	State.Noclip = enabled
	disconnectList(noclipConnections)

	if charDescendantConn then
		charDescendantConn:Disconnect()
		charDescendantConn = nil
	end

	if enabled and not State.Unloaded then
		if Cached.Char then
			charDescendantConn = Cached.Char.DescendantAdded:Connect(registerDescendant)
		end
		applyStrongNoclipFrame()

		if RunService.PreSimulation then
			table.insert(noclipConnections, RunService.PreSimulation:Connect(applyStrongNoclipFrame))
		end
		table.insert(noclipConnections, RunService.Stepped:Connect(applyStrongNoclipFrame))
	else
		restoreNoclipProps()
	end
end

local function executeHardWallBypass(forceScan)
	local char = Cached.Char
	local root = Cached.Root
	if not char or not root then return false end

	local flatDir = getMoveDirectionFlat()
	if not forceScan and not hasWallAhead(root.Position, flatDir, 4.0) then
		return false
	end

	local maxDist = math.max(5, State.BypassScanDistance)
	local chosenPos = nil

	for dist = 2, maxDist do
		local probePos = root.Position + (flatDir * dist)
		if not hasWallAhead(probePos, flatDir, 1.0) and isPositionClear(probePos) then
			local floorHit = Workspace:Raycast(probePos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), sharedRayParams)
			if floorHit then
				local groundedPos = Vector3.new(probePos.X, floorHit.Position.Y + 3.0, probePos.Z)
				if isPositionClear(groundedPos) then
					chosenPos = groundedPos
					break
				end
			else
				chosenPos = probePos
				break
			end
		end
	end

	if not chosenPos then
		chosenPos = root.Position + (flatDir * math.min(maxDist, 14))
	end

	markMovementIntent(0.45)
	local curY = isValidVector3(root.AssemblyLinearVelocity) and math.max(root.AssemblyLinearVelocity.Y, 0) or 0
	root.AssemblyLinearVelocity = Vector3.new(0, curY, 0)
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.new(chosenPos, chosenPos + flatDir)
	State.LastCleanCFrame = root.CFrame
	State.LastBypassTime = os.clock()
	return true
end

-- ==========================================
-- ANTI-UNUSUAL MOVEMENT (PRO), RAGDOLL & KNOCKBACK
-- ==========================================
local ragdollStateConn = nil

local function lockHumanoidStates(hum)
	if not hum then return end
	local blockedStates = {
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Physics
	}
	for _, stateType in ipairs(blockedStates) do
		pcall(function()
			hum:SetStateEnabled(stateType, false)
		end)
	end
end

local function unlockHumanoidStates(hum)
	if not hum then return end
	local states = {
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Physics
	}
	for _, stateType in ipairs(states) do
		pcall(function()
			hum:SetStateEnabled(stateType, true)
		end)
	end
end

local function clearStrayMovers(char)
	if not char then return end
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BodyVelocity")
			or desc:IsA("BodyGyro")
			or desc:IsA("BodyAngularVelocity")
			or desc:IsA("BodyPosition")
			or desc:IsA("LinearVelocity")
			or desc:IsA("AngularVelocity") then
			desc:Destroy()
		end
	end
end

local function sanitizeRagdollAndJoints(char, hum, root, fullSweep)
	if not char or not hum then return end

	local curState = hum:GetState()
	if curState == Enum.HumanoidStateType.Ragdoll
		or curState == Enum.HumanoidStateType.FallingDown
		or curState == Enum.HumanoidStateType.Physics then
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
		task.defer(function()
			if hum and hum.Parent and not State.Unloaded then
				pcall(function()
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end)
			end
		end)
	end

	if fullSweep then
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("Motor6D") then
				desc.Enabled = true
			elseif desc:IsA("BallSocketConstraint") or desc:IsA("HingeConstraint") then
				if desc.Name:lower():find("ragdoll") or (desc.Parent and desc.Parent.Name:lower():find("ragdoll")) then
					desc:Destroy()
				end
			elseif State.AntiKnockback
				and (desc:IsA("BodyVelocity") or desc:IsA("BodyGyro") or desc:IsA("LinearVelocity") or desc:IsA("AngularVelocity")) then
				desc:Destroy()
			end
		end
	end

	if root and not isSafeVelocity(root.AssemblyLinearVelocity) then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function applyAntiUnusualMovement(char, hum, root, dt, now)
	if not State.AntiUnusualMovement or State.Unloaded or not char or not hum or not root then return end

	local v = root.AssemblyLinearVelocity
	local ang = root.AssemblyAngularVelocity
	local anomalyDetected = false

	-- 1. Catch NaN / non-finite physics vectors immediately
	if not isValidVector3(v) or not isValidVector3(ang) then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		State.AnomalyStreak = 0
		if State.LastCleanCFrame then
			root.CFrame = State.LastCleanCFrame
		end
		return
	end

	-- 2. Clamp runaway velocity and angular spin bursts
	local allowedSpeed = State.MaxUnusualSpeed + (State.SpeedEnabled and State.ExtraSpeed or 0)
	if v.Magnitude > allowedSpeed then
		local dir = v.Magnitude > 0.001 and v.Unit or Vector3.zero
		root.AssemblyLinearVelocity = dir * (allowedSpeed * 0.65)
		anomalyDetected = true
	end

	if ang.Magnitude > 18 then
		root.AssemblyAngularVelocity = ang * 0.15
		if ang.Magnitude > 30 then
			root.AssemblyAngularVelocity = Vector3.zero
		end
		anomalyDetected = true
	end

	-- 3. Recover from unintended movement states (PlatformStanding, GettingUp loop, unwanted Sit)
	local hState = hum:GetState()
	if hState == Enum.HumanoidStateType.PlatformStanding
		or (hState == Enum.HumanoidStateType.Seated and hum.MoveDirection.Magnitude > 0.1)
		or (State.AntiUnusualStrict and hState == Enum.HumanoidStateType.GettingUp and hum.MoveDirection.Magnitude > 0.15) then
		hum.Sit = false
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
		anomalyDetected = true
	end

	-- 4. Detect sudden unexpected position jumps when not under-mapping or intentionally bypassing
	local skipSnapCheck = State.UnderMap or (now < State.IgnoreUnusualUntil)
	if not skipSnapCheck and State.LastCleanCFrame then
		local expectedMaxStep = math.max(
			State.MaxUnusualSnapDist,
			((hum.WalkSpeed + (State.SpeedEnabled and State.ExtraSpeed or 0)) * dt) + 14
		)
		local distMoved = (root.Position - State.LastCleanCFrame.Position).Magnitude
		if distMoved > expectedMaxStep then
			anomalyDetected = true
			State.AnomalyStreak = State.AnomalyStreak + 1
			local neededStreak = State.AntiUnusualStrict and 1 or 2

			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			if State.SnapBackOnUnusual and State.AnomalyStreak >= neededStreak then
				local safePos = State.LastCleanCFrame.Position
				if isPositionClear(safePos) then
					root.CFrame = State.LastCleanCFrame
				end
				State.AnomalyStreak = 0
			end
			return
		end
	end

	-- 5. Throttled cleanup of stray movers when anomalies occur
	if anomalyDetected and (now - State.LastMoverSweepTime) >= 0.15 then
		State.LastMoverSweepTime = now
		clearStrayMovers(char)
	end

	if not anomalyDetected then
		State.AnomalyStreak = math.max(0, State.AnomalyStreak - 1)
		if not State.UnderMap then
			State.LastCleanCFrame = root.CFrame
		end
	end
end

local function bindRagdollWatcher(char)
	if ragdollStateConn then
		ragdollStateConn:Disconnect()
		ragdollStateConn = nil
	end

	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if State.AntiRagdoll and not State.Unloaded then
		lockHumanoidStates(hum)
		ragdollStateConn = hum.StateChanged:Connect(function(_, newState)
			if not State.AntiRagdoll or State.Unloaded then return end
			if newState == Enum.HumanoidStateType.Ragdoll
				or newState == Enum.HumanoidStateType.FallingDown
				or newState == Enum.HumanoidStateType.Physics then
				sanitizeRagdollAndJoints(Cached.Char, Cached.Hum, Cached.Root, true)
			end
		end)
	end
end

local function setAntiRagdoll(enabled)
	State.AntiRagdoll = enabled
	if enabled and not State.Unloaded then
		lockHumanoidStates(Cached.Hum)
		bindRagdollWatcher(Cached.Char)
		sanitizeRagdollAndJoints(Cached.Char, Cached.Hum, Cached.Root, true)
	else
		if ragdollStateConn then
			ragdollStateConn:Disconnect()
			ragdollStateConn = nil
		end
		unlockHumanoidStates(Cached.Hum)
	end
end

-- ==========================================
-- UNDER MAP & RETURN SYSTEM
-- ==========================================
local underPlatform = Instance.new("Part")
underPlatform.Name = "DarkMoon_UnderPlatform"
underPlatform.Size = Vector3.new(16, 1, 16)
underPlatform.Anchored = true
underPlatform.CanCollide = true
underPlatform.Transparency = 0.75
underPlatform.Material = Enum.Material.SmoothPlastic
underPlatform.Parent = nil

local underMapToggleRef = nil

local function returnFromUnderMap()
	local root = Cached.Root
	State.UnderMap = false
	if underPlatform then
		underPlatform.Parent = nil
	end
	markMovementIntent(0.45)

	if not root then return end

	if State.SavedCFrame then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = State.SavedCFrame + Vector3.new(0, 2, 0)
		State.LastCleanCFrame = root.CFrame
		State.SavedCFrame = nil
	else
		local result = Workspace:Raycast(root.Position + Vector3.new(0, 200, 0), Vector3.new(0, -300, 0), sharedRayParams)
		root.AssemblyLinearVelocity = Vector3.zero
		if result then
			root.CFrame = CFrame.new(result.Position + Vector3.new(0, 4, 0))
		else
			root.CFrame = root.CFrame + Vector3.new(0, State.UnderMapOffset + 4, 0)
		end
		State.LastCleanCFrame = root.CFrame
	end
end

local function setUnderMap(enabled)
	local root = Cached.Root

	if enabled and not State.Unloaded then
		if not root then return end
		if not State.UnderMap then
			State.SavedCFrame = root.CFrame
		end
		State.UnderMap = true
		markMovementIntent(0.45)

		local targetPos = root.Position - Vector3.new(0, State.UnderMapOffset, 0)
		underPlatform.CFrame = CFrame.new(targetPos - Vector3.new(0, 3.5, 0))
		underPlatform.Parent = Workspace
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.new(targetPos)
	else
		returnFromUnderMap()
	end
end

-- ==========================================
-- JUMP BOOST
-- ==========================================
local function applyJumpBoost(enabled)
	State.JumpEnabled = enabled
	local hum = Cached.Hum
	if not hum then return end

	if enabled and not State.Unloaded then
		if hum.UseJumpPower then
			hum.JumpPower = State.JumpPower
		else
			hum.JumpHeight = State.JumpHeight
		end
	else
		if hum.UseJumpPower then
			hum.JumpPower = State.DefaultJumpPower
		else
			hum.JumpHeight = State.DefaultJumpHeight
		end
	end
end

-- ==========================================
-- BOX ESP (DRAWING API)
-- ==========================================
local espBoxes = {}

local function createBox()
	local box = Drawing.new("Square")
	box.Visible = false
	box.Color = Color3.fromRGB(255, 85, 85)
	box.Thickness = 1.5
	box.Filled = false
	box.Transparency = 1
	return box
end

local function hideAllBoxes()
	for _, box in pairs(espBoxes) do
		box.Visible = false
	end
end

local function removePlayerESP(player)
	local box = espBoxes[player]
	if box then
		pcall(function()
			box:Remove()
		end)
		espBoxes[player] = nil
	end
end

local function updateESPFrame()
	if not State.BoxESP or State.Unloaded then
		hideAllBoxes()
		return
	end

	local activeCam = Workspace.CurrentCamera
	if not activeCam then
		hideAllBoxes()
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local root = char and (
				char:FindFirstChild("HumanoidRootPart")
				or char:FindFirstChild("Torso")
				or char:FindFirstChild("UpperTorso")
			)
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")

			if root and humanoid and humanoid.Health > 0 then
				local box = espBoxes[player]
				if not box then
					box = createBox()
					espBoxes[player] = box
				end

				local rootPos, onScreen = activeCam:WorldToViewportPoint(root.Position)
				if onScreen and rootPos.Z > 0 then
					local topPos = activeCam:WorldToViewportPoint((root.CFrame * CFrame.new(0, 2.6, 0)).Position)
					local bottomPos = activeCam:WorldToViewportPoint((root.CFrame * CFrame.new(0, -3.1, 0)).Position)

					local height = math.abs(topPos.Y - bottomPos.Y)
					local width = math.clamp(height * 0.6, 12, 250)

					box.Size = Vector2.new(width, math.clamp(height, 18, 400))
					box.Position = Vector2.new(rootPos.X - box.Size.X / 2, topPos.Y)
					box.Visible = true
				else
					box.Visible = false
				end
			elseif espBoxes[player] then
				espBoxes[player].Visible = false
			end
		end
	end
end

-- ==========================================
-- LIFECYCLE & LOOPS
-- ==========================================
local lifecycleConnections = {}

if LocalPlayer.Character then
	rebuildCharacterCache(LocalPlayer.Character)
end

local function unloadAll()
	if State.Unloaded then return end
	State.Unloaded = true

	State.AutoWallBypass = false
	State.AntiUnusualMovement = false
	State.AntiKnockback = false
	State.SpeedEnabled = false
	State.BoxESP = false

	setNoclip(false)
	setAntiRagdoll(false)
	applyJumpBoost(false)

	if State.UnderMap then
		returnFromUnderMap()
	elseif underPlatform then
		underPlatform.Parent = nil
	end

	for player in pairs(espBoxes) do
		removePlayerESP(player)
	end

	disconnectList(lifecycleConnections)

	if underPlatform then
		underPlatform:Destroy()
		underPlatform = nil
	end

	pcall(function()
		Window:Destroy()
	end)
end

table.insert(lifecycleConnections, RunService.Heartbeat:Connect(function(dt)
	if State.Unloaded then return end
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char or not hum or not root or hum.Health <= 0 then return end

	local clampedDt = math.min(dt, 0.05)
	local now = os.clock()

	if State.AutoWallBypass and hum.MoveDirection.Magnitude > 0.1 and (now - State.LastBypassTime) > 0.22 then
		executeHardWallBypass(false)
	end

	if State.AntiRagdoll then
		local doFullSweep = (now - State.LastRagdollSweepTime) >= 0.12
		if doFullSweep then
			State.LastRagdollSweepTime = now
		end
		sanitizeRagdollAndJoints(char, hum, root, doFullSweep)
	end

	if State.AntiKnockback then
		local v = root.AssemblyLinearVelocity
		if isValidVector3(v) and v.Magnitude > State.MaxSafeVelocity then
			local dir = v.Magnitude > 0.001 and v.Unit or Vector3.zero
			root.AssemblyLinearVelocity = dir * State.MaxSafeVelocity
		end
		if isValidVector3(root.AssemblyAngularVelocity) and root.AssemblyAngularVelocity.Magnitude > 35 then
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if State.SpeedEnabled then
		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0.01 then
			local flatDir = Vector3.new(moveDir.X, 0, moveDir.Z)
			if flatDir.Magnitude > 0 then
				flatDir = flatDir.Unit
				markMovementIntent(0.1)
				root.CFrame = root.CFrame + (flatDir * State.ExtraSpeed * clampedDt)
			end
		end
	end

	if State.UnderMap and underPlatform then
		underPlatform.Parent = Workspace
		underPlatform.CFrame = CFrame.new(root.Position - Vector3.new(0, 3.5, 0))
	end

	if State.JumpEnabled then
		if hum.UseJumpPower then
			if hum.JumpPower ~= State.JumpPower then
				hum.JumpPower = State.JumpPower
			end
		else
			if hum.JumpHeight ~= State.JumpHeight then
				hum.JumpHeight = State.JumpHeight
			end
		end
	end

	applyAntiUnusualMovement(char, hum, root, clampedDt, now)
end))

table.insert(lifecycleConnections, RunService.RenderStepped:Connect(updateESPFrame))
table.insert(lifecycleConnections, Players.PlayerRemoving:Connect(removePlayerESP))

table.insert(lifecycleConnections, LocalPlayer.CharacterAdded:Connect(function(char)
	if State.Unloaded then return end
	table.clear(Cached.OrigCollide)
	State.UnderMap = false
	State.SavedCFrame = nil
	State.LastCleanCFrame = nil
	State.AnomalyStreak = 0
	if underPlatform then
		underPlatform.Parent = nil
	end

	rebuildCharacterCache(char)
	if not Cached.Hum or not Cached.Root then
		char:WaitForChild("Humanoid", 5)
		char:WaitForChild("HumanoidRootPart", 5)
		rebuildCharacterCache(char)
	end

	task.wait(0.15)
	if State.Unloaded then return end

	if Cached.Root then
		State.LastCleanCFrame = Cached.Root.CFrame
	end
	if State.Noclip then
		setNoclip(true)
	end
	if State.AntiRagdoll then
		lockHumanoidStates(Cached.Hum)
		bindRagdollWatcher(char)
		sanitizeRagdollAndJoints(char, Cached.Hum, Cached.Root, true)
	end
	if Cached.Hum and State.JumpEnabled then
		applyJumpBoost(true)
	end
end))


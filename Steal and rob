local function applyJumpBoost(enabled)
	State.JumpEnabled = enabled
	local hum = Cached.Hum
	if not hum then return end

	if enabled and not State.Unloaded then
		if hum.UseJumpPower then
			hum.JumpPower = State.JumpPower
		else
			hum.JumpHeight = State.JumpHeight
		end
	else

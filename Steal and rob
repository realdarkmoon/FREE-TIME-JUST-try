table.insert(lifecycleConnections, RunService.Heartbeat:Connect(function(dt)
	if State.Unloaded then return end
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char or not hum or not root or hum.Health <= 0 then return end

	local clampedDt = math.min(dt, 0.05)
	local now = os.clock()

	if State.AutoWallBypass and hum.MoveDirection.Magnitude > 0.1 and (now - State.LastBypassTime) > 0.22 then
		executeHardWallBypass(false)
	end

	if State.AntiFallDamage then
		applyAntiFallDamageFrame(hum, root)
	end

	if State.AntiRagdoll then
		local doFullSweep = (now - State.LastRagdollSweepTime) >= 0.12
		if doFullSweep then
			State.LastRagdollSweepTime = now
		end
		sanitizeRagdollAndJoints(char, hum, root, doFullSweep)
	end

	if State.AntiKnockback then
		local v = root.AssemblyLinearVelocity
		if isValidVector3(v) and v.Magnitude > State.MaxSafeVelocity then
			local dir = v.Magnitude > 0.001 and v.Unit or Vector3.zero
			root.AssemblyLinearVelocity = dir * State.MaxSafeVelocity
		end
		if isValidVector3(root.AssemblyAngularVelocity) and root.AssemblyAngularVelocity.Magnitude > 35 then
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if State.SpeedEnabled then
		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0.01 then
			local flatDir = Vector3.new(moveDir.X, 0, moveDir.Z)
			if flatDir.Magnitude > 0 then
				flatDir = flatDir.Unit
				markMovementIntent(0.1)
				root.CFrame = root.CFrame + (flatDir * State.ExtraSpeed * clampedDt)
			end
		end
	end

	if State.UnderMap then
		updateUnderMapLoop(root)
	end

	if State.JumpEnabled then
		if hum.UseJumpPower then
			if hum.JumpPower ~= State.JumpPower then
				hum.JumpPower = State.JumpPower
			end
		else
			if hum.JumpHeight ~= State.JumpHeight then
				hum.JumpHeight = State.JumpHeight
			end
		end
	end

	applyAntiUnusualMovement(hum, root, clampedDt)
end))


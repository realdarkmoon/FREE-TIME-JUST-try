local function markMovementIntent(duration)
	State.IgnoreUnusualUntil = math.max(State.IgnoreUnusualUntil, os.clock() + (duration or 0.45))
end

local function isValidVector3(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
end

local function isSafeVelocity(vel)
	return isValidVector3(vel) and vel.Magnitude <= State.MaxSafeVelocity
end

local function disconnectList(list)
	for _, conn in ipairs(list) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(list)
end

local function rebuildCharacterCache(char)
	table.clear(Cached.Parts)
	table.clear(Cached.Seats)

	Cached.Char = char
	Cached.Hum = char and char:FindFirstChildOfClass("Humanoid") or nil
	Cached.Root = char and (
		char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
	) or nil

	sharedRayParams.FilterDescendantsInstances = char and { char } or {}
	sharedOverlapParams.FilterDescendantsInstances = char and { char } or {}

	if not char then return end

	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") then
			table.insert(Cached.Parts, desc)
			if Cached.OrigCollide[desc] == nil then
				Cached.OrigCollide[desc] = desc.CanCollide
			end
		elseif desc:IsA("Seat") or desc:IsA("VehicleSeat") then
			table.insert(Cached.Seats, desc)
		end
	end
end

local function registerDescendant(desc)
	if desc:IsA("BasePart") then
		table.insert(Cached.Parts, desc)
		if Cached.OrigCollide[desc] == nil then
			Cached.OrigCollide[desc] = desc.CanCollide
		end
		if State.Noclip and not State.Unloaded then
			desc.CanCollide = false
			desc.CanTouch = false
		end
	elseif desc:IsA("Seat") or desc:IsA("VehicleSeat") then
		table.insert(Cached.Seats, desc)
		if State.Noclip and not State.Unloaded then
			desc.Disabled = true
		end
	end
end

local function getMoveDirectionFlat()
	local hum = Cached.Hum
	local root = Cached.Root
	if hum and hum.MoveDirection.Magnitude > 0.05 then
		local flatMove = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
		if flatMove.Magnitude > 0.001 then
			return flatMove.Unit
		end
	end
	if root then
		local lookFlat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if lookFlat.Magnitude > 0.001 then
			return lookFlat.Unit
		end
	end
	return Vector3.new(0, 0, -1)
end

local function isPositionClear(pos)
	local parts = Workspace:GetPartBoundsInRadius(pos, 1.65, sharedOverlapParams)
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.98 then
			return false
		end
	end
	return true
end

local function safeTeleportToPosition(targetPos, flatLookDir)
	local root = Cached.Root
	if not root or not isValidVector3(targetPos) then return false end

	if State.UnderMap then
		State.UnderMap = false
		State.UnderAnchorY = nil
		if underPlatform then
			underPlatform.Parent = nil
		end
		if syncUnderMapToggleUI then
			syncUnderMapToggleUI(false)
		end
	end

	markMovementIntent(0.75)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local finalPos = targetPos + Vector3.new(0, 2.5, 0)
	if flatLookDir and isValidVector3(flatLookDir) and flatLookDir.Magnitude > 0.001 then
		root.CFrame = CFrame.new(finalPos, finalPos + flatLookDir.Unit)
	else
		root.CFrame = CFrame.new(finalPos)
	end
	State.LastCleanCFrame = root.CFrame
	return true
end

-- ==========================================
-- NOCLIP BETA (ULTRA) & HARD WALL BYPASS
-- ==========================================
local noclipConnections = {}
local charDescendantConn = nil

local function hasWallAhead(origin, dir, distance)
	local rayLow = Workspace:Raycast(origin - Vector3.new(0, 1.15, 0), dir * distance, sharedRayParams)
	if rayLow and rayLow.Instance and rayLow.Instance:IsA("BasePart") and rayLow.Instance.CanCollide then
		return true
	end

	local rayHigh = Workspace:Raycast(origin + Vector3.new(0, 1.15, 0), dir * distance, sharedRayParams)
	if rayHigh and rayHigh.Instance and rayHigh.Instance:IsA("BasePart") and rayHigh.Instance.CanCollide then
		return true
	end

	return false
end

local function getBetaSlideVector(rootPos, flatDir, stepDist)
	local testPos = rootPos + (flatDir * stepDist)
	if isPositionClear(testPos) then
		return flatDir
	end

	if State.NoclipBetaUltra then
		local angles = { math.rad(25), math.rad(-25), math.rad(45), math.rad(-45) }
		for _, angle in ipairs(angles) do
			local rotated = (CFrame.Angles(0, angle, 0) * flatDir)
			local candidate = rootPos + (rotated * stepDist)
			if isPositionClear(candidate) then
				return rotated.Unit
			end
		end
	end

	return flatDir
end

local function applyStrongNoclipFrame()
	if not State.Noclip or State.Unloaded then return end
	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char then return end

	for i = #Cached.Parts, 1, -1 do
		local part = Cached.Parts[i]
		if part and part.Parent then
			part.CanCollide = false
			part.CanTouch = false
		else
			table.remove(Cached.Parts, i)
		end
	end

	for i = #Cached.Seats, 1, -1 do
		local seat = Cached.Seats[i]
		if seat and seat.Parent then
			seat.Disabled = true
		else
			table.remove(Cached.Seats, i)
		end
	end

	if State.WallMicroStep and hum and root and hum.MoveDirection.Magnitude > 0.08 then
		local now = os.clock()
		local probeInterval = State.NoclipBetaUltra and 0.025 or 0.035
		if (now - State.LastWallProbeTime) >= probeInterval then
			State.LastWallProbeTime = now
			local flatDir = getMoveDirectionFlat()
			local checkDist = State.NoclipBetaUltra and 2.5 or 2.35
			if hasWallAhead(root.Position, flatDir, checkDist) then
				local pushDir = getBetaSlideVector(root.Position, flatDir, State.NoclipStepPower)
				markMovementIntent(0.25)
				root.CFrame = root.CFrame + (pushDir * State.NoclipStepPower)
				local v = root.AssemblyLinearVelocity
				if isValidVector3(v) then
					local boostXY = State.NoclipBetaUltra and 18 or 16
					root.AssemblyLinearVelocity = Vector3.new(pushDir.X * boostXY, v.Y, pushDir.Z * boostXY)
				end
			end
		end
	end
end

local function restoreNoclipProps()
	for part, origCollide in pairs(Cached.OrigCollide) do
		if part and part.Parent and part:IsA("BasePart") then
			part.CanCollide = origCollide
		end
	end
	table.clear(Cached.OrigCollide)
end

local function setNoclip(enabled)
	State.Noclip = enabled
	disconnectList(noclipConnections)

	if charDescendantConn then
		charDescendantConn:Disconnect()
		charDescendantConn = nil
	end

	if enabled and not State.Unloaded then
		if Cached.Char then
			charDescendantConn = Cached.Char.DescendantAdded:Connect(registerDescendant)
		end
		applyStrongNoclipFrame()

		if RunService.PreSimulation then
			table.insert(noclipConnections, RunService.PreSimulation:Connect(applyStrongNoclipFrame))
		end
		table.insert(noclipConnections, RunService.Stepped:Connect(applyStrongNoclipFrame))
	else
		restoreNoclipProps()
	end
end

local function executeHardWallBypass(forceScan)
	local char = Cached.Char
	local root = Cached.Root
	if not char or not root then return false end

	local flatDir = getMoveDirectionFlat()
	if not forceScan and not hasWallAhead(root.Position, flatDir, 4.0) then
		return false
	end

	local maxDist = math.max(5, State.BypassScanDistance)
	local chosenPos = nil

	for dist = 2, maxDist do
		local probePos = root.Position + (flatDir * dist)
		if not hasWallAhead(probePos, flatDir, 1.0) and isPositionClear(probePos) then
			local floorHit = Workspace:Raycast(probePos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), sharedRayParams)
			if floorHit then
				local groundedPos = Vector3.new(probePos.X, floorHit.Position.Y + 3.0, probePos.Z)
				if isPositionClear(groundedPos) then
					chosenPos = groundedPos
					break
				end
			else
				chosenPos = probePos
				break
			end
		end
	end

	if not chosenPos then
		chosenPos = root.Position + (flatDir * math.min(maxDist, 14))
	end

	markMovementIntent(0.55)
	local curY = isValidVector3(root.AssemblyLinearVelocity) and math.max(root.AssemblyLinearVelocity.Y, 0) or 0
	root.AssemblyLinearVelocity = Vector3.new(0, curY, 0)
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.new(chosenPos, chosenPos + flatDir)
	State.LastCleanCFrame = root.CFrame
	State.LastBypassTime = os.clock()
	return true
end

-- ==========================================
-- INSTANT GRAB SYSTEM (PROXIMITY & LOOT)
-- ==========================================
local function getPromptWorldPos(prompt)
	local parent = prompt.Parent
	if not parent then return nil end
	if parent:IsA("BasePart") then
		return parent.Position
	elseif parent:IsA("Attachment") then
		return parent.WorldPosition
	elseif parent:IsA("Model") then
		if parent.PrimaryPart then
			return parent.PrimaryPart.Position
		end
		local part = parent:FindFirstChildWhichIsA("BasePart", true)
		return part and part.Position or nil
	end
	return nil
end

local function triggerSinglePromptInstant(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end

	local origHold = prompt.HoldDuration
	local origMaxDist = prompt.MaxActivationDistance

	pcall(function()
		prompt.HoldDuration = 0
		if prompt.MaxActivationDistance < (State.InstantGrabRadius + 8) then
			prompt.MaxActivationDistance = State.InstantGrabRadius + 8
		end
	end)

	local fired = false
	pcall(function()
		if typeof(fireproximityprompt) == "function" then
			fireproximityprompt(prompt)
			fired = true
		end
	end)

	if not fired then
		pcall(function()
			prompt:InputHoldBegin()
			task.defer(function()
				if prompt and prompt.Parent then
					pcall(function()
						prompt:InputHoldEnd()
					end)
				end
			end)
			fired = true
		end)
	end

	task.delay(0.08, function()
		if prompt and prompt.Parent then
			pcall(function()
				prompt.HoldDuration = origHold
				prompt.MaxActivationDistance = origMaxDist
			end)
		end
	end)

	return fired
end

local function executeInstantGrab()
	local char = Cached.Char
	local root = Cached.Root
	if not char or not root then return 0 end

	local grabbedCount = 0
	local maxDist = math.max(5, State.InstantGrabRadius)

	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			if not desc:IsDescendantOf(char) then
				local pPos = getPromptWorldPos(desc)
				if pPos and (pPos - root.Position).Magnitude <= maxDist then
					if triggerSinglePromptInstant(desc) then
						grabbedCount += 1
						if grabbedCount >= 14 then
							break
						end
					end
				end
			end
		end
	end

	if typeof(firetouchinterest) == "function" then
		local parts = Workspace:GetPartBoundsInRadius(root.Position, math.min(maxDist, 20), sharedOverlapParams)
		local touchCount = 0
		for _, part in ipairs(parts) do
			if touchCount >= 12 then break end
			if part:IsA("BasePart") and part.CanTouch and not part:IsDescendantOf(char) then
				local n = part.Name:lower()
				if n:find("loot") or n:find("diamond") or n:find("vault") or n:find("cash") or n:find("gem") or n:find("pickup") or n:find("item") or n:find("steal") then
					pcall(function()
						firetouchinterest(root, part, 0)
						firetouchinterest(root, part, 1)
					end)
					touchCount += 1
					grabbedCount += 1
				end
			end
		end
	end

	return grabbedCount
end

-- ==========================================
-- LOOT / VAULT DETECTION & SCORING ENGINE
-- ==========================================
local TIER_WEIGHTS = {
	mythic = 110,
	divine = 105,
	secret = 100,
	legendary = 90,
	diamond = 85,
	vault = 80,
	emerald = 65,
	ruby = 60,
	safe = 55,
	gold = 50,
	gem = 45,
	cash = 35,
	money = 35,
	loot = 30,
	steal = 28,
	item = 25,
	crate = 20,
	chest = 20,
	bag = 18
}

local function isPlayerCharacterDescendant(obj)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and obj:IsDescendantOf(plr.Character) then
			return true
		end
	end
	return false
end

local function collectTextClues(obj)
	local chunks = { obj.Name:lower() }

	for _, tag in ipairs(CollectionService:GetTags(obj)) do
		table.insert(chunks, tostring(tag):lower())
	end

	for attrName, attrVal in pairs(obj:GetAttributes()) do
		table.insert(chunks, tostring(attrName):lower() .. " " .. tostring(attrVal):lower())
	end

	local childLimit = 0
	for _, child in ipairs(obj:GetDescendants()) do
		childLimit += 1
		if childLimit > 25 then break end
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			table.insert(chunks, tostring(child.Text):lower())
		elseif child:IsA("StringValue") or child:IsA("NumberValue") or child:IsA("IntValue") then
			table.insert(chunks, child.Name:lower() .. " " .. tostring(child.Value):lower())
		elseif child:IsA("ProximityPrompt") then
			table.insert(chunks, tostring(child.ActionText):lower() .. " " .. tostring(child.ObjectText):lower())
		end
	end

	return table.concat(chunks, " ")
end

local function scoreLootCandidate(obj)
	if not obj or not obj.Parent then return 0, nil end
	if obj:IsA("Folder") or obj:IsA("Configuration") or obj:IsA("WorldModel") then
		return 0, nil
	end
	if isPlayerCharacterDescendant(obj) then
		return 0, nil
	end

	local clues = collectTextClues(obj)
	local score = 0

	for key, weight in pairs(TIER_WEIGHTS) do
		if clues:find(key, 1, true) then
			score = math.max(score, weight)
		end
	end

	-- Parse dollar/rate patterns like "$3k/s", "$500", "3k/s"
	local rateMatch = clues:match("%$?%s*(%d+%.?%d*)%s*k%s*/%s*s")
	if rateMatch then
		local rateNum = tonumber(rateMatch)
		if rateNum and rateNum > 0 then
			score += math.min(rateNum * 12, 160)
		end
	end

	for attrName, attrVal in pairs(obj:GetAttributes()) do
		local aLower = tostring(attrName):lower()
		if aLower:find("value") or aLower:find("price") or aLower:find("reward") or aLower:find("cash") or aLower:find("money") or aLower:find("rate") or aLower:find("income") then
			local num = tonumber(attrVal)
			if num and num > 0 then
				score += math.min(num / 50, 150)
			end
		elseif aLower:find("rarity") or aLower:find("tier") then
			local vLower = tostring(attrVal):lower()
			for key, weight in pairs(TIER_WEIGHTS) do
				if vLower:find(key, 1, true) then
					score = math.max(score, weight + 20)
				end
			end
		end
	end

	if score <= 0 then
		return 0, nil
	end

	local displayName = obj.Name
	for _, child in ipairs(obj:GetDescendants()) do
		if child:IsA("TextLabel") and child.Text and child.Text ~= "" then
			local trimmed = child.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if #trimmed > 0 and #trimmed <= 32 and not trimmed:lower():find("spawns in") then
				displayName = trimmed
				break
			end
		end
	end

	return score, displayName
end

local function getTargetWorldPosition(obj)
	if not obj or not obj.Parent then return nil end
	if obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Attachment") then
		return obj.WorldPosition
	elseif obj:IsA("Model") then
		if obj.PrimaryPart then
			return obj.PrimaryPart.Position
		end
		local part = obj:FindFirstChildWhichIsA("BasePart", true)
		return part and part.Position or nil
	elseif obj:IsA("BillboardGui") or obj:IsA("GuiObject") then
		local adornee = obj:IsA("BillboardGui") and obj.Adornee or nil
		if adornee and adornee:IsA("BasePart") then
			return adornee.Position
		end
		local parent = obj.Parent
		if parent and parent:IsA("BasePart") then
			return parent.Position
		elseif parent and parent:IsA("Model") then
			local part = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true)
			return part and part.Position or nil
		end
	end
	return nil
end

local function resolveAnchorInstance(obj)
	if not obj or not obj.Parent then return nil end
	if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Attachment") then
		return obj
	end
	if obj:IsA("BillboardGui") and obj.Adornee and (obj.Adornee:IsA("BasePart") or obj.Adornee:IsA("Model")) then
		return obj.Adornee
	end
	local parent = obj.Parent
	if parent and (parent:IsA("BasePart") or parent:IsA("Model") or parent:IsA("Attachment")) then
		return parent
	end
	return obj
end

local function teleportToBestLootOrVault()
	local char = Cached.Char
	local root = Cached.Root
	if not char or not root then return false end

	local bestPos = nil
	local bestScore = -1

	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Model") or desc:IsA("BasePart") or desc:IsA("BillboardGui") then
			local baseScore = scoreLootCandidate(desc)
			if baseScore > 0 then
				local pos = getTargetWorldPosition(desc)
				if pos and isValidVector3(pos) then
					local dist = (pos - root.Position).Magnitude
					local totalScore = baseScore - (dist * 0.05)
					if totalScore > bestScore then
						bestScore = totalScore
						bestPos = pos
					end
				end
			end
		end
	end

	if bestPos then
		return safeTeleportToPosition(bestPos, getMoveDirectionFlat())
	end

	return false
end

local function findOtherPlayerBasePosition(targetPlayer)
	if not targetPlayer then return nil end

	local pNameLower = targetPlayer.Name:lower()
	local dNameLower = targetPlayer.DisplayName:lower()

	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Model") or desc:IsA("Folder") then
			local n = desc.Name:lower()
			local matchesPlayer = (pNameLower ~= "" and n:find(pNameLower, 1, true))
				or (#dNameLower >= 3 and n:find(dNameLower, 1, true))
			local ownerAttr = tostring(desc:GetAttribute("Owner") or desc:GetAttribute("Player") or desc:GetAttribute("UserId") or ""):lower()
			local isBaseLike = n:find("base", 1, true)
				or n:find("plot", 1, true)
				or n:find("tycoon", 1, true)
				or n:find("home", 1, true)
				or n:find("hideout", 1, true)

			if matchesPlayer or (isBaseLike and (ownerAttr:find(pNameLower, 1, true) or ownerAttr == tostring(targetPlayer.UserId))) then
				local pos = getTargetWorldPosition(desc)
				if pos then
					return pos
				end
			end
		end
	end

	local tChar = targetPlayer.Character
	local tRoot = tChar and (
		tChar:FindFirstChild("HumanoidRootPart")
		or tChar:FindFirstChild("Torso")
		or tChar:FindFirstChild("UpperTorso")
	) or nil

	return tRoot and tRoot.Position or nil
end

local function teleportToOtherPlayerBase()
	local root = Cached.Root
	if not root then return false end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local basePos = findOtherPlayerBasePosition(plr)
			if basePos and isValidVector3(basePos) then
				local behindOffset = Vector3.new(0, 1.5, -3.5)
				return safeTeleportToPosition(basePos + behindOffset, getMoveDirectionFlat())
			end
		end
	end

	return false
end


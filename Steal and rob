local function saveCurrentBaseSpot()
	local root = Cached.Root
	if not root or not isValidVector3(root.Position) then return false end
	State.SavedBaseCFrame = root.CFrame
	State.LastCleanCFrame = root.CFrame
	return true
end

local function computeSafeBaseCFrame(savedCF)
	local basePos = savedCF.Position
	local look = savedCF.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local targetPos = basePos + Vector3.new(0, 2.5, 0)

	local downHit = Workspace:Raycast(basePos + Vector3.new(0, 3.0, 0), Vector3.new(0, -10.0, 0), sharedRayParams)
	if downHit and isValidVector3(downHit.Position) then
		local candidateY = math.max(basePos.Y + 1.5, downHit.Position.Y + 3.0)
		targetPos = Vector3.new(basePos.X, candidateY, basePos.Z)
	end

	if flatLook.Magnitude > 0.001 then
		return CFrame.new(targetPos, targetPos + flatLook.Unit)
	end
	return CFrame.new(targetPos)
end

local function applyTeleportCFrame(char, hum, root, destCF)
	if hum then
		hum.Sit = false
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end

	if isValidVector3(root.AssemblyLinearVelocity) then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	if isValidVector3(root.AssemblyAngularVelocity) then
		root.AssemblyAngularVelocity = Vector3.zero
	end

	local moved = false
	if char then
		moved = pcall(function()
			char:PivotTo(destCF)
		end)
	end
	if not moved then
		root.CFrame = destCF
	end
end

local function teleportToSavedBase()
	if State.Unloaded then return false end
	local now = os.clock()
	if (now - State.LastBaseTpTime) < 0.25 then
		return false
	end

	local char = Cached.Char
	local hum = Cached.Hum
	local root = Cached.Root
	if not char or not root or not State.SavedBaseCFrame then
		return false
	end

	State.LastBaseTpTime = now

	if State.UnderMap then
		State.UnderMap = false
		State.UnderAnchorY = nil
		if underPlatform then
			underPlatform.Parent = nil
		end
		syncUnderMapToggleUI(false)
	end

	local destCF = computeSafeBaseCFrame(State.SavedBaseCFrame)
	State.LastCleanCFrame = destCF
	markMovementIntent(1.4)

	applyTeleportCFrame(char, hum, root, destCF)

	task.delay(0.08, function()
		if State.Unloaded then return end
		local curChar = Cached.Char
		local curHum = Cached.Hum
		local curRoot = Cached.Root
		if curChar and curRoot and (curRoot.Position - destCF.Position).Magnitude > 2.5 then
			markMovementIntent(1.2)
			applyTeleportCFrame(curChar, curHum, curRoot, destCF)
		end
	end)

	return true
end


-- ==========================================
-- ANTI-UNUSUAL MOVEMENT, RAGDOLL & KNOCKBACK
-- ==========================================
local ragdollStateConn = nil

local function lockHumanoidStates(hum)
	if not hum then return end
	local blockedStates = {
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Physics
	}
	for _, stateType in ipairs(blockedStates) do
		pcall(function()
			hum:SetStateEnabled(stateType, false)
		end)
	end
end

local function unlockHumanoidStates(hum)
	if not hum then return end
	local states = {
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Physics
	}
	for _, stateType in ipairs(states) do
		pcall(function()
			hum:SetStateEnabled(stateType, true)
		end)
	end
end

local function sanitizeRagdollAndJoints(char, hum, root, fullSweep)
	if not char or not hum then return end

	local curState = hum:GetState()
	if curState == Enum.HumanoidStateType.Ragdoll
		or curState == Enum.HumanoidStateType.FallingDown
		or curState == Enum.HumanoidStateType.Physics then
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
		task.defer(function()
			if hum and hum.Parent and not State.Unloaded then
				pcall(function()
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end)
			end
		end)
	end

	if fullSweep then
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("Motor6D") then
				desc.Enabled = true
			elseif desc:IsA("BallSocketConstraint") or desc:IsA("HingeConstraint") then
				if desc.Name:lower():find("ragdoll") or (desc.Parent and desc.Parent.Name:lower():find("ragdoll")) then
					desc:Destroy()
				end
			elseif State.AntiKnockback
				and (desc:IsA("BodyVelocity") or desc:IsA("BodyGyro") or desc:IsA("LinearVelocity") or desc:IsA("AngularVelocity")) then
				desc:Destroy()
			end
		end
	end

	if root and not isSafeVelocity(root.AssemblyLinearVelocity) then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function applyAntiUnusualMovement(hum, root, dt)
	if not State.AntiUnusualMovement or State.Unloaded or not hum or not root then return end

	local now = os.clock()
	local v = root.AssemblyLinearVelocity
	local ang = root.AssemblyAngularVelocity

	if not isValidVector3(v) or not isValidVector3(ang) then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		if State.LastCleanCFrame then
			root.CFrame = State.LastCleanCFrame
		end
		return
	end

	local allowedSpeed = State.MaxUnusualSpeed + (State.SpeedEnabled and State.ExtraSpeed or 0)
	if v.Magnitude > allowedSpeed then
		local dir = v.Magnitude > 0.001 and v.Unit or Vector3.zero
		root.AssemblyLinearVelocity = dir * allowedSpeed
	end

	if ang.Magnitude > 25 then
		root.AssemblyAngularVelocity = Vector3.zero
	end

	local hState = hum:GetState()
	if hState == Enum.HumanoidStateType.PlatformStanding
		or (hState == Enum.HumanoidStateType.Seated and hum.MoveDirection.Magnitude > 0.1) then
		hum.Sit = false
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end

	local skipSnapCheck = State.UnderMap or (now < State.IgnoreUnusualUntil)
	if not skipSnapCheck and State.LastCleanCFrame then
		local expectedMaxStep = math.max(State.MaxUnusualSnapDist, ((hum.WalkSpeed + (State.SpeedEnabled and State.ExtraSpeed or 0)) * dt) + 18)
		local distMoved = (root.Position - State.LastCleanCFrame.Position).Magnitude
		if distMoved > expectedMaxStep then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			if State.SnapBackOnUnusual then
				root.CFrame = State.LastCleanCFrame
			end
			return
		end
	end

	if not State.UnderMap then
		State.LastCleanCFrame = root.CFrame
	end
end

local function bindRagdollWatcher(char)
	if ragdollStateConn then
		ragdollStateConn:Disconnect()
		ragdollStateConn = nil
	end

	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if State.AntiRagdoll and not State.Unloaded then
		lockHumanoidStates(hum)
		ragdollStateConn = hum.StateChanged:Connect(function(_, newState)
			if not State.AntiRagdoll or State.Unloaded then return end
			if newState == Enum.HumanoidStateType.Ragdoll
				or newState == Enum.HumanoidStateType.FallingDown
				or newState == Enum.HumanoidStateType.Physics then
				sanitizeRagdollAndJoints(Cached.Char, Cached.Hum, Cached.Root, true)
			end
		end)
	end
end

local function setAntiRagdoll(enabled)
	State.AntiRagdoll = enabled
	if enabled and not State.Unloaded then
		lockHumanoidStates(Cached.Hum)
		bindRagdollWatcher(Cached.Char)
		sanitizeRagdollAndJoints(Cached.Char, Cached.Hum, Cached.Root, true)
	else
		if ragdollStateConn then
			ragdollStateConn:Disconnect()
			ragdollStateConn = nil
		end
		unlockHumanoidStates(Cached.Hum)
	end
end


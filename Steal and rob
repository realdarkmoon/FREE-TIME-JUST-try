local function updateESPFrame()
	if State.Unloaded or not drawingAvailable then
		hideAllBoxes()
		clearLootMarkers()
		return
	end

	local activeCam = Workspace.CurrentCamera
	if not activeCam then
		hideAllBoxes()
		return
	end

	if State.BoxESP then
		for player, box in pairs(espBoxes) do
			if not player or not player.Parent then
				removePlayerESP(player)
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local char = player.Character
				local root = char and (
					char:FindFirstChild("HumanoidRootPart")
					or char:FindFirstChild("Torso")
					or char:FindFirstChild("UpperTorso")
				)
				local humanoid = char and char:FindFirstChildOfClass("Humanoid")

				if root and humanoid and humanoid.Health > 0 then
					local box = espBoxes[player]
					if not box then
						box = createBox(Color3.fromRGB(255, 85, 85), 1.5, false)
						espBoxes[player] = box
					end

					if box then
						local rootPos, onScreen = activeCam:WorldToViewportPoint(root.Position)
						if onScreen and rootPos.Z > 0 then
							local topPos = activeCam:WorldToViewportPoint((root.CFrame * CFrame.new(0, 2.6, 0)).Position)
							local bottomPos = activeCam:WorldToViewportPoint((root.CFrame * CFrame.new(0, -3.1, 0)).Position)

							local height = math.abs(topPos.Y - bottomPos.Y)
							local width = math.clamp(height * 0.6, 12, 250)

							pcall(function()
								box.Size = Vector2.new(width, math.clamp(height, 18, 400))
								box.Position = Vector2.new(rootPos.X - box.Size.X / 2, topPos.Y)
								box.Visible = true
							end)
						else
							pcall(function() box.Visible = false end)
						end
					end
				elseif espBoxes[player] then
					pcall(function() box.Visible = false end)
				end
			end
		end
	else
		hideAllBoxes()
	end

	if State.LootVaultESP then
		local now = os.clock()
		if (now - State.LastLootScanTime) >= 1.5 or #lootMarkers == 0 then
			State.LastLootScanTime = now
			scanLootAndVaults()
		end

		for _, entry in ipairs(lootMarkers) do
			local screenPos, onScreen = activeCam:WorldToViewportPoint(entry.Pos)
			if onScreen and screenPos.Z > 0 and entry.Dot and entry.Label then
				pcall(function()
					entry.Dot.Size = Vector2.new(12, 12)
					entry.Dot.Position = Vector2.new(screenPos.X - 6, screenPos.Y - 6)
					entry.Dot.Visible = true
				end)

				local dist = Cached.Root and math.floor((Cached.Root.Position - entry.Pos).Magnitude) or 0
				local badgePrefix = entry.IsVault and "[VAULT]" or "[LOOT]"

				if State.LootEspLogo then
					if entry.LogoOuter then
						pcall(function()
							entry.LogoOuter.Size = Vector2.new(14, 14)
							entry.LogoOuter.Position = Vector2.new(screenPos.X - 7, screenPos.Y - 40)
							entry.LogoOuter.Visible = true
						end)
					end
					if entry.LogoInner then
						pcall(function()
							entry.LogoInner.Size = Vector2.new(8, 8)
							entry.LogoInner.Position = Vector2.new(screenPos.X - 4, screenPos.Y - 37)
							entry.LogoInner.Visible = true
						end)
					end
					pcall(function()
						entry.Label.Text = string.format("◆ %s %s [%dm]", badgePrefix, entry.Name, dist)
						entry.Label.Position = Vector2.new(screenPos.X, screenPos.Y - 22)
						entry.Label.Visible = true
					end)
				else
					if entry.LogoOuter then
						pcall(function() entry.LogoOuter.Visible = false end)
					end
					if entry.LogoInner then
						pcall(function() entry.LogoInner.Visible = false end)
					end
					pcall(function()
						entry.Label.Text = string.format("%s [%dm]", entry.Name, dist)
						entry.Label.Position = Vector2.new(screenPos.X, screenPos.Y - 20)
						entry.Label.Visible = true
					end)
				end
			else
				setEntryVisible(entry, false)
			end
		end
	elseif #lootMarkers > 0 then
		clearLootMarkers()
	end
end


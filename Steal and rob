-- ==========================================
local function applyJumpBoost(enabled)
	State.JumpEnabled = enabled
	local hum = Cached.Hum
	if not hum then return end

	if enabled and not State.Unloaded then
		if hum.UseJumpPower then
			hum.JumpPower = State.JumpPower
		else
			hum.JumpHeight = State.JumpHeight
		end
	else
		if hum.UseJumpPower then
			hum.JumpPower = State.DefaultJumpPower
		else
			hum.JumpHeight = State.DefaultJumpHeight
		end
	end
end

-- ==========================================
-- BOX ESP & LOOT/VAULT ESP WITH LOGO (DRAWING API)
-- ==========================================
local espBoxes = {}
local lootMarkers = {}
local drawingAvailable = (typeof(Drawing) == "table" and typeof(Drawing.new) == "function")

local function safeNewDrawing(kind)
	if not drawingAvailable then return nil end
	local ok, obj = pcall(function()
		return Drawing.new(kind)
	end)
	if ok and obj then
		return obj
	end
	return nil
end

local function createBox(color, thickness, filled)
	local box = safeNewDrawing("Square")
	if not box then return nil end
	pcall(function()
		box.Visible = false
		box.Color = color or Color3.fromRGB(255, 85, 85)
		box.Thickness = thickness or 1.5
		box.Filled = filled or false
		box.Transparency = 1
	end)
	return box
end

local function createLabel(color, size)
	local lbl = safeNewDrawing("Text")
	if not lbl then return nil end
	pcall(function()
		lbl.Visible = false
		lbl.Color = color or Color3.fromRGB(90, 225, 255)
		lbl.Size = size or 14
		lbl.Center = true
		lbl.Outline = true
		lbl.Transparency = 1
	end)
	return lbl
end

local function hideAllBoxes()
	for _, box in pairs(espBoxes) do
		if box then
			pcall(function() box.Visible = false end)
		end
	end
end

local function clearLootMarkers()
	for _, entry in ipairs(lootMarkers) do
		if entry.LogoOuter then
			pcall(function() entry.LogoOuter:Remove() end)
		end
		if entry.LogoInner then
			pcall(function() entry.LogoInner:Remove() end)
		end
		if entry.Dot then
			pcall(function() entry.Dot:Remove() end)
		end
		if entry.Label then
			pcall(function() entry.Label:Remove() end)
		end
	end
	table.clear(lootMarkers)
end

local function removePlayerESP(player)
	local box = espBoxes[player]
	if box then
